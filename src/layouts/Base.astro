---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title: string;
  // The entry whose colours the page should wear — primary type drives
  // --accent, secondary drives --accent-2. Omit on pages with no single
  // entry (e.g. the roster grid); the site-wide fallback in tokens.css
  // applies instead.
  accentTypes?: readonly string[];
}

const { title, accentTypes } = Astro.props;
const accentStyle = accentTypes?.length
  ? `--accent: var(--t-${accentTypes[0]}); --accent-2: var(--t-${accentTypes[1] ?? accentTypes[0]});`
  : undefined;
---

<!doctype html>
<html lang="en" style={accentStyle}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <ClientRouter />
  </head>
  <body>
    <header class="site-header">
      <a href="/" class="wordmark">SM'S DEX</a>
    </header>
    <slot />
  </body>
</html>

<style>
  .site-header {
    padding: var(--gap);
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    padding-inline: 4px;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: var(--text-base);
    text-decoration: none;
  }
</style>
