---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <ClientRouter />
  </head>
  <body>
    <header class="site-header">
      <a href="/" class="wordmark">SM'S DEX</a>
    </header>
    <slot />
  </body>
</html>

<style>
  .site-header {
    padding: var(--gap);
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    padding-inline: 4px;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 16px;
    text-decoration: none;
  }
</style>
