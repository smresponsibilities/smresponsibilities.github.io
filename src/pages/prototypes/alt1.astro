---
import Base from "../../layouts/Base.astro";
---
<Base title="Alt 1: Pokedex Screen">
  <div class="pokedex-bezel">
    <aside class="hinge-nav">
      <div class="hinge-cylinder"></div>
      <nav>
        <a href="/">Home</a>
        <a href="#" class="active">Blog</a>
        <a href="#">Projects</a>
        <a href="#">Resume</a>
      </nav>
    </aside>
    <main class="screen-area">
      <div class="screen-glass">
        <header>
          <h1>Blog / Days of Code</h1>
        </header>
        <div class="content">
          <div class="list-item">
            <span class="date">Oct 5, 2026</span>
            <h2>Day 1242</h2>
            <p>Today was an incredible day...</p>
          </div>
          <div class="list-item">
            <span class="date">Oct 4, 2026</span>
            <h2>Day 1241</h2>
            <p>Working on the UI layout...</p>
          </div>
        </div>
      </div>
    </main>
  </div>
</Base>
<style>
  .pokedex-bezel {
    display: flex;
    max-width: 900px;
    margin: 2rem auto;
    background: #e3350d;
    border-radius: 16px;
    padding: 1rem;
    box-shadow: inset -4px -4px 0 rgba(0,0,0,0.2), 0 10px 20px rgba(0,0,0,0.3);
    min-height: 70vh;
  }
  .hinge-nav {
    width: 200px;
    display: flex;
    flex-direction: column;
    border-right: 4px solid #8b0000;
    padding-right: 1rem;
    position: relative;
  }
  .hinge-cylinder {
    position: absolute;
    right: -12px;
    top: 10%;
    bottom: 10%;
    width: 20px;
    background: #cc0000;
    border-radius: 10px;
    box-shadow: inset -2px 0 5px rgba(0,0,0,0.4);
  }
  .hinge-nav nav {
    margin-top: 3rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .hinge-nav a {
    color: white;
    text-decoration: none;
    font-weight: bold;
    padding: 0.5rem;
    background: rgba(0,0,0,0.1);
    border-radius: 4px;
    text-transform: uppercase;
    letter-spacing: 1px;
  }
  .hinge-nav a.active {
    background: #ffcc00;
    color: #333;
    box-shadow: 0 0 10px rgba(255, 204, 0, 0.5);
  }
  .screen-area {
    flex: 1;
    padding-left: 2rem;
    display: flex;
  }
  .screen-glass {
    flex: 1;
    background: #e0f7fa;
    border: 12px solid #333;
    border-radius: 8px 8px 32px 8px;
    padding: 2rem;
    overflow-y: auto;
    box-shadow: inset 0 0 20px rgba(0,100,100,0.1);
  }
  .list-item {
    padding: 1.5rem 0;
    border-bottom: 2px solid rgba(0,0,0,0.1);
  }
  .list-item h2 { margin: 0; color: #004d40; }
  .list-item .date { font-size: 0.8rem; color: #00796b; font-weight: bold; }
  .list-item p { color: #004d40; }
</style>
