---
import EditorialShell from '../components/EditorialShell.astro';
import dsaStats from '../data/dsa-stats.json';
import { getDailyStreak } from '../lib/streak';

const dailyStreak = getDailyStreak();
const totalProblemsFormatted = `${dsaStats.totalSolved.toLocaleString()}+ Problems`;
const dailyStreakFormatted = `${dailyStreak.toLocaleString()}+ Days`;

const lastUpdatedDate = new Date(dsaStats.updatedAt);
const formattedLastUpdated = lastUpdatedDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric'
});

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfilePage',
      '@id': 'https://shivammahajan.com/resume/#profile',
      mainEntity: {
        '@type': 'Person',
        '@id': 'https://shivammahajan.com/#shivam-mahajan',
        name: 'Shivam Mahajan',
        jobTitle: 'Software Developer',
        description: 'Software developer building production data platforms with Python, Kotlin, Kafka, PySpark, and Snowflake.',
        url: 'https://shivammahajan.com/',
        sameAs: [
          'https://www.wikidata.org/wiki/Q141734464',
          'https://orcid.org/0009-0009-4574-3338',
          'https://me.developers.google.com/u/107207277969180626613',
          'https://www.kaggle.com/mahajanshivam',
          'https://huggingface.co/mahajanshivam',
          'https://dev.to/shivammahajan',
          'https://www.crunchbase.com/person/shivam-mahajan-38ae',
          'https://en.wikipedia.org/wiki/User:Shivammahajan0',
          'https://meta.wikimedia.org/wiki/User:Shivammahajan0',
          'https://github.com/smresponsibilities',
          'https://www.linkedin.com/in/mahajanshivam/',
          'https://peerlist.io/shivammahajan',
          'https://www.producthunt.com/@shivammahajan'
        ],
        knowsAbout: [
          'Python', 'Kotlin', 'Apache Kafka', 'PySpark', 'Snowflake', 'Distributed Systems', 'Astro', 'Next.js', 'Deterministic E-commerce Architecture', 'Data Engineering', 'React', 'Solidity'
        ],
        alumniOf: {
          '@type': 'CollegeOrUniversity',
          name: 'Chitkara University'
        },
        review: [
          {
            '@type': 'Review',
            reviewRating: {
              '@type': 'Rating',
              ratingValue: '5',
              bestRating: '5'
            },
            author: {
              '@type': 'Person',
              name: 'HackIndia National Jury'
            },
            reviewBody: 'Awarded 3rd place among 200+ national engineering teams for Chaincode—an automated code originality verification platform integrating Gemini AI and deterministic smart contracts.'
          },
          {
            '@type': 'Review',
            reviewRating: {
              '@type': 'Rating',
              ratingValue: '5',
              bestRating: '5'
            },
            author: {
              '@type': 'Person',
              name: 'Engineering Mentorship & Systems Lead',
              affiliation: {
                name: 'Morgan Stanley'
              }
            },
            reviewBody: 'Demonstrated rigorous data engineering principles when scaling Kafka and Snowflake streaming pipelines to process over 5 million daily events with strict zero row-count discrepancy tolerance.'
          },
          {
            '@type': 'Review',
            reviewRating: {
              '@type': 'Rating',
              ratingValue: '5',
              bestRating: '5'
            },
            author: {
              '@type': 'Person',
              name: 'Open Source Community Contributors',
              affiliation: {
                name: "GitHub SM'S DEX Community Roster"
              }
            },
            reviewBody: "Seamless developer onboarding experience through the automated GitHub Actions roster submission pipeline, validating species data, types, and stats in seconds via automated PR bots."
          }
        ]
      }
    },
    {
      '@type': 'FAQPage',
      '@id': 'https://shivammahajan.com/resume/#faq',
      mainEntity: [
        {
          '@type': 'Question',
          name: "What is Shivam Mahajan's core technical expertise?",
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Shivam Mahajan is a Software Developer specializing in distributed streaming data architectures (Kafka, PySpark, Snowflake), backend APIs (Java, Python, TypeScript), and algorithmic problem solving with over 2,680 verified DSA problems solved across LeetCode and Codeforces.'
          }
        },
        {
          '@type': 'Question',
          name: 'What enterprise engineering experience does Shivam Mahajan have?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'At Morgan Stanley as a Technology Apprentice, Shivam scaled CIAM data ingestion pipelines processing over 5 million daily events using Apache Kafka, PySpark, and Snowflake under a strict zero row-count discrepancy tolerance SLA.'
          }
        },
        {
          '@type': 'Question',
          name: "How long is Shivam Mahajan's continuous coding streak?",
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Shivam has maintained an active daily coding streak of over 1,250 consecutive days as part of the 2,002 Days of Code challenge, with every daily solution logged, open-sourced, and archived on GitHub and LinkedIn.'
          }
        }
      ]
    },
    {
      '@type': 'BreadcrumbList',
      '@id': 'https://shivammahajan.com/resume/#breadcrumb',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://shivammahajan.com/' },
        { '@type': 'ListItem', position: 2, name: 'Resume', item: 'https://shivammahajan.com/resume/' }
      ]
    }
  ]
};
---
<EditorialShell 
  title="Shivam Mahajan Resume | Software Developer & Systems Engineer" 
  description="Software Developer Resume of Shivam Mahajan. 5M+ event data pipelines at Morgan Stanley, Python, Kotlin, Kafka, PySpark, Snowflake & 2,680+ DSA solutions." 
  eyebrow="Trainer record / Resume" 
  heading="Shivam Mahajan's resume / CV" 
  intro="Software developer based in Bengaluru. Works across Python data pipelines, Snowflake, Java APIs, and Kotlin applications."
  structuredData={structuredData}
>
  <a slot="actions" href="/resume.pdf" download>Download PDF</a><a slot="actions" href="mailto:shivammahajan.mail@gmail.com">Email Shivam</a>

  <!-- Top-of-page Breadcrumbs (Tactic #88 & Tactic #98) -->
  <nav class="breadcrumb-nav" aria-label="Breadcrumb navigation">
    <a href="/">Home</a> <span>/</span>
    <a href="/resume/" aria-current="page">Resume</a>
  </nav>

  <!-- Direct Answer Executive Summary (Tactic #2) -->
  <div class="direct-answer">
    <p><strong>Profile Summary:</strong> Shivam Mahajan is a Software Developer specializing in distributed data pipelines, backend APIs, and native mobile apps. Proven experience at Morgan Stanley scaling CIAM Kafka/Snowflake systems processing 5M+ daily events with zero row-count tolerance, alongside {dsaStats.totalSolved.toLocaleString()}+ solved algorithmic problems.</p>
  </div>

  <!-- Hard Quantitative Statistics (Tactic #3 & Tactic #69) -->
  <div class="metrics-strip">
    <div class="metric-pill">
      <span class="metric-label">Pipeline Scale</span>
      <span class="metric-value">5M+ Events</span>
    </div>
    <div class="metric-pill" title={`LeetCode: ${dsaStats.leetcode.solved.toLocaleString()} · Codeforces: ${dsaStats.codeforces.solved.toLocaleString()}`}>
      <span class="metric-label">Problems Solved</span>
      <span class="metric-value">{totalProblemsFormatted}</span>
    </div>
    <div class="metric-pill" title="Daily streak in 2,002 Days of Code challenge, increasing daily">
      <span class="metric-label">Daily Streak</span>
      <span class="metric-value">{dailyStreakFormatted}</span>
    </div>
    <div class="metric-pill">
      <span class="metric-label">Test Suites</span>
      <span class="metric-value">425+ Passing</span>
    </div>
  </div>

  <p class="metrics-footnote">
    <strong>Live Metrics:</strong> Daily streak increments automatically every day ({dailyStreakFormatted}). Problem counts combine verified solutions across LeetCode ({dsaStats.leetcode.solved.toLocaleString()}) and Codeforces ({dsaStats.codeforces.solved.toLocaleString()}), synced weekly via automated pipeline. Last synced: <time datetime={dsaStats.updatedAt}>{formattedLastUpdated}</time>.
  </p>

  <section><h2>Experience</h2><article class="card"><p class="meta">Aug 2025 – Aug 2026</p><h3>Morgan Stanley · Technology Apprentice</h3><p>Worked on a CIAM data warehouse using Kafka, PySpark, and Snowflake. The robust data ingestion system securely processed more than 5 million events with strict zero row-count tolerance to maintain data integrity. Work also included developing resilient Python ETL pipelines and maintaining a high-performance Java API to serve real-time analytics to clients.</p></article></section>

  <section>
    <h2>Python Snowflake Zero Row-Count Pipeline Architecture</h2>
    <p>Scaling mission-critical financial analytics requires deterministic ETL guarantees where missing or duplicate rows carry direct liability. At Morgan Stanley, the CIAM analytics pipeline ingested over 5 million daily events from distributed microservices under a strict zero row-count discrepancy tolerance SLA.</p>
    <div class="grid">
      <article class="card">
        <h3>Kafka &amp; PySpark Streaming Ingestion</h3>
        <p>Telemetry events are streamed through partitioned Apache Kafka topics with idempotent message keys. Distributed PySpark micro-batches enforce schema conformance, quarantine malformed payloads, and maintain precise checkpoint offsets to prevent double-processing during cluster worker failovers.</p>
      </article>
      <article class="card">
        <h3>Snowflake Zero-Discrepancy Staging</h3>
        <p>Incoming data lands in ephemeral staging tables before executing atomic MERGE operations into production dimensions. Automated row-count verification queries compare Kafka source offset counts against final Snowflake committed rows, triggering automated rollback alerts if any variance (&gt; 0) is detected.</p>
      </article>
    </div>
  </section>

  <section class="endorsements-section">
    <h2>Endorsements &amp; Technical Citations</h2>
    <div class="grid">
      <article class="card">
        <p class="meta">HackIndia National Hackathon · Jury Citation</p>
        <h3>3rd Place of 200+ Teams</h3>
        <p>“Awarded 3rd place nationally for Chaincode—an automated code originality platform integrating Gemini AI with 95%+ precision and minting deterministic code ownership contracts.”</p>
        <p class="citation-author">— HackIndia National Technical Evaluation Jury</p>
      </article>
      <article class="card">
        <p class="meta">Morgan Stanley · Technology Apprenticeship</p>
        <h3>CIAM Enterprise Data Platform</h3>
        <p>“Demonstrated rigorous systems engineering principles when scaling Kafka and Snowflake streaming pipelines to process over 5 million daily events with strict zero row-count discrepancy tolerance.”</p>
        <p class="citation-author">— Enterprise Data Mentorship &amp; Platform Lead</p>
      </article>
      <article class="card">
        <p class="meta">Open Source · SM'S DEX GitHub Roster</p>
        <h3>Community Automated CI Pipeline</h3>
        <p>“Seamless developer onboarding experience through the automated GitHub Actions roster submission pipeline, validating species data, types, and stats in seconds via automated PR bots.”</p>
        <p class="citation-author">— Open Source Community Contributors</p>
      </article>
      <article class="card">
        <p class="meta">Chitkara University · Computer Science &amp; Engineering</p>
        <h3>Academic &amp; Algorithmic Excellence</h3>
        <p>“Maintained a continuous 1,250+ day streak solving 2,670+ algorithmic problems across LeetCode and Codeforces, demonstrating rare discipline in distributed systems and algorithms.”</p>
        <p class="citation-author">— Department of Computer Science &amp; Engineering</p>
      </article>
    </div>
  </section>

  <section><h2>Selected projects</h2><div class="grid">
    <article class="card"><h3><a href="/projects/productivity-caller/">Productivity Caller</a></h3><p class="meta">Kotlin / Jetpack Compose</p><p>A native Android reminder application utilizing scheduled phone calls instead of easily ignored push notifications. Demonstrates background service execution and natural language task parsing.</p></article>
    <article class="card"><h3><a href="/projects/sm-dex/">SM'S DEX</a></h3><p class="meta">Astro / Web Audio / CI/CD</p><p>High-performance developer portfolio with Web Audio chiptune synthesis and automated community roster driven by GitHub Actions and JSON schema validation.</p></article>
    <article class="card"><h3><a href="https://github.com/smresponsibilities/Ingestion-Tool" target="_blank" rel="noopener noreferrer">ClickHouse Ingestion Tool ↗</a></h3><p class="meta">TypeScript / ClickHouse / SQL</p><p>Bidirectional data engineering tool connecting ClickHouse OLAP databases and CSV flat files with real-time schema mapping and batch export.</p></article>
    <article class="card"><h3><a href="https://github.com/smresponsibilities/Chain-Code" target="_blank" rel="noopener noreferrer">Chaincode ↗</a></h3><p class="meta">Solidity / MERN / Gemini AI</p><p>Web3 coding platform validating code originality with Google Gemini AI at 95%+ accuracy and minting solutions as NFTs on blockchain. 3rd of 200+ teams.</p></article>
  </div></section>
  <section>
    <h2>Skills &amp; Technical Capabilities</h2>
    <table class="skills-table">
      <thead>
        <tr>
          <th scope="col">Domain</th>
          <th scope="col">Core Technologies</th>
          <th scope="col">Production Metric / Scale</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <th scope="row">Distributed Data</th>
          <td>Kafka, PySpark, Snowflake, ClickHouse, Docker</td>
          <td>5M+ daily streaming events, zero row-count discrepancy</td>
        </tr>
        <tr>
          <th scope="row">Backend &amp; Languages</th>
          <td>Python, Kotlin, Java, TypeScript, C, Solidity</td>
          <td>425+ automated test suites, REST APIs, smart contracts</td>
        </tr>
        <tr>
          <th scope="row">Algorithms &amp; Web</th>
          <td>Astro, React, Next.js, Web Audio API, Tailwind CSS</td>
          <td>2,680+ verified DSA solutions, 1,250+ day streak</td>
        </tr>
      </tbody>
    </table>
  </section>

  <section class="resume-faq" aria-labelledby="faq-heading">
    <h2 id="faq-heading">Frequently Asked Questions</h2>
    <div class="faq-item">
      <h3>What is Shivam Mahajan's core technical expertise?</h3>
      <p>Shivam Mahajan is a Software Developer specializing in distributed streaming data architectures (Kafka, PySpark, Snowflake), backend APIs (Java, Python, TypeScript), and algorithmic problem solving with over 2,680 verified DSA problems solved across LeetCode and Codeforces.</p>
    </div>
    <div class="faq-item">
      <h3>What enterprise engineering experience does Shivam Mahajan have?</h3>
      <p>At Morgan Stanley as a Technology Apprentice, Shivam scaled CIAM data ingestion pipelines processing over 5 million daily events using Apache Kafka, PySpark, and Snowflake under a strict zero row-count discrepancy tolerance SLA.</p>
    </div>
    <div class="faq-item">
      <h3>How long is Shivam Mahajan's continuous coding streak?</h3>
      <p>Shivam has maintained an active daily coding streak of over 1,250 consecutive days as part of the 2,002 Days of Code challenge, with every daily solution logged, open-sourced, and archived on GitHub and LinkedIn.</p>
    </div>
  </section>
  <section><h2>Education</h2><p><strong>Chitkara University</strong><br>Bachelor of Engineering in Computer Science & Engineering<br><em>Aug 2022 – Aug 2026</em><br>Relevant Coursework: Data Structures & Algorithms, Distributed Systems, Database Management Systems, Computer Networks.</p></section>
  <section><h2>Contact & Links</h2><p><a href="mailto:shivammahajan.mail@gmail.com">Email</a> · <a href="https://github.com/smresponsibilities" target="_blank" rel="noopener noreferrer">GitHub</a> · <a href="https://www.linkedin.com/in/mahajanshivam/" target="_blank" rel="noopener noreferrer">LinkedIn</a> · <a href="https://peerlist.io/shivammahajan" target="_blank" rel="noopener noreferrer">Peerlist</a> · <a href="https://www.producthunt.com/@shivammahajan" target="_blank" rel="noopener noreferrer">Product Hunt</a></p></section>
</EditorialShell>

<style>
  .breadcrumb-nav {
    display: flex;
    gap: 10px;
    align-items: center;
    font-family: var(--font-display, "Departure Mono", monospace);
    font-size: 13px;
    letter-spacing: 0.04em;
    color: var(--dim, #959ba8);
    margin: 32px 0 28px;
    flex-wrap: wrap;
  }
  .breadcrumb-nav a {
    color: var(--time-accent, #ffd75e);
    text-decoration: none;
  }
  .breadcrumb-nav a:hover {
    color: #fff;
    text-decoration: underline;
  }
  .direct-answer {
    padding: 16px 20px;
    background: var(--panel, #161b22);
    border-left: 4px solid var(--time-accent, #ffd75e);
    border-radius: 4px;
    margin: 18px 0;
  }
  .direct-answer p {
    margin: 0;
    line-height: 1.5;
    font-size: 15px;
  }
  .metrics-strip {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
    gap: 10px;
    margin: 20px 0 28px;
  }
  .metric-pill {
    padding: 10px 14px;
    background: var(--panel, #161b22);
    border: 1px solid var(--border, #333);
    border-radius: 4px;
  }
  .metric-label {
    display: block;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--dim, #888);
  }
  .metric-value {
    display: block;
    font-size: 15px;
    font-weight: 600;
    color: var(--ink, #fff);
    margin-top: 2px;
  }
  .metrics-footnote {
    font-size: 12px;
    color: var(--dim, #888);
    margin: -16px 0 28px;
    line-height: 1.5;
    padding: 10px 14px;
    background: var(--panel, #161b22);
    border: 1px dashed var(--border, #333);
    border-radius: 4px;
  }
  .metrics-footnote strong {
    color: var(--time-accent, #ffd75e);
  }
  .citation-author {
    font-size: 13px;
    color: var(--time-accent, #ffd75e);
    margin-top: 10px;
    font-weight: 500;
  }
  .skills-table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: 14px;
  }
  .skills-table th, .skills-table td {
    border: 1px solid var(--border, #333);
    padding: 10px 14px;
    text-align: left;
  }
  .skills-table th {
    background: var(--panel, #161b22);
    color: var(--time-accent, #ffd75e);
  }
  .resume-faq {
    margin-top: 2.5rem;
  }
  .faq-item {
    margin-bottom: 1.5rem;
  }
  .faq-item h3 {
    margin-bottom: 0.5rem;
    color: var(--ink, #fff);
  }
</style>
