  <script>
    const dialog=document.querySelector('#submission-dialog'); const form=document.querySelector('#submission-form'); const status=document.querySelector('#submission-status'); const openButton=document.querySelector('#open-submission');
    if(dialog instanceof HTMLDialogElement&&form instanceof HTMLFormElement&&status instanceof HTMLElement&&openButton instanceof HTMLButtonElement){
      openButton.addEventListener('click',()=>dialog.showModal());
      if(location.hash==='#open-submission'||location.search.includes('add-pokemon'))dialog.showModal();
      window.addEventListener('hashchange',()=>{if(location.hash==='#open-submission')dialog.showModal();});
      ['#close-submission','#cancel-submission'].forEach(selector=>document.querySelector(selector)?.addEventListener('click',()=>dialog.close()));
      dialog.addEventListener('click',event=>{if(event.target===dialog)dialog.close();});
      const employment=form.querySelector('[name="status"]');const company=form.querySelector('[name="company"]');const companyField=form.querySelector('[data-company-field]');
      const syncCompany=()=>{const caught=employment instanceof HTMLSelectElement&&employment.value==='Caught';if(companyField instanceof HTMLElement)companyField.hidden=!caught;if(company instanceof HTMLInputElement){company.required=caught;if(!caught)company.value='';}};
      employment?.addEventListener('change',syncCompany);syncCompany();
      form.addEventListener('submit',event=>{
        event.preventDefault();
        const data=new FormData(form);
        const github=String(data.get('github')||'').trim();
        const fields=[['GitHub username',github],['Species',data.get('species')],['Primary type',data.get('primaryType')],['Secondary type',data.get('secondaryType')||'None'],['Status',data.get('status')],...(data.get('status')==='Caught'?[['Company',data.get('company')]]:[]),['Dex entry',data.get('entry')],['Fact / tip (optional)',data.get('fact')||'—']];
        const body=fields.map(([label,value])=>`### ${label}\n${value}`).join('\n\n');
        const params=new URLSearchParams({title:`[DEX] ${github}`,body});
        const issueUrl=`https://github.com/smresponsibilities/smresponsibilities.github.io/issues/new?${params}`;
        const submitEvent=event as SubmitEvent & { agentInvoked?: boolean; respondWith?: (promise: Promise<unknown>) => void };
        if(submitEvent.agentInvoked && typeof submitEvent.respondWith==='function'){
          submitEvent.respondWith(Promise.resolve({ success: true, url: issueUrl }));
        }
        status.textContent='Opening GitHub issue…';
        window.open(issueUrl,'_blank','noopener,noreferrer');
        dialog.close();
      });

      // WebMCP Imperative API registration (Chrome / Chromium AI Agent model context)
      const mc=(document as unknown as { modelContext?: { registerTool?: (tool: unknown) => Promise<unknown> } }).modelContext || (navigator as unknown as { modelContext?: { registerTool?: (tool: unknown) => Promise<unknown> } }).modelContext;
      if(mc && typeof mc.registerTool==='function'){
        try{
          mc.registerTool({
            name:'submitRosterEntry',
            description:'Submit a GitHub user to the public developer roster as a custom Pokémon entry. Opens a prefilled GitHub issue for review.',
            inputSchema:{
              type:'object',
              properties:{
                github:{ type:'string', description:'GitHub username without @ symbol' },
                species:{ type:'string', description:'Role-like Pokémon species title (max 24 characters)' },
                primaryType:{
                  type:'string',
                  enum:['Normal','Fire','Water','Electric','Grass','Ice','Fighting','Poison','Ground','Flying','Psychic','Bug','Rock','Ghost','Dragon','Dark','Steel','Fairy'],
                  description:'Primary Pokémon type representing strongest skill or style'
                },
                secondaryType:{
                  type:'string',
                  enum:['None','Normal','Fire','Water','Electric','Grass','Ice','Fighting','Poison','Ground','Flying','Psychic','Bug','Rock','Ghost','Dragon','Dark','Steel','Fairy'],
                  description:'Optional secondary Pokémon type, or None'
                },
                status:{
                  type:'string',
                  enum:['Caught','Released','Uncaught'],
                  description:'Status: Caught (employed), Released (available for hire), Uncaught (student or exploring)'
                },
                company:{ type:'string', description:'Current employer company name (required if status is Caught, max 80 characters)' },
                entry:{ type:'string', description:'Third-person dex flavour text, two short sentences, 150 characters max' },
                fact:{ type:'string', description:'Optional short personal fact or tip, 100 characters max' }
              },
              required:['github','species','primaryType','status','entry']
            },
            execute: async (args: Record<string, unknown>)=>{
              Object.entries(args||{}).forEach(([k,v])=>{
                const el=form.querySelector(`[name="${k}"]`);
                if(el && 'value' in el) (el as HTMLInputElement).value=String(v);
              });
              form.dispatchEvent(new Event('submit',{ cancelable: true }));
              return { success: true };
            }
          });
        }catch{}
      }
    }
  </script>
  <script is:inline type="module">import('/generation-device/app.js?v=91.0');</script>
  <script>
    const loader=document.querySelector('#page-loader');
    const factOwner=document.querySelector('#loader-fact-owner');
    const extraFact=document.querySelector('#loader-extra-fact');
    if(loader instanceof HTMLElement&&factOwner instanceof HTMLAnchorElement&&extraFact instanceof HTMLElement){
      try{const facts=JSON.parse(loader.dataset.facts||'[]');const selected=facts[Math.floor(Math.random()*facts.length)];if(selected){factOwner.textContent=`@${selected.github}`;factOwner.href=`https://github.com/${selected.github}`;extraFact.textContent=`DEX FACT: ${selected.fact}`;}}catch{}
    }
    const reduced=window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let dexReady=document.documentElement.classList.contains('dex-ready');
    let minTimeElapsed=false;
    const hideLoader=()=>{
      if(dexReady&&minTimeElapsed&&loader instanceof HTMLElement){
        loader.classList.add('loader-done');
        window.setTimeout(()=>loader.remove(),reduced?0:180);
      }
    };
    window.addEventListener('dex:ready',()=>{
      dexReady=true;
      hideLoader();
    },{once:true});
    window.setTimeout(()=>{
      minTimeElapsed=true;
      hideLoader();
    },reduced?0:800);
    window.setTimeout(()=>{
      dexReady=true;
      minTimeElapsed=true;
      hideLoader();
    },2800);
  </script>
  <script>
    const world=document.querySelector('.world-backdrop');
    const setWorldTime=()=>{if(!(world instanceof HTMLElement))return;const hour=new Date().getHours();const time=hour>=5&&hour<8?'dawn':hour>=8&&hour<17?'day':hour>=17&&hour<20?'sunset':'night';world.dataset.time=time;document.documentElement.dataset.time=time;};
    setWorldTime();window.setInterval(setWorldTime,60000);
  </script>
  <script>
    const menuToggle = document.querySelector('#menu-toggle');
    const siteDrawer = document.querySelector('#site-drawer');
    const drawerBackdrop = document.querySelector('#site-drawer-backdrop');
    const closeDrawer = document.querySelector('#close-drawer');
    const drawerAddPokemon = document.querySelector('#drawer-add-pokemon');

    if (menuToggle instanceof HTMLButtonElement && siteDrawer instanceof HTMLElement && drawerBackdrop instanceof HTMLElement && closeDrawer instanceof HTMLButtonElement) {
      let isTransitioning = false;

      const openDrawer = () => {
        if (isTransitioning) return;
        isTransitioning = true;

        siteDrawer.hidden = false;
        siteDrawer.removeAttribute('hidden');
        drawerBackdrop.hidden = false;
        drawerBackdrop.removeAttribute('hidden');

        const scrollBarWidth = window.innerWidth - document.documentElement.clientWidth;
        document.documentElement.style.overflow = 'hidden';
        if (scrollBarWidth > 0) {
          document.documentElement.style.paddingRight = `${scrollBarWidth}px`;
        }

        void siteDrawer.offsetHeight;
        siteDrawer.classList.remove('is-closing');
        siteDrawer.classList.add('is-open');
        drawerBackdrop.classList.remove('is-closing');
        drawerBackdrop.classList.add('is-open');
        menuToggle.setAttribute('aria-expanded', 'true');

        setTimeout(() => {
          closeDrawer.focus({ preventScroll: true });
          isTransitioning = false;
        }, 60);
      };

      const closeDrawerMenu = (e?: Event) => {
        if (e) {
          e.preventDefault();
          e.stopPropagation();
        }
        if (isTransitioning) return;
        if (!siteDrawer.classList.contains('is-open')) return;
        isTransitioning = true;

        siteDrawer.classList.add('is-closing');
        siteDrawer.classList.remove('is-open');
        drawerBackdrop.classList.add('is-closing');
        drawerBackdrop.classList.remove('is-open');
        menuToggle.setAttribute('aria-expanded', 'false');

        document.documentElement.style.overflow = '';
        document.documentElement.style.paddingRight = '';

        setTimeout(() => {
          siteDrawer.hidden = true;
          siteDrawer.setAttribute('hidden', '');
          siteDrawer.classList.remove('is-closing');

          drawerBackdrop.hidden = true;
          drawerBackdrop.setAttribute('hidden', '');
          drawerBackdrop.classList.remove('is-closing');

          isTransitioning = false;
          menuToggle.focus({ preventScroll: true });
        }, 200);
      };

      menuToggle.addEventListener('click', (e) => {
        e.stopPropagation();
        const isOpen = siteDrawer.classList.contains('is-open');
        if (isOpen) {
          closeDrawerMenu(e);
        } else {
          openDrawer();
        }
      });

      closeDrawer.addEventListener('click', closeDrawerMenu);
      drawerBackdrop.addEventListener('click', closeDrawerMenu);

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && siteDrawer.classList.contains('is-open')) {
          closeDrawerMenu(e);
        }
      });

      drawerAddPokemon?.addEventListener('click', () => {
        closeDrawerMenu();
        const dialog = document.querySelector('#submission-dialog');
        if (dialog instanceof HTMLDialogElement) {
          dialog.showModal();
        }
      });

      siteDrawer.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => {
          closeDrawerMenu();
        });
      });

      // Swipe / Drag to dismiss gesture
      let startX = 0;
      let currentX = 0;
      let isDragging = false;

      siteDrawer.addEventListener('touchstart', (e) => {
        if (e.touches.length !== 1) return;
        startX = e.touches[0].clientX;
        currentX = startX;
        isDragging = true;
      }, { passive: true });

      siteDrawer.addEventListener('touchmove', (e) => {
        if (!isDragging) return;
        currentX = e.touches[0].clientX;
        const deltaX = currentX - startX;
        if (deltaX > 0) {
          siteDrawer.style.transform = `translateX(${deltaX}px)`;
          const opacity = Math.max(0, 1 - deltaX / 300);
          drawerBackdrop.style.opacity = String(opacity);
        }
      }, { passive: true });

      siteDrawer.addEventListener('touchend', () => {
        if (!isDragging) return;
        isDragging = false;
        const deltaX = currentX - startX;
        siteDrawer.style.transform = '';
        drawerBackdrop.style.opacity = '';
        if (deltaX > 80) {
          closeDrawerMenu();
        }
      });
    }

      const wordleBtn = document.querySelector('#open-wordle-native-btn');
      const wordleDialog = document.querySelector('#wordle-native-dialog');
      const closeWordleBtn = document.querySelector('#close-wordle-dialog');
      const wordleFrame = document.querySelector('#wordle-dialog-frame');

      if (wordleDialog instanceof HTMLDialogElement) {
        const focusIframe = () => {
          if (wordleFrame instanceof HTMLIFrameElement) {
            try {
              wordleFrame.contentWindow?.focus();
              wordleFrame.focus({ preventScroll: true });
            } catch (_) {}
          }
        };

        wordleBtn?.addEventListener('click', (e) => {
          e.preventDefault();
          const savedScrollY = window.scrollY;
          wordleDialog.showModal();
          window.scrollTo({ top: savedScrollY, behavior: 'instant' });
          setTimeout(focusIframe, 80);
          setTimeout(focusIframe, 250);
        });

        closeWordleBtn?.addEventListener('click', () => {
          wordleDialog.close();
        });

        wordleDialog.addEventListener('click', (e) => {
          if (e.target === wordleDialog) {
            wordleDialog.close();
          } else {
            focusIframe();
          }
        });

        document.addEventListener('keydown', (e) => {
          if (wordleDialog.open) {
            if (e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement) return;
            if (e.key === 'Escape') {
              wordleDialog.close();
              return;
            }
            if (e.key === 'Enter' || e.key === 'Backspace' || /^[a-zA-Z]$/.test(e.key)) {
              if (wordleFrame instanceof HTMLIFrameElement && wordleFrame.contentWindow) {
                wordleFrame.contentWindow.postMessage({
                  type: 'KEY_INPUT',
                  key: e.key
                }, '*');
              }
            }
          }
        });
      }
  </script>
