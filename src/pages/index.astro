---
import Base from '../layouts/Base.astro';
import roster from '../data/roster.json';

const types = ['Normal','Fire','Water','Electric','Grass','Ice','Fighting','Poison','Ground','Flying','Psychic','Bug','Rock','Ghost','Dragon','Dark','Steel','Fairy'];
const loaderFacts = [
  { github: 'smresponsibilities', fact: 'Shipped 425+ test suites.', source: 'fallback' },
  { github: 'smresponsibilities', fact: 'Processed 5 million events with zero row-count tolerance.', source: 'fallback' },
  { github: 'smresponsibilities', fact: 'Solved 2,600+ algorithmic problems.', source: 'fallback' },
  { github: 'smresponsibilities', fact: 'Placed third among 200+ HackIndia teams.', source: 'fallback' },
  ...roster.flatMap((entry) => entry.fact
    ? [{ github: entry.github, fact: entry.fact, source: 'roster' }]
    : []),
];
const initialLoaderFact = loaderFacts[0];
const description = 'Shivam Mahajan is a software developer building Python, Kotlin, data, blockchain and web projects. Explore his experience, work and public developer dex.';
const homepage = new URL('/', Astro.site ?? 'https://shivammahajan.com').href;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${homepage}#website`,
      url: homepage,
      name: "SM'S DEX",
      description,
      inLanguage: 'en-IN',
    },
    {
      '@type': 'ProfilePage',
      '@id': `${homepage}#profile-page`,
      url: homepage,
      name: 'Shivam Mahajan — Software Developer',
      description,
      isPartOf: { '@id': `${homepage}#website` },
      mainEntity: { '@id': `${homepage}#shivam-mahajan` },
    },
    {
      '@type': 'Person',
      '@id': `${homepage}#shivam-mahajan`,
      name: 'Shivam Mahajan',
      alternateName: 'smresponsibilities',
      url: homepage,
      jobTitle: 'Software Developer',
      description: 'Software developer working with Python, Kotlin, Kafka, PySpark, Snowflake, React and Solidity.',
      sameAs: [
        'https://github.com/smresponsibilities',
        'https://www.linkedin.com/in/mahajanshivam/',
      ],
      alumniOf: {
        '@type': 'CollegeOrUniversity',
        name: 'Chitkara University',
      },
      knowsAbout: ['Python', 'Kotlin', 'Kafka', 'PySpark', 'Snowflake', 'React', 'Solidity'],
    },
  ],
};
const projects = [
  { number:'001', name:'Productivity Caller', stack:'Kotlin / Jetpack Compose', copy:'Replaces push notifications with native phone calls as reminders.For quick adding tasks made a NLP pipeline of 80+ patterns cuts manual entry 75%.', stats:['425+ test suites','+significant% task completion'], url:'https://drive.google.com/file/d/1O9mQD-Qeo7GR40SdG440pdqSM8NdXV_K/view?usp=sharing', action:'Demo Video' },
  { number:'002', name:'Chaincode', stack:'Solidity / MERN / Python', copy:'Coding platform that validates code originality with Gemini AI at 95%+ accuracy and mints it as NFTs.', stats:['15+ REST APIs','3rd of 200+ teams'], url:'https://github.com/smresponsibilities/Chain-Code', action:'View repository' },
  { number:'003', name:'QuizDeck', stack:'React / WebSockets', copy:'Runs live multiplayer quizzes for at max 500 concurrent players with a 31 ms average response time.', stats:['Stress tested for 500 concurrent users','PP 1/10 · archived'], url:'https://github.com/smresponsibilities/QuizDeck', action:'View repository' },
];
---

<Base title="Shivam Mahajan — Software Developer" description={description} structuredData={structuredData} accentTypes={['dragon', 'steel']}>
  <Fragment slot="head"><link rel="stylesheet" href="/generation-device/style.css?v=80.0" /></Fragment>
  <div class="loader" id="page-loader" role="status" aria-live="polite" data-facts={JSON.stringify(loaderFacts)}>
    <div class="snake-loader" aria-hidden="true"><span class="loader-orbit"></span><img src="/logos/pixel-python.png" width="16" height="16" alt="" /></div>
    <p>Loading SM'S DEX…</p>
    <p class="loader-mobile-note">Best viewed on wider screens.</p>
    <p class="loader-static-fact">FACT: SM likes paneer and is unemployed right now.</p>
    {initialLoaderFact && <p class="loader-fact"><a id="loader-fact-owner" href={`https://github.com/${initialLoaderFact.github}`} target="_blank" rel="noreferrer">@{initialLoaderFact.github}</a><span id="loader-extra-fact">DEX FACT: {initialLoaderFact.fact}</span></p>}
  </div>
  <div class="world-backdrop" data-time="day" aria-hidden="true">
    <div class="world-tech world-tech-1"><img src="/logos/pixel-python.png" width="16" height="16" alt="" /></div>
    <div class="world-tech world-tech-2"><img src="/logos/pixel-react.png" width="16" height="16" alt="" /></div>
    <div class="world-tech world-tech-3"><img src="/logos/pixel-html.png" width="16" height="16" alt="" /></div>
    <div class="world-tech world-tech-4"><img src="/logos/pixel-css.png" width="16" height="16" alt="" /></div>
    <div class="world-tech world-tech-5"><img src="/logos/pixel-git.png" width="16" height="16" alt="" /></div>
    <div class="world-tech world-tech-6"><img src="/logos/pixel-docker.png" width="16" height="16" alt="" /></div>
    <div class="world-tech world-tech-7"><img src="/logos/pixel-kotlin.png" width="16" height="16" alt="" /></div>
    <div class="world-tech world-tech-8"><img src="/logos/pixel-python.png" width="16" height="16" alt="" /></div>
    <div class="world-tech world-tech-9"><img src="/logos/pixel-snowflake.png" width="16" height="16" alt="" /></div>
    <div class="world-tech world-tech-10"><img src="/logos/pixel-solidity.png" width="16" height="16" alt="" /></div>
  </div>
  <a class="skip-link" href="#main">Skip to portfolio</a>
  <header class="portfolio-header">
    <a class="brand" href="#main" aria-label="Shivam Mahajan portfolio home">SM'S DEX</a>
    <p>Shivam Mahajan is a software developer building production systems with Python, Kotlin, Kafka, PySpark, Snowflake, React and Solidity. To be added as a pokemon click on the Add Pokemon Button.</p>
    <nav class="header-actions" aria-label="Portfolio actions"><button class="tooltip-switch" id="tooltip-switch" type="button" role="switch" aria-checked="true"><span class="tooltip-switch-label">Tips</span><span class="tooltip-switch-track" aria-hidden="true"><span></span></span></button><a class="resume-button" data-resume href="/resume.pdf" target="_blank" rel="noreferrer">Resume</a><button class="add-button" id="open-submission" type="button" data-tooltip="Open the form to join the public roster">Add Pokémon</button></nav>
  </header>

  <main id="main">
    <section class="device-section" aria-labelledby="device-heading">
      <div class="section-heading">
        <div><span class="eyebrow">Portfolio Dex · Choose a generation</span><h1 id="device-heading">Shivam Mahajan — Software Developer</h1></div>
        <p>Generation I loads first.<br> Pick any generation to change the device.</p>
      </div>
      <div class="device-native">
        <nav id="generations" aria-label="Device generation"></nav>
        <div class="device-title" hidden><div><h2 id="region">Kanto</h2><p id="games">Red / Blue</p></div><span id="edition">GEN I</span></div>
        <section id="stage" aria-label="Interactive portfolio device"><div id="rig"></div><div id="cover-drag" aria-hidden="true"></div></section>
        <div class="opening">
          <div id="slide-track"><span id="slide-label">Slide right to open</span><button id="slide-handle" aria-label="Open device" aria-expanded="true" aria-controls="reader"><span aria-hidden="true">→</span></button></div>
          <div class="opening-tools"><button id="toggle" aria-expanded="true" aria-controls="reader" data-tooltip="Open or close this generation's device">Close device</button><button id="power" data-tooltip="Turn the portfolio screen on or off">Power off</button><button id="reader-toggle" aria-expanded="false" aria-controls="reader" data-tooltip="Show the accessible large-text portfolio controls">Readable view</button></div>
        </div>
        <p id="status" role="status" aria-live="polite">Device open.</p>
        <div id="effect-controls" class="effect-controls" aria-label="Device effects" hidden></div>
        <section id="reader" aria-label="Readable portfolio" hidden><div id="reader-content"></div><nav id="reader-controls" aria-label="Portfolio controls"></nav></section>
        <button id="assets-toggle" hidden aria-expanded="false" aria-controls="asset-panel">Asset library</button>
        <section id="asset-panel" hidden aria-label="Generation asset library"><div id="asset-grid"></div><a id="reference"></a><p id="source-note"></p><button id="download">Download selected SVG</button><label><input id="reduce-motion" type="checkbox" /> Reduce motion</label></section>
      </div>
    </section>

    <section class="about-section content-section" aria-labelledby="about-heading">
      <div class="section-index" aria-hidden="true">ABOUT / 001</div>
      <div>
        <span class="eyebrow">Humanoid Pokémon · Dragon / Steel</span>
        <h2 id="about-heading">About Shivam Mahajan</h2>
        <p class="lead">Building software across 2,002 days of code.</p>
        <p>Shivam works across Python, Kotlin, data platforms, smart contracts and web software. His work includes 425+ test suites, 5 million processed events and 2,600+ solved algorithmic problems.</p>
        <nav class="profile-links" aria-label="Shivam's profiles">
          <a href="https://github.com/smresponsibilities" target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a>
          <a href="https://www.linkedin.com/in/mahajanshivam/" target="_blank" rel="noreferrer">LinkedIn <span aria-hidden="true">↗</span></a>
          <a href="mailto:shivammahajan.mail@gmail.com">Email <span aria-hidden="true">↗</span></a>
        </nav>
      </div>
    </section>

    <section class="experience-section content-section" aria-labelledby="experience-heading">
      <div class="section-index" aria-hidden="true">EXPERIENCE / 002</div>
      <div>
        <span class="eyebrow">Encounter History</span><h2 id="experience-heading">Experience</h2>
        <article class="experience-card"><div><span class="project-number">AUG 2025 – AUG 2026</span><h3>Morgan Stanley</h3><p class="project-stack">Technology Apprentice</p></div><p>Intialized CIAM Data warehouse with infrastructure across Kafka, PySpark, Snowflake and used mTLS and RBAC. Processed more than 5 million events with zero row-count tolerance and enabled clients to see their events in real time.</p></article>
        <p class="availability"><span aria-hidden="true"></span><strong>RELEASED</strong> · Available for software engineering and other relevant roles now.</p>
      </div>
    </section>

    <section class="projects-section content-section" aria-labelledby="projects-heading">
      <div class="section-index" aria-hidden="true">MOVES / 003</div>
      <div class="projects-content">
        <span class="eyebrow">Selected Work</span><h2 id="projects-heading">Projects</h2>
        <div class="project-grid">
          {projects.map((project) => (
            <article class="project-card">
              <div class="project-number">MOVE {project.number}</div><h3>{project.name}</h3>
              <p class="project-stack">{project.stack}</p><p>{project.copy}</p>
              <ul>{project.stats.map((stat) => <li>{stat}</li>)}</ul>
              <a class="project-link" href={project.url} target={project.url.startsWith('http')?'_blank':undefined} rel={project.url.startsWith('http')?'noreferrer':undefined}>{project.action} <span aria-hidden="true">↗</span></a>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">Pokémon © Nintendo / Creatures / GAME FREAK · Tested by my friends.</footer>

  <dialog id="submission-dialog" aria-labelledby="submission-heading">
    <div class="dialog-heading"><div><span class="eyebrow">Public Roster</span><h2 id="submission-heading">Add Your Pokémon</h2></div><button class="close-button" id="close-submission" type="button" aria-label="Close submission form" data-tooltip="Close the roster form">×</button></div>
    <p class="dialog-copy">Fill your dex entry. Please don't use AI as I will be stringent in reviewing. Submitting opens a GitHub issue. After review, the roster workflow creates the pull request.</p>
    <form id="submission-form">
      <div class="field-grid">
        <label>GitHub Username <input name="github" required maxlength="39" autocomplete="off" spellcheck="false" placeholder="SM" pattern="[A-Za-z0-9](?:[A-Za-z0-9\-]{0,37}[A-Za-z0-9])?" /><span class="field-hint">Your GitHub handle. No @ symbol.</span></label>
        <label>Species <input name="species" required maxlength="24" autocomplete="off" placeholder="Builder Pokémon" /><span class="field-hint">A short role-like Pokémon species.</span></label>
        <label>Primary Type <select name="primaryType" required><option value="">Choose type…</option>{types.map((type) => <option>{type}</option>)}</select><span class="field-hint">Your strongest working style or skill.</span></label>
        <label>Secondary Type <select name="secondaryType"><option value="None">None</option>{types.map((type) => <option>{type}</option>)}</select><span class="field-hint">Optional second strength. Choose None if not needed.</span></label>
        <label>Status <select name="status" required><option value="Caught">Caught</option><option value="Released">Released</option><option value="Uncaught">Uncaught</option></select><span class="field-hint">Caught means employed. Released means available. Uncaught means student or exploring.</span></label>
        <label class="company-field" data-company-field>Current Employer <input name="company" maxlength="80" autocomplete="organization" placeholder="Company name" /><span class="field-hint">Required only when status is Caught.</span></label>
      </div>
      <label>Dex Entry <textarea name="entry" required maxlength="150" rows="4" autocomplete="off" placeholder="Builds weird tools. Keeps every system on edge under stress."></textarea><span class="field-hint">Third person. 2 short sentences. 150 characters max.</span></label>
      <label>Fact / Tip <input name="fact" maxlength="100" autocomplete="off" placeholder="Optional short fact about you like I like paneer" /><span class="field-hint">Optional. 100 characters max.</span></label>
      <div class="form-actions"><button class="secondary-button" id="cancel-submission" type="button" data-tooltip="Close without opening an issue">Cancel</button><button class="submit-button" type="submit" data-tooltip="Open a prefilled GitHub issue for review">Open GitHub Issue</button></div>
      <p id="submission-status" class="form-status" aria-live="polite"></p>
    </form>
  </dialog>

  <script>
    const dialog=document.querySelector('#submission-dialog'); const form=document.querySelector('#submission-form'); const status=document.querySelector('#submission-status'); const openButton=document.querySelector('#open-submission');
    if(dialog instanceof HTMLDialogElement&&form instanceof HTMLFormElement&&status instanceof HTMLElement&&openButton instanceof HTMLButtonElement){
      openButton.addEventListener('click',()=>dialog.showModal());
      ['#close-submission','#cancel-submission'].forEach(selector=>document.querySelector(selector)?.addEventListener('click',()=>dialog.close()));
      dialog.addEventListener('click',event=>{if(event.target===dialog)dialog.close();});
      const employment=form.querySelector('[name="status"]');const company=form.querySelector('[name="company"]');const companyField=form.querySelector('[data-company-field]');
      const syncCompany=()=>{const caught=employment instanceof HTMLSelectElement&&employment.value==='Caught';if(companyField instanceof HTMLElement)companyField.hidden=!caught;if(company instanceof HTMLInputElement){company.required=caught;if(!caught)company.value='';}};
      employment?.addEventListener('change',syncCompany);syncCompany();
      form.addEventListener('submit',event=>{event.preventDefault();const data=new FormData(form);const github=String(data.get('github')||'').trim();const fields=[['GitHub username',github],['Species',data.get('species')],['Primary type',data.get('primaryType')],['Secondary type',data.get('secondaryType')||'None'],['Status',data.get('status')],...(data.get('status')==='Caught'?[['Company',data.get('company')]]:[]),['Dex entry',data.get('entry')],['Fact / tip (optional)',data.get('fact')||'—']];const body=fields.map(([label,value])=>`### ${label}\n${value}`).join('\n\n');const params=new URLSearchParams({title:`[DEX] ${github}`,body});status.textContent='Opening GitHub issue…';window.open(`https://github.com/smresponsibilities/smresponsibilities.github.io/issues/new?${params}`,'_blank','noopener,noreferrer');dialog.close();});
    }
  </script>
  <script is:inline type="module" src="/generation-device/app.js?v=89.0"></script>
  <script>
    const loader=document.querySelector('#page-loader');
    const factOwner=document.querySelector('#loader-fact-owner');
    const extraFact=document.querySelector('#loader-extra-fact');
    if(loader instanceof HTMLElement&&factOwner instanceof HTMLAnchorElement&&extraFact instanceof HTMLElement){
      try{const facts=JSON.parse(loader.dataset.facts||'[]');const selected=facts[Math.floor(Math.random()*facts.length)];if(selected){factOwner.textContent=`@${selected.github}`;factOwner.href=`https://github.com/${selected.github}`;extraFact.textContent=`DEX FACT: ${selected.fact}`;}}catch{}
    }
    const dismissLoader=()=>{const reduced=window.matchMedia('(prefers-reduced-motion: reduce)').matches;window.setTimeout(()=>{if(loader instanceof HTMLElement){loader.classList.add('loader-done');window.setTimeout(()=>loader.remove(),reduced?0:180);}},reduced?0:1200);};
    if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',dismissLoader,{once:true});else dismissLoader();
  </script>
  <script>
    const world=document.querySelector('.world-backdrop');
    const setWorldTime=()=>{if(!(world instanceof HTMLElement))return;const hour=new Date().getHours();const time=hour>=5&&hour<8?'dawn':hour>=8&&hour<17?'day':hour>=17&&hour<20?'sunset':'night';world.dataset.time=time;document.documentElement.dataset.time=time;};
    setWorldTime();window.setInterval(setWorldTime,60000);
  </script>
</Base>

<style>
  .skip-link{position:fixed;top:8px;left:8px;z-index:20;transform:translateY(-150%);padding:10px 14px;background:var(--ink);color:var(--bg)}.skip-link:focus{transform:translateY(0)}
  .portfolio-header{position:relative;z-index:5;display:grid;grid-template-columns:auto minmax(0,1fr) auto;align-items:center;gap:24px;max-width:1180px;margin:auto;padding:20px 28px;border-bottom:1px solid var(--border)}
  .brand{display:inline-flex;align-items:center;min-height:var(--tap);color:var(--ink);font:400 var(--fs-head)/1 var(--font-display);text-decoration:none;letter-spacing:var(--track-label);white-space:nowrap}.portfolio-header p{max-width:65ch;margin:0;color:var(--dim);font-size:16px}
  .header-actions{display:flex;align-items:center;gap:10px}.tooltip-switch{display:flex;align-items:center;justify-content:center;gap:8px;min-height:var(--tap);padding:6px 4px;border:0;background:transparent;color:var(--ink);font:var(--fs-label)/1 var(--font-display);letter-spacing:var(--track-label);text-transform:uppercase;cursor:pointer}.tooltip-switch:hover .tooltip-switch-label{color:var(--time-accent,var(--accent))}.tooltip-switch-track{position:relative;width:38px;height:22px;border:2px solid var(--dim);border-radius:999px;background:#1a202a;transition:background-color var(--dur-fast) var(--ease)}.tooltip-switch-track span{position:absolute;top:3px;left:3px;width:12px;height:12px;border-radius:50%;background:var(--dim);transition:transform var(--dur-base) var(--ease),background-color var(--dur-fast) var(--ease)}.tooltip-switch[aria-checked=true] .tooltip-switch-track{border-color:var(--time-accent,var(--accent));background:color-mix(in srgb,var(--time-accent,var(--accent)) 28%,#111722)}.tooltip-switch[aria-checked=true] .tooltip-switch-track span{transform:translateX(16px);background:var(--ink)}
  button,input,select,textarea{font:inherit}button{touch-action:manipulation}.add-button,.submit-button{min-height:var(--tap);padding:10px 18px;border:2px solid var(--accent);border-radius:var(--radius);background:var(--accent);color:#fff;font-family:var(--font-display);cursor:pointer}.add-button:hover,.submit-button:hover{filter:brightness(1.16)}
  main{overflow:clip}.device-section{position:relative;isolation:isolate;max-width:1160px;margin:auto;padding:42px 24px 72px}.section-heading{position:relative;z-index:2;display:flex;align-items:end;justify-content:space-between;gap:28px;max-width:1080px;margin:0 auto 12px}.section-heading p{max-width:42ch;margin:0;color:var(--dim);font-size:16px;text-align:end}
  .eyebrow,.section-index,.project-number,.project-stack,.field-hint{color:var(--dim);font-family:var(--font-display);font-size:var(--fs-label);letter-spacing:var(--track-label);text-transform:uppercase}h1,h2,h3{font-weight:400}h1{margin-top:6px}h2{margin:8px 0 20px;font:400 var(--fs-name)/1.15 var(--font-display)}h3{margin:10px 0 4px;font:400 var(--fs-head)/1.2 var(--font-display)}
  .device-native{position:relative;z-index:2;min-height:600px;padding:0 14px 18px;background:#080b10a8;backdrop-filter:blur(1px)}.pixel-world{position:absolute;z-index:0;inset:105px 0 36px;overflow:hidden;border:1px solid #343840;background:linear-gradient(#16284b 0 58%,#352d54 58% 70%,#111c2e 70%);image-rendering:pixelated}.pixel-world::before{content:"";position:absolute;inset:0;background:linear-gradient(90deg,#ffffff08 1px,transparent 1px),linear-gradient(#ffffff08 1px,transparent 1px);background-size:8px 8px;opacity:.45}.tech-logo{position:absolute;display:grid;place-items:center;min-width:54px;height:54px;padding:8px;border:4px solid #090d16;background:#e8eddf;color:#111827;font:400 13px/1 var(--font-display);box-shadow:8px 8px 0 #080b10;animation:tech-float 9s steps(12) infinite;will-change:transform}.tech-python{left:5%;top:12%;background:linear-gradient(135deg,#3776ab 0 50%,#ffd343 50%);color:#fff}.tech-kotlin{right:7%;top:18%;background:linear-gradient(135deg,#7f52ff,#ff4785 55%,#ff8a00);color:#fff;animation-delay:-2s}.tech-react{left:10%;bottom:23%;background:#18232d;color:#61dafb;font-size:28px;animation-delay:-5s}.tech-kafka{right:5%;bottom:25%;background:#211f20;color:#fff;font-size:9px;animation-delay:-7s}.tech-snowflake{left:23%;top:8%;background:#29b5e8;color:#fff;font-size:24px;animation-delay:-3s}.tech-solidity{right:23%;top:8%;background:#363636;color:#bbb;font-size:26px;animation-delay:-6s}.pixel-hills{position:absolute;inset:auto 0 0;height:22%;background:linear-gradient(135deg,transparent 20%,#172f32 20% 40%,transparent 40%) 0 0/180px 100%,linear-gradient(45deg,#0b171c 25%,transparent 25%) 0 100%/96px 55%}@keyframes tech-float{0%,100%{transform:translateY(0) rotate(-2deg)}50%{transform:translateY(-22px) rotate(2deg)}}
  .content-section{display:grid;grid-template-columns:minmax(120px,220px) minmax(0,850px);gap:48px;max-width:1160px;margin:auto;padding:88px 28px;border-top:1px solid var(--border)}.content-section>div:last-child{min-width:0}
  .lead{max-width:28ch;margin:0 0 18px;font:400 var(--fs-head)/1.4 var(--font-display)}.about-section p:not(.lead){max-width:68ch;font-size:17px}.profile-links{display:flex;flex-wrap:wrap;gap:12px;margin-top:28px}.profile-links a{display:inline-flex;align-items:center;min-height:var(--tap);padding:10px 14px;border:1px solid var(--border);color:var(--ink);text-decoration:none}.profile-links a:hover{border-color:var(--accent);background:var(--panel)}
  .projects-content{width:100%}.project-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.project-card,.experience-card{min-width:0;padding:22px;border:1px solid var(--border);background:var(--panel)}.project-card p{overflow-wrap:break-word}.project-stack{min-height:36px}.project-card ul{padding-left:18px;color:var(--dim)}.experience-card{display:grid;grid-template-columns:minmax(220px,.75fr) 1fr;gap:28px}.experience-card p{margin-top:0}.availability{display:flex;align-items:center;gap:8px;margin-top:16px;color:var(--dim)}.availability span{width:10px;height:10px;border-radius:50%;background:#59d987;box-shadow:0 0 0 4px #59d9871f}.site-footer{padding:24px;border-top:1px solid var(--border);color:var(--dim);font-size:var(--fs-label);text-align:center}
