---
import EditorialShell from '../../components/EditorialShell.astro';
import DaysTimeline from '../../components/DaysTimeline.astro';
import allPosts from '../../data/linkedin-posts.json';

const posts = [...allPosts].sort((a, b) => b.day - a.day);
const latest = posts[0];

const groups = [];
for (const p of posts) {
  const lower = Math.floor((p.day - 1) / 100) * 100 + 1;
  const upper = lower + 99;
  const gName = `${lower}-${upper}`;
  let g = groups.find(x => x.name === gName);
  if (!g) {
    g = { name: gName, posts: [] };
    groups.push(g);
  }
  g.posts.push(p);
}

const postUrl = latest.url;
const embedUrl = latest.url.replace('%3A', ':').replace('linkedin.com/feed/update', 'linkedin.com/embed/feed/update');

const pinnedDays = [1228, 1000, 500, 100, 1];
const pinnedMilestones = pinnedDays.map(d => {
  const p = allPosts.find(item => item.day === d);
  const titles: Record<number, string> = {
    1228: 'Day 1228: 2,000 Questions Solved on LeetCode',
    1000: 'Day 1000: Extended Challenge to #2002DaysOfCode',
    500: 'Day 500: 1,150 LeetCode Questions & DP Trees',
    100: 'Day 100: First Century Completed',
    1: 'Day 1: Where 2,002 Days of Code Began'
  };
  return {
    day: d,
    date: p ? p.date : '',
    title: titles[d] || (p?.milestone ?? `Day ${d} Milestone`)
  };
});

const currentUrl = new URL(Astro.url.pathname, Astro.site ?? 'https://shivammahajan.com').href;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Blog',
      '@id': `${currentUrl}#blog`,
      name: 'Days of Code',
      description: 'Shivam posts daily progress on LinkedIn. This journal connects selected updates to the projects and engineering notes on this site.',
      url: currentUrl,
      author: { '@id': 'https://shivammahajan.com/#shivam-mahajan' },
      publisher: { '@id': 'https://shivammahajan.com/#shivam-mahajan' }
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${currentUrl}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://shivammahajan.com/' },
        { '@type': 'ListItem', position: 2, name: 'Blog', item: currentUrl }
      ]
    }
  ]
};
---
<EditorialShell 
  title="Days of Code Journal | Shivam Mahajan" 
  description="Follow Shivam Mahajan's 2,002 Days of Code journey, software engineering notes, LeetCode problem walkthroughs, and technical project milestones." 
  eyebrow="Field notes / Days of Code" 
  heading="Days of Code" 
  intro="Shivam posts daily progress on LinkedIn. This journal connects selected updates to the projects and engineering notes on this site."
  structuredData={structuredData}
>
  
  <section aria-labelledby="featured-post"><span class="eyebrow">Selected update / Day {latest.day}</span><h2 id="featured-post">LinkedIn post from {latest.date}</h2><p>Read the original post or choose an embedded view.</p>
    <div class="actions"><a href={postUrl} target="_blank" rel="noopener noreferrer">Read original post ↗</a><button type="button" class="embed-button" data-view="compact" aria-controls="post-embed">Show compact embed</button><button type="button" class="embed-button" data-view="full" aria-controls="post-embed">Show full embed</button></div>
    <div id="post-embed" class="post-embed" aria-live="polite"></div>
  </section>

  <section class="search-section" aria-labelledby="search-heading">
    <div class="search-header">
      <span class="eyebrow">Algorithmic Index · 1,500+ LeetCode Solutions</span>
      <h2 id="search-heading">Search Days of Code & LeetCode Questions</h2>
      <p>Search 1,246+ daily engineering logs by LeetCode problem name (e.g. <em>"Two Sum"</em>, <em>"Parentheses"</em>), problem number (e.g. <em>"1"</em>, <em>"1541"</em>), date, streak day, or topic.</p>
    </div>
    
    <div class="search-input-group">
      <input 
        type="search" 
        id="post-search" 
        placeholder="Search by LeetCode question (e.g. 'Two Sum', '#1541'), day, or keyword..." 
        aria-label="Search posts and LeetCode problems" 
        autocomplete="off" 
        spellcheck="false" 
      />
      <button type="button" id="clear-search" class="clear-search-btn" aria-label="Clear search" hidden>Clear</button>
    </div>

    <div class="search-chips" aria-label="Suggested LeetCode searches">
      <span class="chips-label">Popular queries:</span>
      <button type="button" class="search-chip" data-query="1">#1 Two Sum</button>
      <button type="button" class="search-chip" data-query="1541">#1541 Parentheses</button>
      <button type="button" class="search-chip" data-query="509">#509 Fibonacci</button>
      <button type="button" class="search-chip" data-query="347">#347 Frequent Elements</button>
      <button type="button" class="search-chip" data-query="301">#301 Invalid Parentheses</button>
      <button type="button" class="search-chip" data-query="829">#829 Consecutive Numbers</button>
      <button type="button" class="search-chip" data-query="tree">Tree</button>
      <button type="button" class="search-chip" data-query="dynamic programming">Dynamic Programming</button>
    </div>

    <div id="search-status" class="search-status" role="status" aria-live="polite"></div>
    <div id="search-results" class="grid search-grid" style="margin-top: 1.5rem; display: none;"></div>
  </section>

  <section class="pinned-milestones-index" aria-labelledby="pinned-milestones-heading">
    <div class="pinned-header">
      <span class="eyebrow">Engineering Anchors · Key Benchmarks</span>
      <h2 id="pinned-milestones-heading">Pinned Streak Milestones</h2>
      <p>Pivotal checkpoints and algorithmic breakthroughs across the 2,002 Days of Code journey. <a href="/blog/milestones/">Browse all milestones →</a></p>
    </div>
    <div class="pinned-index-grid">
      {pinnedMilestones.map(m => (
        <a href={`/blog/day-${m.day}/`} class="pinned-index-card">
          <div class="pinned-index-top">
            <span class="pinned-index-badge">Day {m.day}</span>
            <time class="pinned-index-date" datetime={m.date}>{m.date}</time>
          </div>
          <h3 class="pinned-index-title">{m.title}</h3>
          <span class="pinned-index-action">Read Log →</span>
        </a>
      ))}
    </div>
  </section>

  <section aria-labelledby="recent-days"><h2 id="recent-days">Recent days</h2><DaysTimeline variant={1} limit={10} /><p><a href="/blog/timeline/">Full timeline</a></p></section>

      <section id="archive-section">
    <h2>Complete History (Zoomed Out)</h2>
    <p>Every single day of the streak.</p>
    
    <div class="heatmap-container">
      <div class="heatmap">
        {posts.map(post => (
          <a href={`/blog/day-${post.day}/`} 
             class={`heat-box ${post.easterEgg ? "has-glitch" : ""}`} 
             title={`Day ${post.day}: ${post.date} ${post.easterEgg ? "(Glitch)" : ""}`}>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="century-archives">
    <h2>Century Archives</h2>
    <p>Browse the 2,002 Days of Code challenge grouped into 100-day chapters:</p>
    <div class="grid">
      {groups.map((g) => (
        <article class="card">
          <span class="eyebrow">{g.posts.length} entries</span>
          <h3><a href={`/blog/archive/${g.name}/`}>Days {g.name} ↗</a></h3>
          <p>Daily updates from Day {g.posts[g.posts.length - 1]?.day} to Day {g.posts[0]?.day}.</p>
        </article>
      ))}
    </div>
    <p style="margin-top: 1.5rem;"><a href="/blog/month/2026-10/" style="color: var(--accent); font-weight: bold; border-bottom: 1px solid var(--accent); padding-bottom: 2px;">Browse Monthly Archives (October 2026 → May 2023) →</a></p>
  </section>

  <section><h2>Read on this site</h2><div class="grid">
    <article class="card"><span class="eyebrow">Profile</span><h3><a href="/blog/shivam-mahajan-software-developer/">Shivam Mahajan, software developer</a></h3><p>Experience, project focus, and where to find the resume.</p></article>
    <article class="card"><span class="eyebrow">Overview</span><h3><a href="/blog/shivam-mahajan/">Shivam Mahajan: Engineer Profile</a></h3><p>Career journey, engineering practices, and project background.</p></article>
    <article class="card"><span class="eyebrow">Build notes</span><h3><a href="/blog/how-the-sm-dex-roster-works/">How the SM'S DEX roster works</a></h3><p>GitHub issue → validation → reviewed pull request.</p></article>
  </div></section>
  <section><h2>About this journal</h2><p>Daily posts live on LinkedIn. This page highlights selected updates and original notes.</p></section>
</EditorialShell>
<script define:vars={{ embedUrl }}>
  document.querySelectorAll('[data-view]').forEach((button) => {
    button.addEventListener('click', () => {
      const compact = button.dataset.view === 'compact';
      const frame = document.createElement('iframe');
      frame.src = compact ? `${embedUrl}?collapsed=1` : embedUrl;
      frame.title = compact ? 'Compact LinkedIn post' : 'Full LinkedIn post';
      frame.width = '504';
      frame.height = compact ? '443' : '611';
      frame.loading = 'lazy';
      frame.allowFullscreen = true;
      document.getElementById('post-embed').replaceChildren(frame);
    });
  });
</script>
