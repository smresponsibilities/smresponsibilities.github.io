<script>
  const searchInput = document.getElementById('post-search');
  const clearBtn = document.getElementById('clear-search');
  const searchStatus = document.getElementById('search-status');
  const searchResults = document.getElementById('search-results');
  const archiveSection = document.getElementById('archive-section');
  const chips = document.querySelectorAll('.search-chip');
  let allPosts = [];

  const escapeHtml = (str) => {
    return String(str || '').replace(/[&<>"']/g, (m) => ({
      '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
    }[m]));
  };

  const loadPosts = async () => {
    if (allPosts.length === 0) {
      try {
        const res = await fetch('/api/posts.json');
        allPosts = await res.json();
      } catch (err) {
        console.error('Failed to load posts index', err);
      }
    }
  };

  const performSearch = (rawQuery) => {
    const q = rawQuery.trim().toLowerCase();
    if (!q) {
      searchResults.style.display = 'none';
      if (archiveSection) archiveSection.style.display = 'block';
      if (clearBtn) clearBtn.hidden = true;
      if (searchStatus) searchStatus.textContent = '';
      return;
    }

    if (clearBtn) clearBtn.hidden = false;
    if (archiveSection) archiveSection.style.display = 'none';
    searchResults.style.display = 'grid';

    // Parse potential problem or day number: e.g. "1", "#1541", "lc 509", "leetcode 28"
    const numMatch = q.match(/^(?:#|lc\s*|leetcode\s*)?(\d+)$/i);
    const searchNum = numMatch ? parseInt(numMatch[1], 10) : null;

    const hits = allPosts.filter(p => {
      if (searchNum !== null) {
        if (p.questions && p.questions.some(item => item.number === searchNum)) return true;
        if (p.day === searchNum) return true;
      }
      if (p.questions && p.questions.some(item => item.title.toLowerCase().includes(q))) return true;
      if (p.content && p.content.toLowerCase().includes(q)) return true;
      if (p.date && p.date.includes(q)) return true;
      return false;
    });

    hits.sort((a, b) => {
      const aHasQ = a.questions && a.questions.some(item => 
        (searchNum !== null && item.number === searchNum) || item.title.toLowerCase().includes(q)
      );
      const bHasQ = b.questions && b.questions.some(item => 
        (searchNum !== null && item.number === searchNum) || item.title.toLowerCase().includes(q)
      );
      if (aHasQ && !bHasQ) return -1;
      if (!aHasQ && bHasQ) return 1;
      return b.day - a.day;
    });

    const displayHits = hits.slice(0, 32);

    if (searchStatus) {
      searchStatus.textContent = hits.length === 0
        ? `No days found matching "${rawQuery}".`
        : `Found ${hits.length} day${hits.length === 1 ? '' : 's'} matching "${rawQuery}"${hits.length > 32 ? ' (showing top 32)' : ''}:`;
    }

    if (hits.length === 0) {
      searchResults.innerHTML = `
        <div class="no-results-box">
          <p>No matching LeetCode questions or daily logs found for <strong>"${escapeHtml(rawQuery)}"</strong>.</p>
          <p class="search-tip">Try searching by problem number (e.g. <code>1</code>, <code>1541</code>) or keywords like <em>array</em>, <em>string</em>, <em>parentheses</em>, or <em>tree</em>.</p>
        </div>
      `;
      return;
    }

    searchResults.innerHTML = displayHits.map(p => {
      const matchedQuestions = (p.questions || []).filter(item => 
        (searchNum !== null && item.number === searchNum) || item.title.toLowerCase().includes(q)
      );
      const otherQuestions = (p.questions || []).filter(item => 
        !matchedQuestions.includes(item)
      );

      return `
        <article class="card search-card ${matchedQuestions.length ? 'has-lc-match' : ''}">
          <div class="search-card-meta">
            <span class="eyebrow">${escapeHtml(p.date)} · Day ${p.day}</span>
            <a href="/blog/day-${p.day}/" class="day-link">Day ${p.day} log ↗</a>
          </div>
          ${matchedQuestions.length > 0 ? `
            <div class="search-lc-tags">
              ${matchedQuestions.map(item => `
                <span class="lc-tag lc-tag-matched">
                  🧩 LeetCode #${item.number}: ${escapeHtml(item.title)}
                </span>
              `).join('')}
            </div>
          ` : ''}
          ${otherQuestions.length > 0 ? `
            <div class="search-lc-tags secondary-tags">
              ${otherQuestions.slice(0, 2).map(item => `
                <span class="lc-tag">
                  LC #${item.number}: ${escapeHtml(item.title)}
                </span>
              `).join('')}
            </div>
          ` : ''}
          <p class="search-snippet">${escapeHtml(p.content.slice(0, 160))}…</p>
        </article>
      `;
    }).join('');
  };

  if (searchInput) {
    searchInput.addEventListener('focus', loadPosts);
    searchInput.addEventListener('input', (e) => {
      loadPosts().then(() => performSearch(e.target.value));
    });
  }

  if (clearBtn) {
    clearBtn.addEventListener('click', () => {
      if (searchInput) {
        searchInput.value = '';
        performSearch('');
        searchInput.focus();
      }
    });
  }

  chips.forEach(chip => {
    chip.addEventListener('click', () => {
      const query = chip.dataset.query || '';
      if (searchInput) {
        searchInput.value = query;
        loadPosts().then(() => performSearch(query));
      }
    });
  });
</script>

