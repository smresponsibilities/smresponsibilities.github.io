---
import EditorialShell from '../../components/EditorialShell.astro';
import DaysTimeline from '../../components/DaysTimeline.astro';
import allPosts from '../../data/linkedin-posts.json';

const posts = [...allPosts].sort((a, b) => b.day - a.day);
const latest = posts[0];

const groups = [];
for (const p of posts) {
  const lower = Math.floor((p.day - 1) / 100) * 100 + 1;
  const upper = lower + 99;
  const gName = `${lower}-${upper}`;
  let g = groups.find(x => x.name === gName);
  if (!g) {
    g = { name: gName, posts: [] };
    groups.push(g);
  }
  g.posts.push(p);
}

const postUrl = latest.url;
const embedUrl = latest.url.replace('%3A', ':').replace('linkedin.com/feed/update', 'linkedin.com/embed/feed/update');

const pinnedDays = [1228, 1000, 500, 100, 1];
const pinnedMilestones = pinnedDays.map(d => {
  const p = allPosts.find(item => item.day === d);
  const titles: Record<number, string> = {
    1228: 'Day 1228: 2,000 Questions Solved on LeetCode',
    1000: 'Day 1000: Extended Challenge to #2002DaysOfCode',
    500: 'Day 500: 1,150 LeetCode Questions & DP Trees',
    100: 'Day 100: First Century Completed',
    1: 'Day 1: Where 2,002 Days of Code Began'
  };
  return {
    day: d,
    date: p ? p.date : '',
    title: titles[d] || (p?.milestone ?? `Day ${d} Milestone`)
  };
});

const currentUrl = new URL(Astro.url.pathname, Astro.site ?? 'https://shivammahajan.com').href;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Blog',
      '@id': `${currentUrl}#blog`,
      name: 'Days of Code',
      description: 'Shivam posts daily progress on LinkedIn. This journal connects selected updates to the projects and engineering notes on this site.',
      url: currentUrl,
      author: { '@id': 'https://shivammahajan.com/#shivam-mahajan' },
      publisher: { '@id': 'https://shivammahajan.com/#shivam-mahajan' }
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${currentUrl}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://shivammahajan.com/' },
        { '@type': 'ListItem', position: 2, name: 'Blog', item: currentUrl }
      ]
    }
  ]
};
---
<EditorialShell 
  title="Days of Code Journal | Shivam Mahajan" 
  description="Follow Shivam Mahajan's 2,002 Days of Code journey, software engineering notes, LeetCode problem walkthroughs, and technical project milestones." 
  eyebrow="Field notes / Days of Code" 
  heading="Days of Code" 
  intro="Shivam posts daily progress on LinkedIn. This journal connects selected updates to the projects and engineering notes on this site."
  structuredData={structuredData}
>
  
  <section aria-labelledby="featured-post"><span class="eyebrow">Selected update / Day {latest.day}</span><h2 id="featured-post">LinkedIn post from {latest.date}</h2><p>Read the original post or choose an embedded view.</p>
    <div class="actions"><a href={postUrl} target="_blank" rel="noopener noreferrer">Read original post ↗</a><button type="button" class="embed-button" data-view="compact" aria-controls="post-embed">Show compact embed</button><button type="button" class="embed-button" data-view="full" aria-controls="post-embed">Show full embed</button></div>
    <div id="post-embed" class="post-embed" aria-live="polite"></div>
  </section>

  <section class="search-section" aria-labelledby="search-heading">
    <div class="search-header">
      <span class="eyebrow">Algorithmic Index · 1,500+ LeetCode Solutions</span>
      <h2 id="search-heading">Search Days of Code & LeetCode Questions</h2>
      <p>Search 1,246+ daily engineering logs by LeetCode problem name (e.g. <em>"Two Sum"</em>, <em>"Parentheses"</em>), problem number (e.g. <em>"1"</em>, <em>"1541"</em>), date, streak day, or topic.</p>
    </div>
    
    <ul class="tag-input-shell" id="tag-input-shell" role="list">
      <li class="tag-input-item">
        <input 
          type="text" 
          id="post-search" 
          class="tag-input-field"
          placeholder="Search by LeetCode question, #number, or keyword..." 
          aria-label="Search posts and LeetCode problems" 
          autocomplete="off" 
          autocapitalize="off" 
          autocorrect="off" 
          spellcheck="false" 
          enterkeyhint="done" 
        />
      </li>
    </ul>

    <div class="tag-meta-bar">
      <span id="tag-hint" class="tag-hint">Enter adds · Backspace removes</span>
      <div class="tag-meta-right">
        <button type="button" id="clear-search" class="tag-clear-link" hidden>Clear all</button>
        <span id="tag-counter" class="tag-counter">0 / 6</span>
      </div>
    </div>

    <div class="filter-pills-bar" role="radiogroup" aria-label="Filter by problem category">
      <button type="button" class="filter-pill is-active" data-tag="all" role="radio" aria-checked="true">
        <span>All</span>
        <span class="filter-pill-count">1,258</span>
      </button>
      <button type="button" class="filter-pill" data-tag="#1 Two Sum" role="radio" aria-checked="false">
        <span>#1 Two Sum</span>
        <span class="filter-pill-count">3</span>
      </button>
      <button type="button" class="filter-pill" data-tag="Tree" role="radio" aria-checked="false">
        <span>Tree</span>
        <span class="filter-pill-count">48</span>
      </button>
      <button type="button" class="filter-pill" data-tag="Binary Search" role="radio" aria-checked="false">
        <span>Binary Search</span>
        <span class="filter-pill-count">21</span>
      </button>
      <button type="button" class="filter-pill" data-tag="Graph" role="radio" aria-checked="false">
        <span>Graph</span>
        <span class="filter-pill-count">25</span>
      </button>
      <button type="button" class="filter-pill" data-tag="Parentheses" role="radio" aria-checked="false">
        <span>Parentheses</span>
        <span class="filter-pill-count">17</span>
      </button>
      <button type="button" class="filter-pill" data-tag="Dynamic Programming" role="radio" aria-checked="false">
        <span>Dynamic Programming</span>
        <span class="filter-pill-count">8</span>
      </button>
      <button type="button" class="filter-pill" data-tag="#509 Fibonacci" role="radio" aria-checked="false">
        <span>#509 Fibonacci</span>
        <span class="filter-pill-count">3</span>
      </button>
    </div>

    <div id="search-status" class="search-status" role="status" aria-live="polite"></div>
    <div id="search-results" class="search-grid" style="display: none;"></div>
  </section>

  <section class="pinned-milestones-index" aria-labelledby="pinned-milestones-heading">
    <div class="pinned-header">
      <span class="eyebrow">Engineering Anchors · Key Benchmarks</span>
      <h2 id="pinned-milestones-heading">Pinned Streak Milestones</h2>
      <p>Pivotal checkpoints and algorithmic breakthroughs across the 2,002 Days of Code journey. <a href="/blog/milestones/">Browse all milestones →</a></p>
    </div>
    <div class="pinned-index-grid">
      {pinnedMilestones.map(m => (
        <a href={`/blog/day-${m.day}/`} class="pinned-index-card">
          <div class="pinned-index-top">
            <span class="pinned-index-badge">Day {m.day}</span>
            <time class="pinned-index-date" datetime={m.date}>{m.date}</time>
          </div>
          <h3 class="pinned-index-title">{m.title}</h3>
          <span class="pinned-index-action">Read Log →</span>
        </a>
      ))}
    </div>
  </section>

  <section aria-labelledby="recent-days"><h2 id="recent-days">Recent days</h2><DaysTimeline variant={1} limit={10} /><p><a href="/blog/timeline/">Full timeline</a></p></section>

      <section id="archive-section">
    <h2>Complete History (Zoomed Out)</h2>
    <p>Every single day of the streak.</p>
    
    <div class="heatmap-container">
      <div class="heatmap">
        {posts.map(post => (
          <a href={`/blog/day-${post.day}/`} 
             class={`heat-box ${post.easterEgg ? "has-glitch" : ""}`} 
             title={`Day ${post.day}: ${post.date} ${post.easterEgg ? "(Glitch)" : ""}`}>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="century-archives">
    <h2>Century Archives</h2>
    <p>Browse the 2,002 Days of Code challenge grouped into 100-day chapters:</p>
    <div class="grid">
      {groups.map((g) => (
        <article class="card">
          <span class="eyebrow">{g.posts.length} entries</span>
          <h3><a href={`/blog/archive/${g.name}/`}>Days {g.name} ↗</a></h3>
          <p>Daily updates from Day {g.posts[g.posts.length - 1]?.day} to Day {g.posts[0]?.day}.</p>
        </article>
      ))}
    </div>
    <p style="margin-top: 1.5rem;"><a href="/blog/month/2026-10/" style="color: var(--accent); font-weight: bold; border-bottom: 1px solid var(--accent); padding-bottom: 2px;">Browse Monthly Archives (October 2026 → May 2023) →</a></p>
  </section>

  <section><h2>Read on this site</h2><div class="grid">
    <article class="card"><span class="eyebrow">Profile</span><h3><a href="/blog/shivam-mahajan-software-developer/">Shivam Mahajan, software developer</a></h3><p>Experience, project focus, and where to find the resume.</p></article>
    <article class="card"><span class="eyebrow">Overview</span><h3><a href="/blog/shivam-mahajan/">Shivam Mahajan: Engineer Profile</a></h3><p>Career journey, engineering practices, and project background.</p></article>
    <article class="card"><span class="eyebrow">Build notes</span><h3><a href="/blog/how-the-sm-dex-roster-works/">How the SM'S DEX roster works</a></h3><p>GitHub issue → validation → reviewed pull request.</p></article>
  </div></section>
  <section><h2>About this journal</h2><p>Daily posts live on LinkedIn. This page highlights selected updates and original notes.</p></section>
</EditorialShell>
<script define:vars={{ embedUrl }}>
  document.querySelectorAll('[data-view]').forEach((button) => {
    button.addEventListener('click', () => {
      const compact = button.dataset.view === 'compact';
      const frame = document.createElement('iframe');
      frame.src = compact ? `${embedUrl}?collapsed=1` : embedUrl;
      frame.title = compact ? 'Compact LinkedIn post' : 'Full LinkedIn post';
      frame.width = '504';
      frame.height = compact ? '443' : '611';
      frame.loading = 'lazy';
      frame.allowFullscreen = true;
      document.getElementById('post-embed').replaceChildren(frame);
    });
  });
</script>
<style>
  .embed-button{min-height:48px;padding:12px 16px;border:2px solid var(--accent);background:var(--panel);color:var(--ink);font:inherit;cursor:pointer}
  .embed-button:hover{background:var(--accent);color:var(--bg)}
  .post-embed{margin-top:24px;max-width:504px}.post-embed :global(iframe){display:block;width:100%;max-width:504px;border:0}

  .heatmap-container {
    width: 100%;
    overflow-x: auto;
    padding: 1rem 0;
  }
  .heatmap {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    max-width: 800px;
  }
  .heat-box {
    width: 12px;
    height: 12px;
    background: #4ade80;
    border-radius: 2px;
    transition: transform 0.1s, opacity 0.2s;
  }
  .heat-box:hover {
    transform: scale(1.5);
    opacity: 0.8;
  }
  .heat-box.has-glitch {
    background: #f59e0b;
    animation: pulse 2s infinite;
  }
  @keyframes pulse {
    0% { transform: scale(1); }
    50% { transform: scale(1.2); }
    100% { transform: scale(1); }
  }



</style>
<script>
  const shell = document.getElementById('tag-input-shell');
  const searchInput = document.getElementById('post-search');
  const clearBtn = document.getElementById('clear-search');
  const searchStatus = document.getElementById('search-status');
  const searchResults = document.getElementById('search-results');
  const archiveSection = document.getElementById('archive-section');
  const tagHint = document.getElementById('tag-hint');
  const tagCounter = document.getElementById('tag-counter');
  const pills = document.querySelectorAll('.filter-pill');

  let allPosts = [];
  let tags = [];
  let armedIndex = -1;
  const MAX_TAGS = 6;

  const escapeHtml = (str) => {
    return String(str || '').replace(/[&<>"']/g, (m) => ({
      '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
    }[m]));
  };

  const loadPosts = async () => {
    if (allPosts.length === 0) {
      try {
        const res = await fetch('/api/posts.json');
        allPosts = await res.json();
      } catch (err) {
        console.error('Failed to load posts index', err);
      }
    }
  };

  const getPostRelevance = (post, filter) => {
    if (!filter || !post) return 0;
    const q = filter.trim().toLowerCase();
    if (!q) return 0;

    // 1. Explicit streak day: 'day 1', 'day-1', 'day1', '#day1', 'd1', 'day:1'
    const dayMatch = q.match(/^(?:day|d|#day)[-\s:]*(\d+)$/i);
    if (dayMatch) {
      const dNum = parseInt(dayMatch[1], 10);
      return post.day === dNum ? 1000 : 0;
    }

    let score = 0;

    // 2. LC combo: e.g. '#1 Two Sum', '1 Two Sum', 'lc 1 Two Sum'
    const comboMatch = q.match(/^(?:(?:lc|leetcode)\s*#?|#)?(\d+)\s+(.+)$/i);
    if (comboMatch) {
      const num = parseInt(comboMatch[1], 10);
      const text = comboMatch[2].trim().toLowerCase();
      if (post.questions) {
        for (const item of post.questions) {
          if (item.number === num && item.title.toLowerCase().includes(text)) score += 950;
          else if (item.number === num) score += 800;
          else if (item.title.toLowerCase().includes(text)) score += 600;
        }
      }
      return score;
    }

    // 3. Pure number: e.g. '1', '#1', 'lc 509'
    const numMatch = q.match(/^(?:(?:lc|leetcode)\s*#?|#)?(\d+)$/i);
    if (numMatch) {
      const num = parseInt(numMatch[1], 10);
      const hasPrefix = /^(?:lc|leetcode|#)/i.test(q);
      if (post.questions && post.questions.some(item => item.number === num)) {
        score += hasPrefix ? 900 : 850;
      }
      if (post.day === num) {
        score += hasPrefix ? 750 : 900;
      }
      return score;
    }

    // 4. LeetCode question title matches
    if (post.questions) {
      for (const item of post.questions) {
        const titleLower = item.title.toLowerCase();
        if (titleLower === q) score += 900;
        else if (titleLower.startsWith(q)) score += 800;
        else if (titleLower.includes(q)) score += 700;
      }
    }

    // 5. Date match: YYYY, YYYY-MM, or YYYY-MM-DD
    if (/^\d{4}(-\d{2}(-\d{2})?)?$/.test(q)) {
      if (post.date && post.date.startsWith(q)) score += 600;
      return score;
    }

    // 6. Content match with whole-word or substring
    if (q.length >= 3 && post.content) {
      const contentLower = post.content.toLowerCase();
      if (/\d/.test(q)) {
        try {
          const escaped = q.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
          const regex = new RegExp('\\b' + escaped + '\\b', 'i');
          if (regex.test(post.content)) score += 400;
        } catch (_) {
          if (contentLower.includes(q)) score += 300;
        }
      } else {
        if (contentLower.includes(q)) score += 300;
      }
    }

    return score;
  };

  const matchPost = (post, raw) => {
    return getPostRelevance(post, raw) > 0;
  };

  const matchQuestion = (qItem, raw) => {
    if (!raw || !qItem) return false;
    const q = raw.trim().toLowerCase();
    
    // Streak day filter does NOT match individual questions:
    if (/^(?:day|d|#day)[-\s:]*(\d+)$/i.test(q)) return false;

    // Combo match: "#1 Two Sum" or "1 Two Sum"
    const comboMatch = q.match(/^(?:(?:lc|leetcode)\s*#?|#)?(\d+)\s+(.+)$/i);
    if (comboMatch) {
      const num = parseInt(comboMatch[1], 10);
      const text = comboMatch[2].trim().toLowerCase();
      if (qItem.number === num || qItem.title.toLowerCase().includes(text)) return true;
    }

    // Number match: "#1" or "1" or "lc 509"
    const numMatch = q.match(/^(?:(?:lc|leetcode)\s*#?|#)?(\d+)$/i);
    if (numMatch) {
      const num = parseInt(numMatch[1], 10);
      if (qItem.number === num) return true;
    }

    // Title substring match
    if (qItem.title.toLowerCase().includes(q)) return true;
    return false;
  };

  const renderTags = () => {
    if (!shell) return;
    const existing = shell.querySelectorAll('.tag-chip');
    existing.forEach(el => el.remove());

    const inputItem = shell.querySelector('.tag-input-item');

    tags.forEach((tag, idx) => {
      const li = document.createElement('li');
      li.className = `tag-chip ${idx === armedIndex ? 'is-armed' : ''}`;
      li.setAttribute('role', 'listitem');

      const span = document.createElement('span');
      span.className = 'tag-chip-label';
      span.textContent = tag;

      const removeBtn = document.createElement('button');
      removeBtn.type = 'button';
      removeBtn.className = 'tag-remove-btn';
      removeBtn.setAttribute('aria-label', `Remove ${tag}`);
      removeBtn.tabIndex = -1;
      removeBtn.innerHTML = `
        <svg viewBox="0 0 10 10" width="9" height="9" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
          <path d="M2.6 2.6 7.4 7.4M7.4 2.6 2.6 7.4" />
        </svg>
      `;

      removeBtn.addEventListener('mousedown', (e) => e.preventDefault());
      removeBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        removeTag(idx);
        if (searchInput) searchInput.focus();
      });

      li.appendChild(span);
      li.appendChild(removeBtn);
      shell.insertBefore(li, inputItem);
    });

    if (searchInput) {
      if (tags.length === 0) {
        searchInput.placeholder = "Search by LeetCode question, #number, or keyword...";
      } else {
        searchInput.placeholder = "Add another filter...";
      }
    }

    const hasQuery = tags.length > 0 || (searchInput && searchInput.value.trim().length > 0);
    if (clearBtn) clearBtn.hidden = !hasQuery;

    pills.forEach(pill => {
      const pillTag = pill.dataset.tag;
      if (pillTag === 'all') {
        const isAll = tags.length === 0 && (!searchInput || searchInput.value.trim().length === 0);
        pill.classList.toggle('is-active', isAll);
        pill.setAttribute('aria-checked', isAll ? 'true' : 'false');
      } else {
        const on = tags.some(t => t.toLowerCase() === pillTag.toLowerCase());
        pill.classList.toggle('is-active', on);
        pill.setAttribute('aria-checked', on ? 'true' : 'false');
      }
    });

    if (tagCounter) {
      tagCounter.textContent = `${tags.length} / ${MAX_TAGS}`;
    }

    if (tagHint) {
      if (armedIndex !== -1 && tags[armedIndex]) {
        tagHint.textContent = `Press Backspace again to remove "${tags[armedIndex]}"`;
        tagHint.classList.add('hint-armed');
      } else {
        tagHint.textContent = "Enter adds · Backspace removes";
        tagHint.classList.remove('hint-armed');
      }
    }
  };

  const addTag = (raw) => {
    const text = raw.trim();
    if (!text) return;
    if (tags.length >= MAX_TAGS) {
      if (tagHint) tagHint.textContent = `Limit of ${MAX_TAGS} tags reached.`;
      return;
    }
    const existingIdx = tags.findIndex(t => t.toLowerCase() === text.toLowerCase());
    if (existingIdx !== -1) {
      flashTag(existingIdx);
      return;
    }
    tags.push(text);
    armedIndex = -1;
    renderTags();
    performSearch();
  };

  const removeTag = (idx) => {
    if (idx >= 0 && idx < tags.length) {
      tags.splice(idx, 1);
      armedIndex = -1;
      renderTags();
      performSearch();
      if (searchInput) searchInput.focus();
    }
  };

  const flashTag = (idx) => {
    if (!shell) return;
    const chipsList = shell.querySelectorAll('.tag-chip');
    if (chipsList[idx]) {
      chipsList[idx].classList.add('is-flashed');
      setTimeout(() => chipsList[idx]?.classList.remove('is-flashed'), 450);
    }
  };

  const performSearch = () => {
    const draft = searchInput ? searchInput.value.trim() : '';
    const activeFilters = [...tags];
    if (draft) activeFilters.push(draft);

    if (activeFilters.length === 0) {
      if (searchResults) searchResults.style.display = 'none';
      if (archiveSection) archiveSection.style.display = 'block';
      if (clearBtn) clearBtn.hidden = true;
      if (searchStatus) searchStatus.textContent = '';
      return;
    }

    if (clearBtn) clearBtn.hidden = false;
    if (archiveSection) archiveSection.style.display = 'none';
    if (searchResults) searchResults.style.display = 'grid';

    const hits = allPosts.map(p => {
      let totalScore = 0;
      for (const filter of activeFilters) {
        const s = getPostRelevance(p, filter);
        if (s <= 0) return null;
        totalScore += s;
      }
      return { post: p, score: totalScore };
    }).filter(Boolean);

    hits.sort((a, b) => {
      if (b.score !== a.score) return b.score - a.score;
      return b.post.day - a.post.day;
    });

    const displayHits = hits.slice(0, 32).map(h => h.post);
    const filterLabels = tags.map(t => `[${t}]`).join(' ');
    const querySummary = draft ? `${filterLabels} "${draft}"`.trim() : filterLabels;

    if (searchStatus) {
      searchStatus.textContent = hits.length === 0
        ? `No days found matching ${querySummary}.`
        : `Found ${hits.length} day${hits.length === 1 ? '' : 's'} matching ${querySummary}${hits.length > 32 ? ' (showing top 32)' : ''}:`;
    }

    if (!searchResults) return;

    if (hits.length === 0) {
      searchResults.innerHTML = `
        <div class="no-results-box">
          <p class="no-results-title">No matching daily logs found for <strong>${escapeHtml(querySummary)}</strong></p>
          <p class="no-results-hint">Try searching by problem number (e.g. <code>#1</code>, <code>1541</code>) or topics like <em>Tree</em>, <em>Binary Search</em>, or <em>Parentheses</em>.</p>
        </div>
      `;
      return;
    }

    searchResults.innerHTML = displayHits.map(p => {
      const matchedQuestions = (p.questions || []).filter(item => 
        activeFilters.some(filter => matchQuestion(item, filter))
      );
      const otherQuestions = (p.questions || []).filter(item => 
        !matchedQuestions.includes(item)
      );

      return `
        <article class="search-card ${matchedQuestions.length ? 'has-lc-match' : ''}">
          <div class="search-card-meta">
            <span class="search-card-eyebrow">${escapeHtml(p.date)} · Day ${p.day}</span>
            <a href="/blog/day-${p.day}/" class="day-link">Day ${p.day} log ↗</a>
          </div>
          ${matchedQuestions.length > 0 ? `
            <div class="search-lc-tags">
              ${matchedQuestions.map(item => `
                <span class="lc-tag lc-tag-matched">
                  🧩 LC #${item.number}: ${escapeHtml(item.title)}
                </span>
              `).join('')}
            </div>
          ` : ''}
          ${otherQuestions.length > 0 ? `
            <div class="search-lc-tags secondary-tags">
              ${otherQuestions.slice(0, 2).map(item => `
                <span class="lc-tag">
                  LC #${item.number}: ${escapeHtml(item.title)}
                </span>
              `).join('')}
            </div>
          ` : ''}
          <p class="search-snippet">${escapeHtml((p.content || '').slice(0, 160))}…</p>
        </article>
      `;
    }).join('');
  };

  if (searchInput) {
    searchInput.addEventListener('focus', loadPosts);

    searchInput.addEventListener('keydown', (e) => {
      const val = searchInput.value;

      if (e.key === 'Enter' || e.key === ',') {
        e.preventDefault();
        if (val.trim()) {
          loadPosts().then(() => {
            addTag(val);
            searchInput.value = '';
          });
        }
        return;
      }

      if (e.key === 'Backspace' && val === '') {
        if (e.repeat) return;
        if (armedIndex >= 0) {
          e.preventDefault();
          removeTag(armedIndex);
        } else if (tags.length > 0) {
          e.preventDefault();
          armedIndex = tags.length - 1;
          renderTags();
        }
        return;
      }

      if (e.key === 'Delete' && armedIndex >= 0) {
        e.preventDefault();
        if (e.repeat) return;
        removeTag(armedIndex);
        return;
      }

      if (e.key === 'ArrowLeft' && val === '' && searchInput.selectionStart === 0 && searchInput.selectionEnd === 0 && tags.length > 0) {
        e.preventDefault();
        armedIndex = armedIndex < 0 ? tags.length - 1 : Math.max(0, armedIndex - 1);
        renderTags();
        return;
      }

      if (e.key === 'ArrowRight' && armedIndex >= 0) {
        e.preventDefault();
        if (armedIndex >= tags.length - 1) {
          armedIndex = -1;
        } else {
          armedIndex += 1;
        }
        renderTags();
        return;
      }

      if (e.key === 'Escape' && armedIndex >= 0) {
        e.preventDefault();
        armedIndex = -1;
        renderTags();
        return;
      }

      if (armedIndex !== -1) {
        armedIndex = -1;
        renderTags();
      }
    });

    searchInput.addEventListener('input', () => {
      if (armedIndex !== -1) {
        armedIndex = -1;
        renderTags();
      }
      loadPosts().then(() => performSearch());
    });

    searchInput.addEventListener('blur', () => {
      if (armedIndex !== -1) {
        armedIndex = -1;
        renderTags();
      }
    });

    searchInput.addEventListener('paste', (e) => {
      const text = (e.clipboardData || window.clipboardData)?.getData('text');
      if (!text) return;
      if (text.includes(',') || text.includes('\n')) {
        e.preventDefault();
        const parts = text.split(/[\n,]+/).map(s => s.trim()).filter(Boolean);
        loadPosts().then(() => {
          parts.forEach(p => addTag(p));
          searchInput.value = '';
        });
      }
    });
  }

  if (shell) {
    shell.addEventListener('click', (e) => {
      if (e.target.closest('.tag-chip')) return;
      if (searchInput) searchInput.focus();
    });
  }

  if (clearBtn) {
    clearBtn.addEventListener('click', () => {
      tags = [];
      armedIndex = -1;
      if (searchInput) searchInput.value = '';
      renderTags();
      performSearch();
      if (searchInput) searchInput.focus();
    });
  }

  pills.forEach((pill, idx) => {
    pill.addEventListener('click', () => {
      const tag = pill.dataset.tag;
      if (!tag) return;
      loadPosts().then(() => {
        if (tag === 'all') {
          tags = [];
          if (searchInput) searchInput.value = '';
          renderTags();
          performSearch();
        } else {
          const existingIdx = tags.findIndex(t => t.toLowerCase() === tag.toLowerCase());
          if (existingIdx !== -1) {
            removeTag(existingIdx);
          } else {
            addTag(tag);
            if (searchInput) {
              searchInput.value = '';
              searchInput.focus();
            }
          }
        }
      });
    });

    pill.addEventListener('keydown', (e) => {
      let targetIndex = -1;
      if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
        e.preventDefault();
        targetIndex = (idx + 1) % pills.length;
      } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
        e.preventDefault();
        targetIndex = (idx - 1 + pills.length) % pills.length;
      } else if (e.key === 'Home') {
        e.preventDefault();
        targetIndex = 0;
      } else if (e.key === 'End') {
        e.preventDefault();
        targetIndex = pills.length - 1;
      }
      if (targetIndex !== -1 && pills[targetIndex]) {
        pills[targetIndex].focus();
        pills[targetIndex].click();
      }
    });
  });

  renderTags();
</script>

