---
import EditorialShell from '../../../components/EditorialShell.astro';
import allPosts from '../../../data/linkedin-posts.json';

const pokemonEras = [
  { era: 'Gen I · Kanto', pokemon: 'Pikachu', title: 'Genesis & First Algorithms' },
  { era: 'Gen II · Johto', pokemon: 'Cyndaquil', title: 'Data Structures & C++ Shift' },
  { era: 'Gen III · Hoenn', pokemon: 'Torchic', title: 'Complexity Analysis & Monotonic Structures' },
  { era: 'Gen IV · Sinnoh', pokemon: 'Piplup', title: 'Bit Manipulation & Pandas' },
  { era: 'Gen V · Unova', pokemon: 'Snivy', title: 'Halfway Mark & Combinatorics' },
  { era: 'Gen VI · Kalos', pokemon: 'Froakie', title: 'Frequency Counters & Trees' },
  { era: 'Gen VII · Alola', pokemon: 'Rowlet', title: 'Contests & Algorithmic Speed' },
  { era: 'Gen VIII · Galar', pokemon: 'Scorbunny', title: 'Multi-Language Mastery & Heaps' },
  { era: 'Gen IX · Paldea', pokemon: 'Sprigatito', title: '100% Non-Premium Easy Solved' },
  { era: 'Ultra Apex', pokemon: 'Mewtwo', title: 'Dynamic Programming & Millennium Approach' },
  { era: 'Time Origin', pokemon: 'Dialga', title: 'Crossing 1,001 into 2,002 Quest' },
  { era: 'Systems Core', pokemon: 'Arceus', title: 'High-Velocity Arrays & CIAM Systems' },
  { era: 'Apex Era', pokemon: 'Koraidon', title: 'Production Platforms & 425+ Test Suites' }
];

const posts = [...allPosts].sort((a, b) => b.day - a.day);
const groupsMap: Record<string, any[]> = {};
for (const p of posts) {
  const lower = Math.floor((p.day - 1) / 100) * 100 + 1;
  const upper = lower + 99;
  const gName = `${lower}-${upper}`;
  if (!groupsMap[gName]) groupsMap[gName] = [];
  groupsMap[gName].push(p);
}

const groups = Object.keys(groupsMap).map((gName, idx) => {
  const gPosts = groupsMap[gName];
  gPosts.sort((a, b) => a.day - b.day);
  const minDate = gPosts[0]?.date || '';
  const maxDate = gPosts[gPosts.length - 1]?.date || '';
  const meta = pokemonEras[idx] || { era: `Century ${idx + 1}`, pokemon: 'Pikachu', title: `Days ${gName}` };
  return {
    name: gName,
    centuryNum: idx + 1,
    count: gPosts.length,
    minDate,
    maxDate,
    dateRange: `${minDate.slice(0, 7)} → ${maxDate.slice(0, 7)}`,
    ...meta
  };
});

// Latest century first for directory
groups.reverse();

const currentUrl = new URL(Astro.url.pathname, Astro.site ?? 'https://shivammahajan.com').href;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': `${currentUrl}#collection`,
      isPartOf: { '@id': 'https://shivammahajan.com/#website' },
      url: currentUrl,
      name: 'Century Archives | 2,002 Days of Code',
      description: "Directory of 100-day century archives across Shivam Mahajan's 2,002 Days of Code challenge. Select any century to view its day scroll timeline."
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${currentUrl}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://shivammahajan.com/' },
        { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://shivammahajan.com/blog/' },
        { '@type': 'ListItem', position: 3, name: 'Century Archives', item: currentUrl }
      ]
    }
  ]
};
---

<EditorialShell
  title="Century Archives | 2,002 Days of Code"
  description="Directory of 100-day century archives across Shivam Mahajan's 2,002 Days of Code challenge. Select any century to view its day scroll timeline."
  eyebrow="100-Day Chapters · Directory"
  heading="Century Archives"
  intro="Browse the 2,002 Days of Code journey grouped into 100-day century blocks. Select any century to view its interactive day-by-day scroll timeline."
  structuredData={structuredData}
>
  <nav class="breadcrumb-nav" aria-label="Breadcrumbs" style="margin-bottom: 2rem;">
    <a href="/">Home</a> <span>/</span>
    <a href="/blog/">Blog</a> <span>/</span>
    <span>Century Archives</span>
  </nav>

  <div class="century-grid">
    {groups.map((g) => (
      <article class="century-card">
        <div class="card-header">
          <div class="card-pills">
            <span class="pill-century">CENTURY {String(g.centuryNum).padStart(2, '0')}</span>
            <span class="pill-era">{g.era}</span>
          </div>
          <span class="card-count">{g.count} LOGS</span>
        </div>

        <h3 class="card-title">
          <a href={`/blog/archive/${g.name}/`}>Days {g.name}</a>
        </h3>

        <p class="card-desc">{g.title}</p>

        <div class="card-meta">
          <span class="meta-date">📅 {g.dateRange}</span>
          <span class="meta-mascot">Mascot: <strong>{g.pokemon}</strong></span>
        </div>

        <div class="card-action">
          <a href={`/blog/archive/${g.name}/`} class="open-century-btn">
            <span>Explore Days {g.name} Timeline</span>
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </article>
    ))}
  </div>

  <section class="archive-quick-links" style="margin-top: 3.5rem; padding-top: 2rem; border-top: 1px solid var(--border, #333);">
    <h2>Other Chronology Views</h2>
    <div style="display: flex; gap: 1rem; flex-wrap: wrap; margin-top: 1rem;">
      <a href="/blog/timeline/" class="archive-nav-btn">Complete Timeline →</a>
      <a href="/blog/milestones/" class="archive-nav-btn">Milestones & Glitches →</a>
      <a href="/blog/month/2026-10/" class="archive-nav-btn">Monthly Calendar →</a>
    </div>
  </section>
</EditorialShell>

<style>
  .breadcrumb-nav {
    font-size: 13px;
    color: #94a3b8;
    display: flex;
    gap: 8px;
    align-items: center;
  }
  .breadcrumb-nav a {
    color: var(--accent, #38bdf8);
    text-decoration: none;
  }

  .century-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 20px;
    margin-top: 1.5rem;
  }

  .century-card {
    background: #090e17;
    border: 1px solid rgba(223, 246, 255, 0.14);
    border-radius: 12px;
    padding: 20px 22px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: all 0.18s ease;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.35);
  }

  .century-card:hover {
    border-color: rgba(247, 208, 44, 0.5);
    background: #0d1522;
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);
  }

  .card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 12px;
  }

  .card-pills {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }

  .pill-century {
    font-size: 10px;
    font-weight: 800;
    color: #f59e0b;
    background: rgba(245, 158, 11, 0.15);
    border: 1px solid rgba(245, 158, 11, 0.35);
    padding: 2px 6px;
    border-radius: 4px;
    letter-spacing: 0.05em;
  }

  .pill-era {
    font-size: 10px;
    font-weight: 700;
    color: #38bdf8;
    background: rgba(56, 189, 248, 0.12);
    border: 1px solid rgba(56, 189, 248, 0.25);
    padding: 2px 6px;
    border-radius: 4px;
  }

  .card-count {
    font-size: 11px;
    font-weight: 800;
    color: #94a3b8;
  }

  .card-title {
    font-size: 20px;
    font-weight: 800;
    margin: 0 0 8px;
    letter-spacing: 0.02em;
  }

  .card-title a {
    color: #ffffff;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .card-title a:hover {
    color: var(--accent, #F7D02C);
  }

  .card-desc {
    font-size: 13px;
    line-height: 1.5;
    color: #cbd5e1;
    margin: 0 0 16px;
  }

  .card-meta {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 12px;
    color: #94a3b8;
    margin-bottom: 16px;
    padding-top: 10px;
    border-top: 1px solid rgba(223, 246, 255, 0.08);
  }

  .meta-mascot strong {
    color: var(--accent, #F7D02C);
  }

  .card-action {
    margin-top: auto;
  }

  .open-century-btn {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 8px 14px;
    background: #111a28;
    border: 1px solid rgba(223, 246, 255, 0.16);
    border-radius: 6px;
    color: #f1f5f9;
    font-size: 12px;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.16s ease;
  }

  .open-century-btn:hover {
    background: #ef4444;
    border-color: #ef4444;
    color: #ffffff;
    transform: translateY(-1px);
  }

  .archive-nav-btn {
    padding: 8px 16px;
    background: #111a28;
    border: 1px solid rgba(223, 246, 255, 0.16);
    border-radius: 6px;
    color: #cbd5e1;
    font-size: 12px;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.16s ease;
  }

  .archive-nav-btn:hover {
    color: #ffffff;
    border-color: #38bdf8;
    background: #17243b;
    transform: translateY(-1px);
  }
</style>
