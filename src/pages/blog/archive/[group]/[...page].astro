---
import EditorialShell from '../../../../components/EditorialShell.astro';
import allPosts from '../../../../data/linkedin-posts.json';

const pokemonEras: Record<string, { era: string; pokemon: string; id: number }> = {
  '1-100': { era: 'Gen I · Kanto', pokemon: 'Pikachu', id: 25 },
  '101-200': { era: 'Gen II · Johto', pokemon: 'Cyndaquil', id: 155 },
  '201-300': { era: 'Gen III · Hoenn', pokemon: 'Torchic', id: 255 },
  '301-400': { era: 'Gen IV · Sinnoh', pokemon: 'Piplup', id: 393 },
  '401-500': { era: 'Gen V · Unova', pokemon: 'Snivy', id: 495 },
  '501-600': { era: 'Gen VI · Kalos', pokemon: 'Froakie', id: 656 },
  '601-700': { era: 'Gen VII · Alola', pokemon: 'Rowlet', id: 722 },
  '701-800': { era: 'Gen VIII · Galar', pokemon: 'Scorbunny', id: 813 },
  '801-900': { era: 'Gen IX · Paldea', pokemon: 'Sprigatito', id: 906 },
  '901-1000': { era: 'Ultra Apex', pokemon: 'Mewtwo', id: 150 },
  '1001-1100': { era: 'Time Origin', pokemon: 'Dialga', id: 483 },
  '1101-1200': { era: 'Systems Core', pokemon: 'Arceus', id: 493 },
  '1201-1300': { era: 'Apex Era', pokemon: 'Koraidon', id: 1007 },
};

export async function getStaticPaths({ paginate }: any) {
  const posts = [...allPosts].sort((a, b) => b.day - a.day);
  
  const groups: Record<string, any[]> = {};
  for (const p of posts) {
    const lower = Math.floor((p.day - 1) / 100) * 100 + 1;
    const upper = lower + 99;
    const gName = `${lower}-${upper}`;
    if (!groups[gName]) groups[gName] = [];
    groups[gName].push(p);
  }

  const allGroups = Object.keys(groups);

  return allGroups.flatMap((gName) => {
    return paginate(groups[gName], {
      params: { group: gName },
      props: { allGroups, groupPosts: groups[gName] },
      pageSize: 150,
    });
  });
}

const { allGroups, groupPosts } = Astro.props as { allGroups: string[]; groupPosts: any[] };
const { group } = Astro.params;

// Sort ascending for chronological tracking, with latest-first default in DOM
const sortedPosts = [...(groupPosts || [])].sort((a: any, b: any) => a.day - b.day);
const totalDays = sortedPosts.length;
const minDay = sortedPosts[0]?.day || 1;
const maxDay = sortedPosts[sortedPosts.length - 1]?.day || 100;
const startDate = sortedPosts[0]?.date || '';
const endDate = sortedPosts[sortedPosts.length - 1]?.date || '';
const eraInfo = (group && pokemonEras[group]) || { era: 'Century Block', pokemon: 'Pikachu', id: 25 };

const pageTitle = `Days ${group} Scroll Timeline | 2,002 Days of Code`;
const pageDescription = `Interactive scroll timeline of Days ${group} (${startDate} to ${endDate}) in Shivam Mahajan's 2,002 Days of Code streak.`;

const currentUrl = new URL(Astro.url.pathname, Astro.site ?? 'https://shivammahajan.com').href;

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': `${currentUrl}#collection`,
      isPartOf: { '@id': 'https://shivammahajan.com/#website' },
      name: `Days ${group} | 2,002 Days of Code`,
      description: pageDescription,
      url: currentUrl
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${currentUrl}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://shivammahajan.com/' },
        { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://shivammahajan.com/blog/' },
        { '@type': 'ListItem', position: 3, name: 'Century Archives', item: 'https://shivammahajan.com/blog/archive/' },
        { '@type': 'ListItem', position: 4, name: `Days ${group}`, item: currentUrl }
      ]
    }
  ]
};
---

<EditorialShell 
  title={pageTitle} 
  description={pageDescription} 
  eyebrow={`Century Archive · ${eraInfo.era}`} 
  heading={`Days ${group}`} 
  intro={`Interactive scroll timeline of ${totalDays} daily logs recorded from Day ${minDay} (${startDate}) to Day ${maxDay} (${endDate}). Select any day from the top rail to inspect.`}
  structuredData={structuredData}
>
  <nav class="breadcrumb-nav" aria-label="Breadcrumbs">
    <a href="/">Home</a> <span>/</span>
    <a href="/blog/">Blog</a> <span>/</span>
    <a href="/blog/archive/">Century Archives</a> <span>/</span>
    <span>Days {group}</span>
  </nav>

  <!-- VIKTOR SCROLL TIMELINE COMPONENT FOR THIS CENTURY'S DAYS -->
  <div class="day-scroll-timeline-root" id="day-scroll-root" data-order="latest" data-active-day={maxDay}>
    <!-- ALL DAYS IN THIS CENTURY PINNED AT THE TOP RAIL -->
    <nav class="sticky-day-rail" id="sticky-day-rail" aria-label={`Days in century ${group}`}>
      <div class="rail-topbar">
        <div class="rail-title-group">
          <span class="rail-status-dot" aria-hidden="true"></span>
          <span class="rail-title">CENTURY DAYS DIRECTORY:</span>
          <span class="rail-active-pill" id="rail-active-pill">Day {maxDay} · {endDate}</span>
        </div>

        <div class="rail-controls">
          <div class="rail-order-switch" role="group" aria-label="Sort direction">
            <button
              type="button"
              class="rail-switch-btn is-active"
              id="day-order-latest-btn"
              data-order="latest"
              aria-pressed="true"
            >
              ⚡ Latest (Day {maxDay} → {minDay})
            </button>
            <button
              type="button"
              class="rail-switch-btn"
              id="day-order-origin-btn"
              data-order="origin"
              aria-pressed="false"
            >
              🌱 Ascending (Day {minDay} → {maxDay})
            </button>
          </div>

          <div class="rail-jumps">
            <button type="button" class="rail-jump-chip" id="jump-first-day">Day {minDay}</button>
            <button type="button" class="rail-jump-chip" id="jump-latest-day">Day {maxDay}</button>
          </div>
        </div>
      </div>

      <!-- Connecting Wire with all days in this century -->
      <div class="rail-viewport" id="rail-viewport">
        <div class="rail-track" id="rail-track">
          <div class="rail-line" aria-hidden="true">
            <div class="rail-progress" id="rail-progress"></div>
          </div>

          {sortedPosts.map((post: any) => (
            <button
              type="button"
              class:list={['rail-day-node', { 'is-active': post.day === maxDay, 'has-egg': !!post.easterEgg, 'has-ms': !!post.milestone }]}
              id={`day-node-${post.day}`}
              data-day={post.day}
              data-date={post.date}
              aria-label={`Jump to Day ${post.day}`}
              title={`Day ${post.day} (${post.date})${post.milestone ? ' - ' + post.milestone : ''}`}
            >
              <div class="node-bullet">
                <span class="bullet-dot"></span>
              </div>
              <span class="node-num">{post.day}</span>
              {post.easterEgg && <span class="node-egg" title="Glitch">??</span>}
            </button>
          ))}
        </div>
      </div>
    </nav>

    <!-- VERTICAL SCROLL STREAM WITH CENTRAL SPINE -->
    <div class="day-stream" id="day-stream">
      <div class="stream-spine" aria-hidden="true">
        <div class="spine-glow"></div>
      </div>

      {sortedPosts.map((post: any) => (
        <section
          class:list={['day-section', { 'is-active-day': post.day === maxDay }]}
          id={`day-sec-${post.day}`}
          data-day={post.day}
          data-date={post.date}
          aria-labelledby={`day-heading-${post.day}`}
        >
          <!-- Watermark Day Numeral (Viktor Scroll Timeline style) -->
          <div class="day-watermark" aria-hidden="true">{post.day}</div>

          <!-- Spine Pokéball Pin -->
          <div class="day-spine-node" aria-hidden="true">
            <div class="day-pin">
              <span class="pin-top"></span>
              <span class="pin-band"><span class="pin-core"></span></span>
              <span class="pin-bottom"></span>
            </div>
          </div>

          <!-- Day Card -->
          <article class:list={['day-card', { 'egg-card': !!post.easterEgg }]}>
            <div class="card-rivet r-tl" aria-hidden="true"></div>
            <div class="card-rivet r-tr" aria-hidden="true"></div>
            <div class="card-rivet r-bl" aria-hidden="true"></div>
            <div class="card-rivet r-br" aria-hidden="true"></div>

            <header class="day-card-header">
              <div class="day-pills">
                <span class="pill-day">DAY {post.day}</span>
                <time class="pill-date" datetime={post.date}>{post.date}</time>
                {post.milestone && <span class="pill-milestone">★ {post.milestone}</span>}
                {post.easterEgg && <span class="pill-egg">?? Glitch</span>}
              </div>

              <h3 class="day-title" id={`day-heading-${post.day}`}>
                <a href={`/blog/day-${post.day}/`}>Day {post.day} Engineering Log ↗</a>
              </h3>
            </header>

            <div class="day-card-body">
              <p class="day-content-snippet">{post.content ? post.content.replace(/[\r\n]+/g, ' ').slice(0, 240) + '…' : 'Daily log update.'}</p>
              {post.easterEgg && (
                <div class="day-egg-box">
                  <strong>Glitch Discovery:</strong> {post.easterEgg}
                </div>
              )}
            </div>

            <footer class="day-card-footer">
              <a href={`/blog/day-${post.day}/`} class="day-read-btn">
                <span>Read Full Day {post.day} Post</span>
                <span aria-hidden="true">→</span>
              </a>
              {post.url && (
                <a href={post.url} target="_blank" rel="noopener noreferrer" class="day-linkedin-link">
                  LinkedIn Post ↗
                </a>
              )}
            </footer>
          </article>
        </section>
      ))}
    </div>
  </div>

  <!-- OTHER CENTURIES NAVIGATION -->
  <section class="other-archives" style="margin-top: 4rem; padding-top: 2rem; border-top: 1px solid var(--border, #333);">
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; margin-bottom: 1rem;">
      <h2 style="margin: 0;">Explore Other Centuries</h2>
      <a href="/blog/archive/" style="color: var(--accent, #F7D02C); font-weight: 800; font-size: 13px;">View All Century Archives Directory →</a>
    </div>
    <div class="group-chips">
      {(allGroups || []).map((gName: string) => (
        <a 
          href={`/blog/archive/${gName}/`} 
          class={`chip ${gName === group ? 'current' : ''}`}
        >
          Days {gName}
        </a>
      ))}
    </div>
  </section>
</EditorialShell>

<style>
  .breadcrumb-nav {
    font-size: 13px;
    color: #94a3b8;
    display: flex;
    gap: 8px;
    align-items: center;
    margin-bottom: 2rem;
  }
  .breadcrumb-nav a {
    color: var(--accent, #38bdf8);
    text-decoration: none;
  }

  /* -------------------------------------------------------------
     STICKY DAY RAIL (ALL DAYS OF CENTURY AT THE TOP)
     ------------------------------------------------------------- */
  .day-scroll-timeline-root {
    --day-red: #ef4444;
    --day-gold: #F7D02C;
    --day-cyan: #38bdf8;
    --day-border: rgba(223, 246, 255, 0.16);
    --day-card-bg: #090e17;
    position: relative;
    width: 100%;
    margin: 20px 0 40px;
    font-family: var(--font-body, "Departure Mono", monospace);
    box-sizing: border-box;
  }

  .sticky-day-rail {
    position: sticky;
    top: 14px;
    z-index: 50;
    width: 100%;
    background: rgba(9, 14, 23, 0.95);
    border: 1px solid var(--day-border);
    border-radius: 14px;
    padding: 12px 16px 14px;
    backdrop-filter: blur(12px) saturate(140%);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.55), inset 0 1px 0 rgba(255, 255, 255, 0.08);
    margin-bottom: 34px;
  }

  .rail-topbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-bottom: 10px;
    border-bottom: 1px solid rgba(223, 246, 255, 0.1);
    margin-bottom: 10px;
  }

  .rail-title-group {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .rail-status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 8px #22c55e;
  }

  .rail-title {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: #94a3b8;
  }

  .rail-active-pill {
    font-size: 12px;
    font-weight: 700;
    color: var(--day-gold);
    background: rgba(247, 208, 44, 0.12);
    border: 1px solid rgba(247, 208, 44, 0.3);
    padding: 2px 8px;
    border-radius: 4px;
  }

  .rail-controls {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .rail-order-switch {
    display: inline-flex;
    background: #050811;
    border: 1px solid var(--day-border);
    border-radius: 8px;
    padding: 2px;
    gap: 2px;
  }

  .rail-switch-btn {
    padding: 4px 10px;
    font-size: 11px;
    font-weight: 700;
    color: #94a3b8;
    background: transparent;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    font-family: inherit;
    transition: all 0.15s ease;
  }

  .rail-switch-btn:hover {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.06);
  }

  .rail-switch-btn.is-active {
    color: #050811;
    background: var(--day-gold);
    box-shadow: 0 2px 8px rgba(247, 208, 44, 0.35);
  }

  .rail-jumps {
    display: flex;
    gap: 6px;
  }

  .rail-jump-chip {
    padding: 4px 8px;
    font-size: 11px;
    font-weight: 700;
    color: #cbd5e1;
    background: #111a28;
    border: 1px solid var(--day-border);
    border-radius: 6px;
    cursor: pointer;
    font-family: inherit;
    transition: all 0.15s ease;
  }

  .rail-jump-chip:hover {
    color: #ffffff;
    border-color: var(--day-cyan);
    background: #162438;
  }

  /* Rail Viewport & Track */
  .rail-viewport {
    width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
    scrollbar-color: rgba(223, 246, 255, 0.2) transparent;
    padding: 4px 0 2px;
  }

  .rail-viewport::-webkit-scrollbar {
    height: 4px;
  }

  .rail-viewport::-webkit-scrollbar-thumb {
    background: rgba(223, 246, 255, 0.25);
    border-radius: 2px;
  }

  .rail-track {
    display: flex;
    align-items: center;
    position: relative;
    min-width: max-content;
    padding: 6px 8px;
    gap: 8px;
  }

  .rail-line {
    position: absolute;
    top: 14px;
    left: 14px;
    right: 14px;
    height: 3px;
    background: rgba(223, 246, 255, 0.15);
    z-index: 1;
    border-radius: 2px;
  }

  .rail-progress {
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, #ef4444, var(--day-gold));
    border-radius: 2px;
    transition: width 0.2s ease;
  }

  .rail-day-node {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    background: transparent;
    border: none;
    padding: 0 4px;
    cursor: pointer;
    font-family: inherit;
    transition: transform 0.16s ease;
    min-width: 38px;
  }

  .rail-day-node:hover {
    transform: translateY(-2px);
  }

  .node-bullet {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: #0f1726;
    border: 2px solid #64748b;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 4px;
    transition: all 0.18s ease;
  }

  .bullet-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #64748b;
  }

  .node-num {
    font-size: 11px;
    font-weight: 700;
    color: #94a3b8;
    white-space: nowrap;
  }

  .node-egg {
    position: absolute;
    top: -6px;
    right: 0;
    font-size: 9px;
    color: #f59e0b;
    font-weight: 800;
  }

  .rail-day-node.is-active .node-bullet {
    border-color: var(--day-gold);
    background: #090e17;
    box-shadow: 0 0 8px rgba(247, 208, 44, 0.6);
    transform: scale(1.2);
  }

  .rail-day-node.is-active .bullet-dot {
    background: var(--day-gold);
  }

  .rail-day-node.is-active .node-num {
    color: #ffffff;
    font-weight: 800;
  }

  /* -------------------------------------------------------------
     VERTICAL DAY STREAM (VIKTOR SCROLL TIMELINE)
     ------------------------------------------------------------- */
  .day-stream {
    position: relative;
    padding-left: 36px;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .stream-spine {
    position: absolute;
    top: 20px;
    bottom: 20px;
    left: 17px;
    width: 3px;
    background: rgba(223, 246, 255, 0.15);
    z-index: 1;
    border-radius: 2px;
  }

  .spine-glow {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, #ef4444 0%, var(--day-gold) 50%, var(--day-cyan) 100%);
    opacity: 0.7;
  }

  .day-section {
    position: relative;
    scroll-margin-top: 140px;
  }

  .day-watermark {
    position: absolute;
    top: -22px;
    right: 18px;
    font-size: 72px;
    font-weight: 900;
    line-height: 1;
    color: rgba(223, 246, 255, 0.04);
    letter-spacing: -0.04em;
    pointer-events: none;
    user-select: none;
    z-index: 2;
  }

  .day-section.is-active-day .day-watermark {
    color: rgba(247, 208, 44, 0.09);
  }

  .day-spine-node {
    position: absolute;
    top: 24px;
    left: -36px;
    width: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 5;
  }

  .day-pin {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: #090e17;
    border: 2px solid #475569;
    position: relative;
    overflow: hidden;
    box-shadow: 0 0 10px rgba(0, 0, 0, 0.6);
    transition: all 0.2s ease;
  }

  .day-section.is-active-day .day-pin {
    border-color: var(--day-gold);
    box-shadow: 0 0 12px rgba(247, 208, 44, 0.7);
    transform: scale(1.15);
  }

  .pin-top {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 50%;
    background: #ef4444;
  }

  .pin-bottom {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 50%;
    background: #e2e8f0;
  }

  .pin-band {
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    height: 3px;
    transform: translateY(-50%);
    background: #090e17;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .pin-core {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #ffffff;
  }

  .day-card {
    position: relative;
    background: var(--day-card-bg);
    border: 2px solid var(--day-border);
    border-radius: 14px;
    padding: 22px 24px;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.4);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .day-section.is-active-day .day-card {
    border-color: rgba(247, 208, 44, 0.45);
    box-shadow: 0 8px 28px rgba(247, 208, 44, 0.16);
  }

  .day-card.egg-card {
    border-left: 4px solid #f59e0b;
  }

  .card-rivet {
    position: absolute;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #475569;
    box-shadow: inset 0 1px 0 rgba(0, 0, 0, 0.6);
    z-index: 4;
  }

  .r-tl { top: 8px; left: 8px; }
  .r-tr { top: 8px; right: 8px; }
  .r-bl { bottom: 8px; left: 8px; }
  .r-br { bottom: 8px; right: 8px; }

  .day-card-header {
    border-bottom: 1px solid rgba(223, 246, 255, 0.08);
    padding-bottom: 12px;
    margin-bottom: 14px;
  }

  .day-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-items: center;
    margin-bottom: 8px;
  }

  .pill-day {
    font-size: 11px;
    font-weight: 800;
    color: #050811;
    background: var(--day-gold);
    padding: 2px 7px;
    border-radius: 4px;
  }

  .pill-date {
    font-size: 11px;
    font-weight: 700;
    color: #94a3b8;
    background: #111a28;
    border: 1px solid rgba(223, 246, 255, 0.1);
    padding: 2px 7px;
    border-radius: 4px;
  }

  .pill-milestone {
    font-size: 10px;
    font-weight: 800;
    color: #34d399;
    background: rgba(16, 185, 129, 0.15);
    border: 1px solid rgba(16, 185, 129, 0.35);
    padding: 2px 7px;
    border-radius: 4px;
  }

  .pill-egg {
    font-size: 10px;
    font-weight: 800;
    color: #fbbf24;
    background: rgba(245, 158, 11, 0.15);
    border: 1px solid rgba(245, 158, 11, 0.35);
    padding: 2px 7px;
    border-radius: 4px;
  }

  .day-title {
    font-size: 18px;
    font-weight: 800;
    margin: 4px 0 0;
  }

  .day-title a {
    color: #ffffff;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .day-title a:hover {
    color: var(--day-gold);
  }

  .day-content-snippet {
    font-size: 13px;
    line-height: 1.6;
    color: #cbd5e1;
    margin: 0 0 14px;
  }

  .day-egg-box {
    margin: 10px 0 14px;
    padding: 8px 12px;
    background: rgba(245, 158, 11, 0.12);
    border-left: 3px solid #f59e0b;
    border-radius: 4px;
    font-size: 12px;
    color: #fde68a;
  }

  .day-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-top: 12px;
    border-top: 1px solid rgba(223, 246, 255, 0.08);
  }

  .day-read-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    background: #ef4444;
    color: #ffffff;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.04em;
    border-radius: 6px;
    text-decoration: none;
    transition: all 0.16s ease;
  }

  .day-read-btn:hover {
    background: #dc2626;
    transform: translateY(-1px);
  }

  .day-linkedin-link {
    font-size: 11px;
    font-weight: 700;
    color: #94a3b8;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .day-linkedin-link:hover {
    color: var(--day-cyan);
    text-decoration: underline;
  }

  .group-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 10px;
  }

  .chip {
    padding: 6px 12px;
    background: #111a28;
    border: 1px solid rgba(223, 246, 255, 0.16);
    border-radius: 6px;
    color: #cbd5e1;
    font-size: 12px;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.16s ease;
  }

  .chip:hover {
    color: #ffffff;
    border-color: var(--day-cyan);
    background: #17243b;
    transform: translateY(-1px);
  }

  .chip.current {
    background: var(--day-gold);
    color: #050811;
    border-color: var(--day-gold);
    box-shadow: 0 2px 8px rgba(247, 208, 44, 0.35);
  }

  @media (max-width: 760px) {
    .sticky-day-rail {
      padding: 10px 12px;
    }

    .rail-topbar {
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
    }

    .rail-controls {
      width: 100%;
      justify-content: space-between;
    }

    .day-stream {
      padding-left: 22px;
      gap: 26px;
    }

    .stream-spine {
      left: 10px;
    }

    .day-spine-node {
      left: -22px;
      width: 22px;
    }

    .day-pin {
      width: 16px;
      height: 16px;
    }

    .day-card {
      padding: 16px 14px;
    }

    .day-watermark {
      font-size: 42px;
      top: -14px;
      right: 10px;
    }

    .day-title {
      font-size: 16px;
    }
  }
</style>

<script>
  function initDayScrollTimeline() {
    const root = document.getElementById('day-scroll-root');
    const rail = document.getElementById('sticky-day-rail');
    const stream = document.getElementById('day-stream');
    const track = document.getElementById('rail-track');
    const viewport = document.getElementById('rail-viewport');
    const progress = document.getElementById('rail-progress');
    const pill = document.getElementById('rail-active-pill');

    if (!root || !rail || !stream || !track) return;

    const rootEl = root;
    const streamEl = stream;
    const trackEl = track;
    const progressEl = progress;
    const pillEl = pill;
    const viewportEl = viewport;

    const nodes = Array.from(trackEl.querySelectorAll<HTMLButtonElement>('.rail-day-node'));
    const sections = Array.from(streamEl.querySelectorAll<HTMLElement>('.day-section'));

    const orderLatestBtn = document.getElementById('day-order-latest-btn');
    const orderOriginBtn = document.getElementById('day-order-origin-btn');
    const jumpFirstBtn = document.getElementById('jump-first-day');
    const jumpLatestBtn = document.getElementById('jump-latest-day');

    let activeDay = parseInt(rootEl.getAttribute('data-active-day') || '0', 10);

    function setActiveDay(day: number, scrollNav = true) {
      activeDay = day;
      const targetSection = sections.find(s => parseInt(s.getAttribute('data-day') || '0', 10) === day);
      const targetNode = nodes.find(n => parseInt(n.getAttribute('data-day') || '0', 10) === day);

      // Node highlight
      nodes.forEach(n => {
        const isAct = parseInt(n.getAttribute('data-day') || '0', 10) === day;
        n.classList.toggle('is-active', isAct);
        n.setAttribute('aria-pressed', isAct ? 'true' : 'false');
      });

      // Section highlight
      sections.forEach(s => {
        const isAct = parseInt(s.getAttribute('data-day') || '0', 10) === day;
        s.classList.toggle('is-active-day', isAct);
      });

      // Update pill text
      if (pillEl && targetNode) {
        const dDate = targetNode.getAttribute('data-date') || '';
        pillEl.textContent = `Day ${day} · ${dDate}`;
      }

      // Progress bar
      if (progressEl && targetNode) {
        const trackRect = trackEl.getBoundingClientRect();
        const nodeRect = targetNode.getBoundingClientRect();
        const pct = Math.max(0, Math.min(100, ((nodeRect.left - trackRect.left + (nodeRect.width / 2)) / trackRect.width) * 100));
        progressEl.style.width = `${pct}%`;
      }

      // Auto-center in viewport
      if (scrollNav && targetNode && viewportEl) {
        const targetLeft = targetNode.offsetLeft - (viewportEl.clientWidth / 2) + (targetNode.clientWidth / 2);
        viewportEl.scrollTo({ left: targetLeft, behavior: 'smooth' });
      }
    }

    function scrollToDay(day: number) {
      const sec = document.getElementById(`day-sec-${day}`);
      if (sec) {
        sec.scrollIntoView({ behavior: 'smooth', block: 'start' });
        setActiveDay(day, true);
      }
    }

    nodes.forEach(n => {
      n.addEventListener('click', () => {
        const day = parseInt(n.getAttribute('data-day') || '0', 10);
        scrollToDay(day);
      });
    });

    if (jumpFirstBtn) {
      jumpFirstBtn.addEventListener('click', () => {
        const firstDay = parseInt(sections[0]?.getAttribute('data-day') || '0', 10);
        scrollToDay(firstDay);
      });
    }

    if (jumpLatestBtn) {
      jumpLatestBtn.addEventListener('click', () => {
        const lastDay = parseInt(sections[sections.length - 1]?.getAttribute('data-day') || '0', 10);
        scrollToDay(lastDay);
      });
    }

    function setOrder(order: 'latest' | 'origin') {
      rootEl.setAttribute('data-order', order);

      if (order === 'latest') {
        orderLatestBtn?.classList.add('is-active');
        orderLatestBtn?.setAttribute('aria-pressed', 'true');
        orderOriginBtn?.classList.remove('is-active');
        orderOriginBtn?.setAttribute('aria-pressed', 'false');

        // Reverse sections: highest day first
        const sortedSec = [...sections].sort((a, b) => {
          return parseInt(b.getAttribute('data-day') || '0', 10) - parseInt(a.getAttribute('data-day') || '0', 10);
        });
        sortedSec.forEach(s => streamEl.appendChild(s));

        // Reverse top rail nodes: highest day first
        const sortedNodes = [...nodes].sort((a, b) => {
          return parseInt(b.getAttribute('data-day') || '0', 10) - parseInt(a.getAttribute('data-day') || '0', 10);
        });
        sortedNodes.forEach(n => trackEl.appendChild(n));

        const maxD = parseInt(sortedSec[0]?.getAttribute('data-day') || '0', 10);
        setActiveDay(maxD, true);
      } else {
        orderOriginBtn?.classList.add('is-active');
        orderOriginBtn?.setAttribute('aria-pressed', 'true');
        orderLatestBtn?.classList.remove('is-active');
        orderLatestBtn?.setAttribute('aria-pressed', 'false');

        // Ascending sections: lowest day first
        const sortedSec = [...sections].sort((a, b) => {
          return parseInt(a.getAttribute('data-day') || '0', 10) - parseInt(b.getAttribute('data-day') || '0', 10);
        });
        sortedSec.forEach(s => streamEl.appendChild(s));

        // Ascending nodes: lowest day first
        const sortedNodes = [...nodes].sort((a, b) => {
          return parseInt(a.getAttribute('data-day') || '0', 10) - parseInt(b.getAttribute('data-day') || '0', 10);
        });
        sortedNodes.forEach(n => trackEl.appendChild(n));

        const minD = parseInt(sortedSec[0]?.getAttribute('data-day') || '0', 10);
        setActiveDay(minD, true);
      }
    }

    orderLatestBtn?.addEventListener('click', () => setOrder('latest'));
    orderOriginBtn?.addEventListener('click', () => setOrder('origin'));

    // IntersectionObserver scroll-spy
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const day = parseInt(entry.target.getAttribute('data-day') || '0', 10);
          setActiveDay(day, true);
        }
      });
    }, {
      rootMargin: '-20% 0px -55% 0px',
      threshold: 0.1
    });

    sections.forEach(s => observer.observe(s));

    // Initial order: latest first
    setOrder('latest');
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initDayScrollTimeline);
  } else {
    initDayScrollTimeline();
  }
  document.addEventListener('astro:page-load', initDayScrollTimeline);
</script>
