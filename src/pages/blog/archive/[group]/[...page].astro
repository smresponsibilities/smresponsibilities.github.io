---
import EditorialShell from '../../../../components/EditorialShell.astro';
import allPosts from '../../../../data/linkedin-posts.json';
import PokemonCarouselTimeline from '../../../../components/PokemonCarouselTimeline.astro';

const pokemonEras: Record<string, { era: string; pokemon: string; id: number }> = {
  '1-100': { era: 'Gen I · Kanto', pokemon: 'Pikachu', id: 25 },
  '101-200': { era: 'Gen II · Johto', pokemon: 'Cyndaquil', id: 155 },
  '201-300': { era: 'Gen III · Hoenn', pokemon: 'Torchic', id: 255 },
  '301-400': { era: 'Gen IV · Sinnoh', pokemon: 'Piplup', id: 393 },
  '401-500': { era: 'Gen V · Unova', pokemon: 'Snivy', id: 495 },
  '501-600': { era: 'Gen VI · Kalos', pokemon: 'Froakie', id: 656 },
  '601-700': { era: 'Gen VII · Alola', pokemon: 'Rowlet', id: 722 },
  '701-800': { era: 'Gen VIII · Galar', pokemon: 'Scorbunny', id: 813 },
  '801-900': { era: 'Gen IX · Paldea', pokemon: 'Sprigatito', id: 906 },
  '901-1000': { era: 'Ultra Apex', pokemon: 'Mewtwo', id: 150 },
  '1001-1100': { era: 'Time Origin', pokemon: 'Dialga', id: 483 },
  '1101-1200': { era: 'Systems Core', pokemon: 'Arceus', id: 493 },
  '1201-1300': { era: 'Apex Era', pokemon: 'Koraidon', id: 1007 },
};

export async function getStaticPaths({ paginate }: any) {
  const posts = [...allPosts].sort((a, b) => b.day - a.day);
  
  const groups: Record<string, any[]> = {};
  for (const p of posts) {
    const lower = Math.floor((p.day - 1) / 100) * 100 + 1;
    const upper = lower + 99;
    const gName = `${lower}-${upper}`;
    if (!groups[gName]) groups[gName] = [];
    groups[gName].push(p);
  }

  const allGroups = Object.keys(groups);

  return allGroups.flatMap((gName) => {
    return paginate(groups[gName], {
      params: { group: gName },
      props: { allGroups, groupPosts: groups[gName] },
      pageSize: 150,
    });
  });
}

const { allGroups, groupPosts } = Astro.props as { allGroups: string[]; groupPosts: any[] };
const { group } = Astro.params;

// Sort ascending for chronological tracking, with latest-first default in DOM
const sortedPosts = [...(groupPosts || [])].sort((a: any, b: any) => a.day - b.day);
const totalDays = sortedPosts.length;
const minDay = sortedPosts[0]?.day || 1;
const maxDay = sortedPosts[sortedPosts.length - 1]?.day || 100;
const startDate = sortedPosts[0]?.date || '';
const endDate = sortedPosts[sortedPosts.length - 1]?.date || '';
const eraInfo = (group && pokemonEras[group]) || { era: 'Century Block', pokemon: 'Pikachu', id: 25 };

const pageTitle = `Days ${group} Archive | 2,002 Days of Code`;
const pageDescription = `Daily engineering logs for Days ${group} (${startDate} to ${endDate}) in Shivam Mahajan's 2,002 Days of Code streak.`;

const currentUrl = new URL(Astro.url.pathname, Astro.site ?? 'https://shivammahajan.com').href;

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': `${currentUrl}#collection`,
      isPartOf: { '@id': 'https://shivammahajan.com/#website' },
      name: `Days ${group} | 2,002 Days of Code`,
      description: pageDescription,
      url: currentUrl
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${currentUrl}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://shivammahajan.com/' },
        { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://shivammahajan.com/blog/' },
        { '@type': 'ListItem', position: 3, name: 'Century Archives', item: 'https://shivammahajan.com/blog/archive/' },
        { '@type': 'ListItem', position: 4, name: `Days ${group}`, item: currentUrl }
      ]
    }
  ]
};
const chapterIndex = Math.floor((minDay - 1) / 100);
const chapterGroups = [...allGroups].sort((a,b)=>parseInt(a)-parseInt(b));
let synCounter = 0;
const synonyms = ['challenge', 'exercise', 'task', 'solution'];
const excerpt = (content: string) => String(content || '').replace(/https?:\/\/\S+/g,'').replace(/#[\w]+/g,'').replace(/solved leetcode\s*(\d+)/gi, 'Solved #$1').replace(/leetcode/gi, () => synonyms[(synCounter++) % synonyms.length]).replace(/["“”]+/g,'').replace(/\s+/g,' ').replace(/^of\s+/i,'').trim().slice(0,200);
---

<EditorialShell title={pageTitle} description={pageDescription} eyebrow={`Century Archive · ${eraInfo.era}`} heading={`Days ${group}`} intro={`${totalDays} daily logs from ${startDate} to ${endDate}. Explore the chapter, find a day, or continue to a full entry.`} image="/peony-gold-1200x630.png" imageAlt="Shivam Mahajan LinkedIn profile photo - antique gold peony" structuredData={structuredData}>
  <nav class="breadcrumb-nav" aria-label="Breadcrumbs"><a href="/">Home</a><span>/</span><a href="/blog/">Blog</a><span>/</span><a href="/blog/archive/">Archive</a><span>/</span><span>Days {group}</span></nav>
  <PokemonCarouselTimeline layout="grid" compact chapterIndex={chapterIndex} />
  <section class="daily-archive" id="daily-logs" aria-labelledby="daily-heading" data-daily-archive>
    <div class="daily-heading"><h2 id="daily-heading">Inside this chapter</h2><label>Chapter <select id="archive-chapter" aria-label="Switch chapter">{chapterGroups.map(item=><option value={`/blog/archive/${item}/`} selected={item===group}>Days {item}</option>)}</select></label></div>
    <div class="daily-tools"><label class="daily-search-label">Find a day or topic<input id="archive-search" type="search" placeholder="Day number, algorithm, topic…" /></label><label>Order<select id="archive-order"><option value="latest">Latest first</option><option value="oldest">Oldest first</option></select></label><form id="archive-jump"><label>Jump to day<input id="archive-day" type="number" min={minDay} max={maxDay} placeholder={String(minDay)} required /></label><button type="submit">Go →</button></form></div>
    <p class="daily-count" role="status" id="archive-count">{totalDays} logs</p>
    <div class="daily-grid" id="archive-days">{[...sortedPosts].reverse().map((post,index)=><article class="daily-log-card" id={`day-sec-${post.day}${sortedPosts.filter(item=>item.day===post.day).length>1?`-${index}`:''}`} data-day={post.day} data-search={`${post.day} ${post.date} ${post.content} ${post.milestone||''}`.toLowerCase()}><p class="daily-date">{post.date}</p><h3><a href={`/blog/day-${post.day}/`}>Day {post.day} <span aria-hidden="true">↗</span></a></h3>{post.milestone && <p class="daily-milestone">{post.milestone}</p>}<p class="daily-excerpt">{excerpt(post.content)}</p><a class="daily-read" href={`/blog/day-${post.day}/`}>Day {post.day} log →</a></article>)}</div>
    <p id="archive-empty" hidden>No logs match. Try a day number or another topic.</p>
  </section>
  <nav class="chapter-links" aria-label="Other archive chapters">{chapterGroups.map(item=><a href={`/blog/archive/${item}/`} aria-current={item===group?'page':undefined}>Days {item}</a>)}</nav>
</EditorialShell>
<style>
.daily-archive{scroll-margin-top:90px}.daily-heading{display:flex;align-items:center;justify-content:space-between;gap:18px;flex-wrap:wrap}.daily-heading h2{margin:0}.daily-tools{display:flex;align-items:end;gap:14px;flex-wrap:wrap;margin-top:24px}.daily-tools label,.daily-heading label{display:grid;gap:8px;font-size:12px;color:var(--dim)}.daily-search-label{flex:1;min-width:190px}.daily-tools input,.daily-tools select,.daily-heading select{min-height:44px;border:1px solid var(--border);border-radius:4px;background:var(--time-deep,var(--panel));color:var(--ink);padding:10px 12px;max-width:100%;font:14px Arial,sans-serif}.daily-tools form{display:flex;gap:8px;align-items:end}.daily-tools input[type=number]{width:95px}.daily-tools button{min-height:44px;padding:10px 14px;color:var(--ink);background:var(--time-panel,var(--panel));border:1px solid var(--time-accent,var(--accent));border-radius:4px;cursor:pointer}.daily-count{font:12px Arial,sans-serif;color:var(--dim);margin:20px 0}.daily-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.daily-log-card{padding:28px;border:1px solid var(--border);background:var(--panel);border-radius:12px;scroll-margin-top:100px}.daily-log-card[hidden],#archive-empty[hidden]{display:none!important}.daily-date{font:12px Arial,sans-serif;color:var(--time-soft,var(--dim));margin:0 0 12px}.daily-log-card h3{font-size:24px;margin:0 0 15px}.daily-log-card h3 a{display:flex;justify-content:space-between;color:var(--ink);text-decoration:none;gap:16px}.daily-excerpt{font:14px/1.8 Arial,sans-serif;color:var(--ink);overflow-wrap:anywhere}.daily-milestone{font:12px/1.7 var(--font-body);color:var(--time-accent,var(--accent))}.daily-read{display:inline-block;margin-top:10px;font:12px Arial,sans-serif;color:var(--time-accent,var(--accent));text-underline-offset:4px}.chapter-links{display:flex;flex-wrap:wrap;gap:10px;margin-top:26px}.chapter-links a{font:12px Arial,sans-serif;padding:10px 12px;border:1px solid var(--border);color:var(--ink);border-radius:4px;text-decoration:none}.chapter-links a[aria-current=page]{border-color:var(--time-accent,var(--accent));color:var(--time-accent,var(--accent))}
@media(max-width:650px){.daily-grid{grid-template-columns:1fr}.daily-tools{align-items:stretch}.daily-search-label{flex-basis:100%}.daily-heading{align-items:flex-start}.daily-log-card h3{font-size:22px}}
</style>
<script>
function initDailyArchive() {
  const root=document.querySelector<HTMLElement>('[data-daily-archive]');
  if(!root||root.dataset.ready) return;root.dataset.ready='true';
  const search=root.querySelector<HTMLInputElement>('#archive-search')!;
  const container=root.querySelector<HTMLElement>('#archive-days')!;
  const cards=Array.from(root.querySelectorAll<HTMLElement>('.daily-log-card'));
  const update=()=>{let count=0;const query=search.value.trim().toLowerCase().replace(/^day\s+/, '');cards.forEach(card=>{card.hidden=!card.dataset.search!.includes(query);if(!card.hidden)count++;});root.querySelector('#archive-count')!.textContent=`${count} of ${cards.length} logs`; (root.querySelector('#archive-empty') as HTMLElement).hidden=count!==0;};
  search.addEventListener('input',update);
  root.querySelector<HTMLSelectElement>('#archive-order')!.addEventListener('change',event=>{const ascending=(event.target as HTMLSelectElement).value==='oldest';container.append(...[...cards].sort((a,b)=>(Number(a.dataset.day)-Number(b.dataset.day))*(ascending?1:-1)));});
  root.querySelector<HTMLSelectElement>('#archive-chapter')!.addEventListener('change',event=>{location.href=(event.target as HTMLSelectElement).value;});
  root.querySelector('#archive-jump')!.addEventListener('submit',event=>{event.preventDefault();const day=(root.querySelector('#archive-day') as HTMLInputElement).value;const card=cards.find(card=>card.dataset.day===day);if(!card)return;search.value='';update();card.scrollIntoView({behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'instant':'smooth',block:'start'});const link=card.querySelector<HTMLAnchorElement>('h3 a');link?.focus({preventScroll:true});});
}
initDailyArchive();document.addEventListener('astro:page-load',initDailyArchive);
</script>
