---
import Base from "../../layouts/Base.astro";
import PokemonTimeline from "../../components/PokemonTimeline.astro";

const allPosts = await import("../../data/linkedin-posts.json");
const posts = allPosts.default;

const initialCount = 50;
const initialPosts = posts.slice(0, initialCount);
const remainingPosts = posts.slice(initialCount).map(post => ({
  day: post.day,
  date: post.date,
  month: post.date && post.date.length >= 7 ? post.date.slice(0, 7) : '',
  snippet: post.content ? post.content.replace(/#[\w]+/g, '').replace(/\s+/g, ' ').slice(0, 150) + '...' : '',
  easterEgg: post.easterEgg || null
}));

const currentUrl = new URL(Astro.url.pathname, Astro.site ?? 'https://shivammahajan.com').href;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': `${currentUrl}#collection`,
      isPartOf: { '@id': 'https://shivammahajan.com/#website' },
      url: currentUrl,
      name: 'Days of Code Timeline | Shivam Mahajan',
      description: "Explore the complete interactive timeline of Shivam Mahajan's 2,002 Days of Code challenge, tracking daily engineering progress, LeetCode, and milestones."
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${currentUrl}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://shivammahajan.com/' },
        { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://shivammahajan.com/blog/' },
        { '@type': 'ListItem', position: 3, name: 'Timeline', item: currentUrl }
      ]
    }
  ]
};
---

<Base title="Days of Code Timeline | Shivam Mahajan" description="Explore the complete interactive timeline of Shivam Mahajan's 2,002 Days of Code challenge, tracking daily engineering progress, LeetCode, and milestones." image="/peony-gold-1200x630.png" imageAlt="Shivam Mahajan LinkedIn profile photo - antique gold peony" structuredData={structuredData}>
  <main class="timeline-container">
    <header class="timeline-header">
      <h1>Days of Code. One chapter at a time.</h1>
      <p>A journey through algorithms, projects and systems. Explore each hundred-day chapter, or look up an individual day.</p>
      <div style="display: flex; gap: 1rem; flex-wrap: wrap; margin-top: 1rem;">
        <a href="/blog/" class="back-link">← Back to Blog</a>
        <a href="/blog/archive/" class="back-link">Century Archives Hub →</a>
        <a href="/blog/milestones/" class="back-link">Milestones →</a>
      </div>

      <!-- Timeline View Mode Switcher -->
      <div class="timeline-view-modes" role="tablist" aria-label="Timeline navigation views">
        <button
          type="button"
          class="mode-btn is-active"
          id="btn-view-centuries"
          role="tab"
          aria-selected="true"
          aria-controls="view-panel-centuries"
        >

          <span>Chapter journey</span>
        </button>
        <button
          type="button"
          class="mode-btn"
          id="btn-view-daily"
          role="tab"
          aria-selected="false"
          aria-controls="view-panel-daily"
        >

          <span>Day-by-Day Feed ({posts.length} Days)</span>
        </button>
      </div>
    </header>

    <!-- Century Chapters Panel (Scroll Timeline with All Centuries at Top) -->
    <div id="view-panel-centuries" class="timeline-view-panel" role="tabpanel" aria-labelledby="btn-view-centuries">
      <PokemonTimeline />
    </div>

    <!-- Day-by-Day Feed Panel -->
    <div id="view-panel-daily" class="timeline-view-panel" role="tabpanel" aria-labelledby="btn-view-daily" hidden>
      <div class="timeline-filter-bar">
        <input
          type="search"
          id="timeline-search"
          placeholder="Filter timeline by LeetCode question (e.g. 'Two Sum', '1541') or day..."
          aria-label="Filter timeline by LeetCode question or day"
        />
        <span id="timeline-filter-count" class="timeline-filter-count">Showing {initialPosts.length} of {posts.length} days</span>
      </div>

      <div class="timeline-scroll">
        <div class="timeline" id="timeline-list">
          {initialPosts.map(post => (
            <div class={`timeline-item ${post.easterEgg ? "has-egg" : ""}`} id={`day-${post.day}`}>
              <div class="timeline-marker"></div>
              <details class="timeline-content">
                <summary>
                  <span class="timeline-date">
                    {post.date && post.date.length >= 7 ? (
                      <a href={`/blog/month/${post.date.slice(0, 7)}/`}>{post.date}</a>
                    ) : post.date}
                  </span>
                  <h3>Day {post.day}</h3>
                  {post.easterEgg && <span class="egg-badge">?? Glitch</span>}
                </summary>
                <div class="expanded">
                  <p class="post-text">{post.content.replace(/#[\w]+/g, '').replace(/\s+/g, ' ').slice(0, 150)}...</p>
                  <a href={`/blog/day-${post.day}/`} class="read-more">Read full page →</a>
                  {post.easterEgg && <p class="egg">?? {post.easterEgg}</p>}
                </div>
              </details>
            </div>
          ))}
        </div>
        {remainingPosts.length > 0 && (
          <div id="timeline-load-more" style="text-align: center; padding: 1.5rem 0;">
            <button type="button" id="btn-load-all-posts" class="load-more-btn">
              Load all {posts.length} days ({remainingPosts.length} more)
            </button>
          </div>
        )}
      </div>
      <script id="timeline-remaining-data" type="application/json" set:html={JSON.stringify(remainingPosts)}></script>
    </div>
  </main>
  <footer class="site-footer">Pokémon © Nintendo / Creatures / GAME FREAK · Tested by my friends.</footer>
</Base>

<style>
  .site-footer {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 32px 20px;
    background: var(--time-deep, #08101a);
    border-top: 1px solid var(--time-accent, var(--border));
    box-shadow: inset 0 3px var(--time-accent, #ffd75e);
    color: #fff;
    font-size: 13px;
    font-family: var(--font-display, monospace);
    text-align: center;
  }
  .timeline-container {
    max-width: 1080px;
    margin: 0 auto;
    padding: 2rem 1rem;
  }
  .timeline-header {
    margin-bottom: 2rem;
  }
  .back-link {
    display: inline-block;
    color: var(--color-primary, #38bdf8);
    text-decoration: none;
    font-size: 13px;
    font-weight: 700;
  }
  .back-link:hover {
    text-decoration: underline;
  }

  /* View Mode Switcher */
  .timeline-view-modes {
    display: inline-flex;
    margin-top: 1.5rem;
    background: #090e17;
    border: 1px solid rgba(223, 246, 255, 0.16);
    border-radius: 10px;
    padding: 4px;
    gap: 6px;
    flex-wrap: wrap;
  }
  .mode-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    font-size: 13px;
    font-weight: 800;
    color: #94a3b8;
    background: transparent;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    font-family: inherit;
    transition: all 0.16s ease;
  }
  .mode-btn:hover {
    color: #f1f5f9;
    background: rgba(255, 255, 255, 0.06);
  }
  .mode-btn.is-active {
    color: #050811;
    background: #F7D02C;
    box-shadow: 0 2px 10px rgba(247, 208, 44, 0.35);
  }
  .mode-icon {
    font-size: 14px;
  }
  .timeline-view-panel[hidden] {
    display: none !important;
  }
  .timeline-scroll {
    height: 70vh;
    overflow-y: auto;
    padding-right: 1rem;
    border: 1px solid #eee;
    border-radius: 8px;
    background: #fafafa;
    padding: 2rem;
  }
  .timeline {
    position: relative;
    padding-left: 2rem;
  }
  .timeline::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: 7px;
    width: 2px;
    background: #ccc;
  }
  .timeline-item {
    position: relative;
    margin-bottom: 1.5rem;
  }
  .timeline-marker {
    position: absolute;
    left: -2rem;
    top: 0.25rem;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: #ccc;
    border: 3px solid #fafafa;
  }
  .timeline-item.has-egg .timeline-marker {
    background: #ffaa00;
  }
  .timeline-content h3 {
    margin: 0 0 0.25rem 0;
    font-size: 1.1rem;
  }
  .timeline-content a {
    color: inherit;
    text-decoration: none;
  }
  .timeline-content a:hover {
    text-decoration: underline;
  }
  .timeline-date {
    font-size: 0.85rem;
    color: #666;
    display: block;
    margin-bottom: 0.25rem;
  }
  .egg {
    margin: 0.5rem 0 0 0;
    padding: 0.75rem;
    background: #fff3cd;
    color: #856404;
    border-left: 4px solid #ffaa00;
    border-radius: 4px;
    font-size: 0.9rem;
    font-weight: 500;
  }

  .timeline-content summary { cursor: pointer; list-style: none; }
  .timeline-content summary::-webkit-details-marker { display: none; }
  .timeline-content summary:hover { opacity: 0.8; }
  .timeline-content h3 { display: inline-block; margin: 0 10px 0 0; }
  .egg-badge { background: #ffaa00; color: #fff; padding: 2px 6px; border-radius: 4px; font-size: 0.8rem; font-weight: bold; }
  .timeline-filter-bar {
    margin-top: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  #timeline-search {
    width: 100%;
    padding: 10px 14px;
    font-size: 1rem;
    border: 2px solid var(--accent, #333);
    border-radius: 4px;
    background: var(--panel, #fff);
    color: var(--ink, #000);
    outline: none;
  }
  #timeline-search:focus {
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent, #0056b3) 25%, transparent);
  }
  .timeline-filter-count {
    font-size: 0.85rem;
    color: var(--dim, #666);
  }

  .load-more-btn {
    padding: 10px 20px;
    font-size: 14px;
    font-weight: 700;
    color: #050811;
    background: #F7D02C;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    box-shadow: 0 2px 10px rgba(247, 208, 44, 0.35);
    transition: all 0.16s ease;
    font-family: inherit;
  }
  .load-more-btn:hover {
    background: #ffd75e;
  }

  .timeline-header h1{font:500 clamp(30px,5vw,48px)/1.1 Arial,sans-serif;letter-spacing:-.035em;max-width:24ch}.timeline-header>p{font:16px/1.7 Arial,sans-serif;max-width:65ch;color:#becfd8}.timeline-scroll{background:#0d1723;border-color:#dff6ff26;color:#e1e9ed}.timeline-content{color:#e1e9ed}.timeline-date{color:#b1c5d0}.timeline-marker{background:#ffd75e;border-color:#0d1723}.timeline::before{background:#5c7180}.mode-btn{font:600 13px Arial,sans-serif}.timeline-filter-count{color:#b1c5d0}
</style>

<script>
  let isHydrated = false;

  function hydrateRemaining() {
    if (isHydrated) return;
    isHydrated = true;

    const dataEl = document.getElementById('timeline-remaining-data');
    const container = document.getElementById('timeline-list');
    const loadMoreContainer = document.getElementById('timeline-load-more');
    if (!dataEl || !container) return;

    try {
      const items = JSON.parse(dataEl.textContent || '[]');
      const fragment = document.createDocumentFragment();

      for (const post of items) {
        const itemEl = document.createElement('div');
        itemEl.className = `timeline-item ${post.easterEgg ? 'has-egg' : ''}`;
        itemEl.id = `day-${post.day}`;

        const marker = document.createElement('div');
        marker.className = 'timeline-marker';
        itemEl.appendChild(marker);

        const details = document.createElement('details');
        details.className = 'timeline-content';

        const summary = document.createElement('summary');
        const dateSpan = document.createElement('span');
        dateSpan.className = 'timeline-date';
        if (post.month) {
          const monthLink = document.createElement('a');
          monthLink.href = `/blog/month/${post.month}/`;
          monthLink.textContent = post.date;
          dateSpan.appendChild(monthLink);
        } else {
          dateSpan.textContent = post.date || '';
        }
        summary.appendChild(dateSpan);

        const h3 = document.createElement('h3');
        h3.textContent = `Day ${post.day}`;
        summary.appendChild(h3);

        if (post.easterEgg) {
          const eggBadge = document.createElement('span');
          eggBadge.className = 'egg-badge';
          eggBadge.textContent = '?? Glitch';
          summary.appendChild(eggBadge);
        }
        details.appendChild(summary);

        const expanded = document.createElement('div');
        expanded.className = 'expanded';

        const pText = document.createElement('p');
        pText.className = 'post-text';
        pText.textContent = post.snippet;
        expanded.appendChild(pText);

        const readMore = document.createElement('a');
        readMore.className = 'read-more';
        readMore.href = `/blog/day-${post.day}/`;
        readMore.textContent = 'Read full page →';
        expanded.appendChild(readMore);

        if (post.easterEgg) {
          const eggP = document.createElement('p');
          eggP.className = 'egg';
          eggP.textContent = `?? ${post.easterEgg}`;
          expanded.appendChild(eggP);
        }

        details.appendChild(expanded);
        itemEl.appendChild(details);
        fragment.appendChild(itemEl);
      }

      container.appendChild(fragment);
      if (loadMoreContainer) loadMoreContainer.style.display = 'none';

      const count = document.getElementById('timeline-filter-count');
      const allItems = container.querySelectorAll('.timeline-item');
      if (count) count.textContent = `Showing all ${allItems.length} days`;
    } catch (e) {
      console.error('Failed to parse timeline remaining data', e);
    }
  }

  function initTimelineTabs() {
    const btnCenturies = document.getElementById('btn-view-centuries');
    const btnDaily = document.getElementById('btn-view-daily');
    const panelCenturies = document.getElementById('view-panel-centuries');
    const panelDaily = document.getElementById('view-panel-daily');
    const btnLoadAll = document.getElementById('btn-load-all-posts');

    btnLoadAll?.addEventListener('click', () => hydrateRemaining());

    function switchView(mode: 'centuries' | 'daily') {
      if (mode === 'centuries') {
        btnCenturies?.classList.add('is-active');
        btnCenturies?.setAttribute('aria-selected', 'true');
        btnDaily?.classList.remove('is-active');
        btnDaily?.setAttribute('aria-selected', 'false');
        if (panelCenturies) panelCenturies.hidden = false;
        if (panelDaily) panelDaily.hidden = true;
      } else {
        btnDaily?.classList.add('is-active');
        btnDaily?.setAttribute('aria-selected', 'true');
        btnCenturies?.classList.remove('is-active');
        btnCenturies?.setAttribute('aria-selected', 'false');
        if (panelDaily) panelDaily.hidden = false;
        if (panelCenturies) panelCenturies.hidden = true;
        hydrateRemaining();
      }
    }

    btnCenturies?.addEventListener('click', () => switchView('centuries'));
    btnDaily?.addEventListener('click', () => switchView('daily'));

    // If direct link to specific day (e.g. #day-500), switch to daily view and hydrate
    if (window.location.hash && window.location.hash.startsWith('#day-')) {
      hydrateRemaining();
      switchView('daily');
      const target = document.querySelector(window.location.hash);
      target?.scrollIntoView({ behavior: 'smooth' });
    }
  }

  function initTimelineSearch() {
    const search = document.getElementById('timeline-search');
    const count = document.getElementById('timeline-filter-count');

    if (search instanceof HTMLInputElement) {
      search.addEventListener('focus', () => {
        hydrateRemaining();
      });

      search.addEventListener('input', (e) => {
        hydrateRemaining();
        const items = document.querySelectorAll('.timeline-item');
        const q = (e.target as HTMLInputElement).value.trim().toLowerCase();
        let visible = 0;
        items.forEach(item => {
          const text = item.textContent?.toLowerCase() || '';
          const match = !q || text.includes(q);
          (item as HTMLElement).style.display = match ? '' : 'none';
          if (match) visible++;
        });
        if (count) {
          count.textContent = q ? `Showing ${visible} of ${items.length} days matching "${q}"` : `Showing all ${items.length} days`;
        }
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      initTimelineTabs();
      initTimelineSearch();
    });
  } else {
    initTimelineTabs();
    initTimelineSearch();
  }
  document.addEventListener('astro:page-load', () => {
    isHydrated = false;
    initTimelineTabs();
    initTimelineSearch();
  });
</script>


