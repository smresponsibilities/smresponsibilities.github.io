---
import Base from "../../layouts/Base.astro";

const allPosts = await import("../../data/linkedin-posts.json");
const posts = allPosts.default;
---

<Base title="Days of Code Timeline | Shivam Mahajan" description="Explore the complete interactive timeline of Shivam Mahajan's 2,002 Days of Code challenge, tracking daily engineering progress, LeetCode, and milestones.">
  <main class="timeline-container">
    <header class="timeline-header">
      <h1>The Complete Timeline</h1>
      <p>A scrollable history of every day coded. Watch out for the glitches!</p>
      <div style="display: flex; gap: 1rem; flex-wrap: wrap; margin-top: 1rem;">
        <a href="/blog/" class="back-link">← Back to Blog</a>
        <a href="/blog/archive/1201-1300/" class="back-link">Century Archives →</a>
        <a href="/blog/milestones/" class="back-link">Milestones →</a>
      </div>
      <div class="timeline-filter-bar">
        <input 
          type="search" 
          id="timeline-search" 
          placeholder="Filter timeline by LeetCode question (e.g. 'Two Sum', '1541') or day..." 
          aria-label="Filter timeline by LeetCode question or day" 
        />
        <span id="timeline-filter-count" class="timeline-filter-count">Showing all {posts.length} days</span>
      </div>
    </header>

    <div class="timeline-scroll">
      <div class="timeline">
        {posts.map(post => (
          <div class={`timeline-item ${post.easterEgg ? "has-egg" : ""}`} id={`day-${post.day}`}>
            <div class="timeline-marker"></div>
                        <details class="timeline-content">
              <summary>
                <span class="timeline-date">
                  {post.date && post.date.length >= 7 ? (
                    <a href={`/blog/month/${post.date.slice(0, 7)}/`}>{post.date}</a>
                  ) : post.date}
                </span>
                <h3>Day {post.day}</h3>
                {post.easterEgg && <span class="egg-badge">?? Glitch</span>}
              </summary>
              <div class="expanded">
                <p class="post-text">{post.content.slice(0, 150)}...</p>
                <a href={`/blog/day-${post.day}/`} class="read-more">Read full page →</a>
                {post.easterEgg && <p class="egg">?? {post.easterEgg}</p>}
              </div>
            </details>
          </div>
        ))}
      </div>
    </div>
  </main>
</Base>

<style>
  .timeline-container {
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem 1rem;
  }
  .timeline-header {
    margin-bottom: 2rem;
  }
  .back-link {
    display: inline-block;
    margin-top: 1rem;
    color: var(--color-primary, #0056b3);
    text-decoration: none;
  }
  .timeline-scroll {
    height: 70vh;
    overflow-y: auto;
    padding-right: 1rem;
    border: 1px solid #eee;
    border-radius: 8px;
    background: #fafafa;
    padding: 2rem;
  }
  .timeline {
    position: relative;
    padding-left: 2rem;
  }
  .timeline::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: 7px;
    width: 2px;
    background: #ccc;
  }
  .timeline-item {
    position: relative;
    margin-bottom: 1.5rem;
  }
  .timeline-marker {
    position: absolute;
    left: -2rem;
    top: 0.25rem;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: #ccc;
    border: 3px solid #fafafa;
  }
  .timeline-item.has-egg .timeline-marker {
    background: #ffaa00;
  }
  .timeline-content h3 {
    margin: 0 0 0.25rem 0;
    font-size: 1.1rem;
  }
  .timeline-content a {
    color: inherit;
    text-decoration: none;
  }
  .timeline-content a:hover {
    text-decoration: underline;
  }
  .timeline-date {
    font-size: 0.85rem;
    color: #666;
    display: block;
    margin-bottom: 0.25rem;
  }
  .egg {
    margin: 0.5rem 0 0 0;
    padding: 0.75rem;
    background: #fff3cd;
    color: #856404;
    border-left: 4px solid #ffaa00;
    border-radius: 4px;
    font-size: 0.9rem;
    font-weight: 500;
  }

  .timeline-content summary { cursor: pointer; list-style: none; }
  .timeline-content summary::-webkit-details-marker { display: none; }
  .timeline-content summary:hover { opacity: 0.8; }
  .timeline-content h3 { display: inline-block; margin: 0 10px 0 0; }
  .egg-badge { background: #ffaa00; color: #fff; padding: 2px 6px; border-radius: 4px; font-size: 0.8rem; font-weight: bold; }
  .timeline-filter-bar {
    margin-top: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  #timeline-search {
    width: 100%;
    padding: 10px 14px;
    font-size: 1rem;
    border: 2px solid var(--accent, #333);
    border-radius: 4px;
    background: var(--panel, #fff);
    color: var(--ink, #000);
    outline: none;
  }
  #timeline-search:focus {
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent, #0056b3) 25%, transparent);
  }
  .timeline-filter-count {
    font-size: 0.85rem;
    color: var(--dim, #666);
  }
</style>

<script>
  const search = document.getElementById('timeline-search');
  const count = document.getElementById('timeline-filter-count');
  const items = document.querySelectorAll('.timeline-item');
  if (search instanceof HTMLInputElement && items.length) {
    search.addEventListener('input', (e) => {
      const q = (e.target as HTMLInputElement).value.trim().toLowerCase();
      let visible = 0;
      items.forEach(item => {
        const text = item.textContent?.toLowerCase() || '';
        const match = !q || text.includes(q);
        (item as HTMLElement).style.display = match ? '' : 'none';
        if (match) visible++;
      });
      if (count) {
        count.textContent = q ? `Showing ${visible} of ${items.length} days matching "${q}"` : `Showing all ${items.length} days`;
      }
    });
  }
</script>


