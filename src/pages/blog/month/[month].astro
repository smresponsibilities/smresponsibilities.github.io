---
import EditorialShell from '../../../components/EditorialShell.astro';
import posts from '../../../data/linkedin-posts.json';

export function getStaticPaths() {
  const months = [...new Set((posts as any[]).map((p) => String(p.date ?? '').slice(0, 7)).filter((m) => /^\d{4}-\d{2}$/.test(m)))].sort().reverse();
  return months.map((month) => ({ 
    params: { month },
    props: { allMonths: months }
  }));
}

const { month } = Astro.params;
const { allMonths } = Astro.props;
const list = (posts as any[]).filter((p) => String(p.date ?? '').startsWith(month!)).sort((a, b) => b.day - a.day);
const name = new Date(`${month}-01T00:00:00Z`).toLocaleString('en', { month: 'long', year: 'numeric', timeZone: 'UTC' });

const rangeDesc = list.length > 0 ? ` (days ${list[list.length - 1]?.day} to ${list[0]?.day})` : '';
const pageDescription = `Daily software engineering updates and coding streak logs from ${name}${rangeDesc} documented by developer Shivam Mahajan.`;

const currentUrl = new URL(Astro.url.pathname, Astro.site ?? 'https://shivammahajan.com').href;
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `Days of Code, ${name} | Shivam Mahajan`,
  description: pageDescription,
  url: currentUrl
};
---

<EditorialShell 
  title={`Days of Code, ${name} | Shivam Mahajan`} 
  description={pageDescription} 
  eyebrow="Field notes / Monthly Archive" 
  heading={name} 
  intro={`${list.length} days logged during ${name}.`}
  structuredData={structuredData}
>
  <nav class="breadcrumb-nav" aria-label="Breadcrumbs" style="margin-bottom: 1.5rem; font-size: 14px;">
    <a href="/">Home</a> <span>/</span>
    <a href="/blog/">Blog</a> <span>/</span>
    <a href="/blog/timeline/">Timeline</a> <span>/</span>
    <span>{name}</span>
  </nav>

  <section>
    <div class="grid">
      {list.map((post) => (
        <article class="card">
          <span class="eyebrow">{post.date} / Day {post.day}</span>
          <h3><a href={`/blog/day-${post.day}/`}>Day {post.day} ↗</a></h3>
          <p>{post.content.substring(0, 80)}...</p>
        </article>
      ))}
    </div>
  </section>

  <section class="month-selector" style="margin-top: 3rem; padding-top: 2rem; border-top: 1px solid var(--border, #333);">
    <h2>All Monthly Archives</h2>
    <p>Jump to any month of the 2,002 Days of Code challenge:</p>
    <div class="month-chips">
      {(allMonths || []).map((m) => {
        const mName = new Date(`${m}-01T00:00:00Z`).toLocaleString('en', { month: 'short', year: 'numeric', timeZone: 'UTC' });
        return (
          <a 
            href={`/blog/month/${m}/`} 
            class={`chip ${m === month ? 'current' : ''}`}
          >
            {mName}
          </a>
        );
      })}
    </div>
  </section>
</EditorialShell>

<style>
  .breadcrumb-nav a {
    color: var(--accent);
    text-decoration: none;
  }
  .month-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 1rem;
  }
  .chip {
    display: inline-block;
    padding: 6px 12px;
    border: 1px solid var(--border, #444);
    background: var(--panel, #161b22);
    color: var(--ink);
    text-decoration: none;
    border-radius: 4px;
    font-size: 13px;
  }
  .chip.current {
    background: var(--accent);
    color: var(--bg, #000);
    font-weight: bold;
    border-color: var(--accent);
  }
  .chip:hover:not(.current) {
    border-color: var(--accent);
    color: var(--accent);
  }
</style>
