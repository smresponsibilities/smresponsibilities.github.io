---
import EditorialShell from '../../components/EditorialShell.astro';

const currentUrl = new URL(Astro.url.pathname, Astro.site ?? 'https://shivammahajan.com').href;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfilePage',
      '@id': `${currentUrl}#profile`,
      isPartOf: { '@id': 'https://shivammahajan.com/#website' },
      url: currentUrl,
      name: 'Shivam Mahajan — Software Engineer and Developer',
      mainEntity: { '@id': 'https://shivammahajan.com/#shivam-mahajan' }
    },
    {
      '@type': 'Person',
      '@id': 'https://shivammahajan.com/#shivam-mahajan',
      name: 'Shivam Mahajan',
      url: 'https://shivammahajan.com/',
      jobTitle: 'Software Developer',
      sameAs: [
        'https://www.wikidata.org/wiki/Q141734464',
        'https://orcid.org/0009-0009-4574-3338',
        'https://me.developers.google.com/u/107207277969180626613',
        'https://www.kaggle.com/mahajanshivam',
        'https://huggingface.co/mahajanshivam',
        'https://dev.to/shivammahajan',
        'https://www.crunchbase.com/person/shivam-mahajan-38ae',
        'https://en.wikipedia.org/wiki/User:Shivammahajan0',
        'https://meta.wikimedia.org/wiki/User:Shivammahajan0',
        'https://github.com/smresponsibilities',
        'https://www.linkedin.com/in/mahajanshivam/',
        'https://peerlist.io/shivammahajan',
        'https://www.producthunt.com/@shivammahajan'
      ],
      knowsAbout: [
        'Python', 'Kotlin', 'Apache Kafka', 'PySpark', 'Snowflake', 'Distributed Systems', 'Astro', 'Next.js', 'Deterministic E-commerce Architecture', 'React', 'Solidity'
      ]
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${currentUrl}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://shivammahajan.com/' },
        { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://shivammahajan.com/blog/' },
        { '@type': 'ListItem', position: 3, name: 'Shivam Mahajan', item: currentUrl }
      ]
    }
  ]
};
---
<EditorialShell 
  title="Shivam Mahajan - Software Engineer and Developer" 
  description="Explore software engineer Shivam Mahajan's developer portfolio, 2,002 Days of Code daily engineering journal, backend systems, and featured projects." 
  heading="Shivam Mahajan"
  eyebrow="Profile / Overview"
  intro="Software engineer building distributed backend systems, algorithmic tooling, and interactive web experiences."
  structuredData={structuredData}>
  
  <p><strong>Shivam Mahajan</strong> is a software engineer dedicated to building high-quality, scalable web applications and exploring the frontiers of agentic AI. With a strong foundation in modern web technologies and a relentless drive for continuous learning, Shivam has committed to the 2,002 Days of Code challenge, documenting daily progress and technical deep dives.</p>
  
  <h2>Professional Journey</h2>
  <p>Throughout his career, Shivam Mahajan has focused on crafting intuitive user experiences and robust backend architectures. His work spans from interactive 3D visualizations using Three.js to complex, AI-driven automation pipelines.</p>

  <h2>Projects and Portfolio</h2>
  <p>Explore the various projects developed by Shivam Mahajan, including the SM-Dex, a unique interactive developer portfolio, and the comprehensive 2,002 Days of Code timeline, showcasing a consistent commitment to software development.</p>

  <h2>Connect & Explore</h2>
  <div style="display: flex; gap: 10px; flex-wrap: wrap; margin-top: 1rem;">
    <a href="/resume/">View Full Resume →</a>
    <a href="/blog/">Days of Code Journal →</a>
    <a href="/blog/timeline/">Interactive Timeline →</a>
    <a href="/projects/">Project Portfolio →</a>
  </div>
</EditorialShell>
