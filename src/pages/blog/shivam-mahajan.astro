---
import { getDailyStreak } from '../../lib/streak';
import EditorialShell from '../../components/EditorialShell.astro';

const currentUrl = new URL(Astro.url.pathname, Astro.site ?? 'https://shivammahajan.com').href;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfilePage',
      '@id': `${currentUrl}#profile`,
      isPartOf: { '@id': 'https://shivammahajan.com/#website' },
      url: currentUrl,
      name: 'Shivam Mahajan — Software Engineer and Developer',
      mainEntity: { '@id': 'https://shivammahajan.com/#shivam-mahajan' }
    },
    {
      '@type': 'Person',
      '@id': 'https://shivammahajan.com/#shivam-mahajan',
      name: 'Shivam Mahajan',
      url: 'https://shivammahajan.com/',
      jobTitle: 'Software Developer',
      sameAs: [
        'https://www.wikidata.org/wiki/Q141734464',
        'https://orcid.org/0009-0009-4574-3338',
        'https://me.developers.google.com/u/107207277969180626613',
        'https://www.kaggle.com/mahajanshivam',
        'https://huggingface.co/mahajanshivam',
        'https://dev.to/shivammahajan',
        'https://www.crunchbase.com/person/shivam-mahajan-38ae',
        'https://en.wikipedia.org/wiki/User:Shivammahajan0',
        'https://meta.wikimedia.org/wiki/User:Shivammahajan0',
        'https://github.com/smresponsibilities',
        'https://www.linkedin.com/in/mahajanshivam/',
        'https://peerlist.io/shivammahajan',
        'https://www.producthunt.com/@shivammahajan'
      ],
      knowsAbout: [
        'Python', 'Kotlin', 'Apache Kafka', 'PySpark', 'Snowflake', 'Distributed Systems', 'Astro', 'Next.js', 'Deterministic E-commerce Architecture', 'React', 'Solidity'
      ]
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${currentUrl}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://shivammahajan.com/' },
        { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://shivammahajan.com/blog/' },
        { '@type': 'ListItem', position: 3, name: 'Shivam Mahajan', item: currentUrl }
      ]
    }
  ]
};
---
<EditorialShell 
  title="Shivam Mahajan - Software Engineer and Developer" 
  description="Meet Shivam Mahajan, a software developer working with Python and Kotlin. Find his official portfolio, professional profiles and ongoing coding journal."
  heading="Shivam Mahajan"
  eyebrow="Profile / Overview"
  intro="Software engineer building distributed backend systems, algorithmic tooling, and interactive web experiences."
  structuredData={structuredData}>
  
  <p><strong>Shivam Mahajan</strong> is a software developer working with Python, Kotlin, data pipelines and web applications. This profile connects his public accounts, engineering work and ongoing learning journal.</p>

  <h2>Find the right starting point</h2>
  <p>The <a href="/">official portfolio</a> presents the interactive SM'S DEX experience. The <a href="/resume/">resume</a> lists experience, education and current coding metrics. For implementation details and source repositories, read the <a href="/blog/shivam-mahajan-software-developer/">engineering work guide</a>.</p>

  <h2>An ongoing coding challenge</h2>
  <p>Shivam is working toward a 2,002-day coding challenge. The current challenge day is {getDailyStreak().toLocaleString()}; 2,002 is the target, not the number of completed days. The <a href="/blog/">Days of Code journal</a> contains published notes and project updates.</p>

  <h2>Public profiles</h2>
  <p>Code is published as <a href="https://github.com/smresponsibilities" target="_blank" rel="noopener noreferrer">smresponsibilities on GitHub</a>. Professional updates appear on <a href="https://www.linkedin.com/in/mahajanshivam/" target="_blank" rel="noopener noreferrer">LinkedIn</a> and project summaries on <a href="https://peerlist.io/shivammahajan" target="_blank" rel="noopener noreferrer">Peerlist</a>.</p>

  <h2>Connect & Explore</h2>
  <div style="display: flex; gap: 10px; flex-wrap: wrap; margin-top: 1rem;">
    <a href="/">Official Home Dex →</a>
    <a href="/resume/">View Full Resume →</a>
    <a href="/blog/">Days of Code Journal →</a>
    <a href="/blog/timeline/">Interactive Timeline →</a>
    <a href="/projects/">Project Portfolio →</a>
  </div>
</EditorialShell>
