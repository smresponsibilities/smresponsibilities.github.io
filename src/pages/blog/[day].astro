    flex-wrap: wrap;
    margin-top: auto;
  }
  .feature-btn {
    display: inline-flex;
    align-items: center;
    font-size: 12px;
    font-weight: 600;
    text-decoration: none;
    padding: 7px 11px;
    border-radius: 4px;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .feature-btn.primary {
    background: var(--accent, #ffd75e);
    color: #0b0e12;
    border: 1px solid var(--accent, #ffd75e);
  }
  .feature-btn.primary:hover {
    background: #fff;
    color: #000;
  }
  .feature-btn.secondary {
    background: transparent;
    color: var(--time-accent, #ffd75e);
    border: 1px solid var(--border, #444);
  }
  .feature-btn.secondary:hover {
    border-color: var(--time-accent, #ffd75e);
    color: #fff;
  }

  /* Adjacent Day-to-Day Navigation */
  .adjacent-nav {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 12px;
    margin: 28px 0 36px;
    padding: 14px;
    background: var(--panel, #161b22);
    border: 1px solid var(--border, #333);
