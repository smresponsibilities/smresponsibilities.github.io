---
import EditorialShell from '../../components/EditorialShell.astro';
import { extractLeetCodeQuestions } from '../../utils/leetcode';

export async function getStaticPaths() {
  const allPostsModule = await import('../../data/linkedin-posts.json');
  const allPosts = allPostsModule.default;

  function getTopic(content: string): string {
    if (/dynamic programming|dp\b|memoization|knapsack|subsequence/i.test(content)) return 'Dynamic Programming';
    if (/binary tree|tree\b|bst\b|trie\b|traversal/i.test(content)) return 'Trees & Hierarchies';
    if (/graph\b|bfs\b|dfs\b|dijkstra|topological/i.test(content)) return 'Graph Theory';
    if (/binary search|two pointer|sliding window|monotonic/i.test(content)) return 'Binary Search & Pointers';
    if (/kafka|snowflake|pyspark|pipeline|clickhouse|docker|fastapi|backend/i.test(content)) return 'Distributed Systems';
    if (/stack|queue|hash\s*map|hashmap|hash table|frequency/i.test(content)) return 'Hash Maps & Stacks';
    if (/leetcode/i.test(content)) return 'Algorithmic Optimization';
    return 'Engineering Practice';
  }

  const postsWithTopics = allPosts.map(p => ({
    ...p,
    topic: getTopic(String(p.content || ''))
  }));

  const postsByTopic = new Map<string, typeof postsWithTopics>();
  for (const p of postsWithTopics) {
    if (!postsByTopic.has(p.topic)) postsByTopic.set(p.topic, []);
    postsByTopic.get(p.topic)!.push(p);
  }

  const pinnedDays = [1228, 1000, 500, 100, 1];
  const pinnedMilestones = pinnedDays
    .map(d => postsWithTopics.find(p => p.day === d))
    .filter((p): p is typeof postsWithTopics[0] => Boolean(p))
    .map(p => ({
      day: p.day,
      date: p.date,
      topic: p.topic,
      milestone: p.milestone || `Day ${p.day} Milestone`
    }));

  return postsWithTopics.map((post, idx) => {
    const prevPost = idx > 0 ? { day: allPosts[idx - 1].day, date: allPosts[idx - 1].date } : null;
    const nextPost = idx < allPosts.length - 1 ? { day: allPosts[idx + 1].day, date: allPosts[idx + 1].date } : null;

    const sameTopic = postsByTopic.get(post.topic) || [];
    const postTopicIdx = sameTopic.findIndex(p => p.day === post.day);
    const related: typeof postsWithTopics = [];

    if (sameTopic.length > 1) {
      for (let step = 1; step < sameTopic.length && related.length < 3; step++) {
        const nextIdx = (postTopicIdx + step) % sameTopic.length;
        if (nextIdx !== postTopicIdx) {
          related.push(sameTopic[nextIdx]);
        }
      }
    }

    if (related.length < 3) {
      for (const d of [1000, 500, 100, 1]) {
        if (d !== post.day && !related.some(r => r.day === d)) {
          const found = postsWithTopics.find(p => p.day === d);
          if (found) related.push(found);
          if (related.length >= 3) break;
        }
      }
    }

    const formattedRelated = related.slice(0, 3).map(r => {
      const text = String(r.content || '').replace(/\s+/g, ' ').trim();
      const snippet = text.length > 85 ? text.slice(0, 82) + '...' : text;
      return {
        day: r.day,
        date: r.date,
        topic: r.topic,
        snippet
      };
    });

    return {
      params: { day: `day-${post.day}` },
      props: {
        post,
        prevPost,
        nextPost,
        relatedPosts: formattedRelated,
        pinnedMilestones,
        currentTopic: post.topic
      },
    };
  });
}

const { post, prevPost, nextPost, relatedPosts, pinnedMilestones, currentTopic } = Astro.props;
const currentUrl = new URL(Astro.url.pathname, Astro.site ?? 'https://shivammahajan.com').href;

// Extract LeetCode problem if present in post content
const leetcodeQuestions = extractLeetCodeQuestions(post.content);
const primaryQuestion = leetcodeQuestions[0];
const problemTitle = primaryQuestion ? `LeetCode ${primaryQuestion.number}: ${primaryQuestion.title}` : null;
const leetcodeTag = problemTitle 
  ? problemTitle 
  : (typeof post.content === 'string' && /leetcode/i.test(post.content) ? 'LeetCode' : '2002 Days of Code');
let pageTitle;
if (primaryQuestion) {
  const cleanTitle = primaryQuestion.title.replace(/['"&#;]/g, '');
  let base = `Day ${post.day} | LC ${primaryQuestion.number}: ${cleanTitle}`;
  if (base.length > 44) {
    base = base.slice(0, 41) + '...';
  }
  pageTitle = `${base} | Shivam Mahajan`;
} else if (typeof post.content === 'string' && /leetcode/i.test(post.content)) {
  pageTitle = `Day ${post.day} | LeetCode | Shivam Mahajan`;
} else {
  pageTitle = `Day ${post.day} | 2,002 Days of Code | Shivam Mahajan`;
}
if (pageTitle.length < 30) {
  pageTitle = `Day ${post.day} Engineering Log | Shivam Mahajan`;
}
const pageHeading = problemTitle ? `Day ${post.day}: ${problemTitle}` : `Day ${post.day}`;
const trimmedTitle = problemTitle && problemTitle.length > 45 ? `${problemTitle.slice(0, 42)}...` : problemTitle;
const pageDesc = trimmedTitle
  ? `Day ${post.day} of 2,002 Days of Code: Algorithmic analysis and optimal solution for ${trimmedTitle} in Python/DSA by Shivam Mahajan.`
  : `Day ${post.day} of Shivam Mahajan's 2,002 Days of Code journey: Daily software engineering updates, DSA problem solving, and project milestones.`;

const groupLower = Math.floor((post.day - 1) / 100) * 100 + 1;
const groupUpper = groupLower + 99;
const groupName = `${groupLower}-${groupUpper}`;
const monthSlug = typeof post.date === 'string' && /^\d{4}-\d{2}/.test(post.date) ? post.date.slice(0, 7) : null;

// Inverted pyramid direct answer (under 50 words) - Tactic #2
const directAnswer = problemTitle
  ? `Day ${post.day} of Shivam Mahajan's 2,002 Days of Code challenge analyzes and solves ${problemTitle} using optimal algorithmic patterns in Python and Data Structures.`
  : `Day ${post.day} of Shivam Mahajan's 2,002 Days of Code challenge records daily algorithmic problem solving, software engineering practice, and continuous learning.`;

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BlogPosting',
      '@id': `${currentUrl}#article`,
      isPartOf: { '@id': 'https://shivammahajan.com/#website' },
      headline: problemTitle ? `${problemTitle} (Day ${post.day})` : `Day ${post.day} of 2002 Days of Code`,
      description: pageDesc,
      inLanguage: 'en-IN',
      author: { '@id': 'https://shivammahajan.com/#shivam-mahajan' },
      publisher: { '@id': 'https://shivammahajan.com/#shivam-mahajan' },
      url: currentUrl,
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': currentUrl
      },
      datePublished: new Date(post.date).toISOString(),
      dateModified: new Date(post.date).toISOString(),
      keywords: [
        'Shivam Mahajan',
        '2002 Days of Code',
        'LeetCode',
        'Python',
        'Algorithms',
        'Data Structures',
        ...(primaryQuestion ? [primaryQuestion.title, `LeetCode ${primaryQuestion.number}`] : [])
      ],
      articleBody: post.content,
      relatedLink: [
        ...(prevPost ? [`https://shivammahajan.com/blog/day-${prevPost.day}/`] : []),
        ...(nextPost ? [`https://shivammahajan.com/blog/day-${nextPost.day}/`] : []),
        ...relatedPosts.map(r => `https://shivammahajan.com/blog/day-${r.day}/`),
        'https://shivammahajan.com/blog/milestones/'
      ]
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${currentUrl}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://shivammahajan.com/' },
        { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://shivammahajan.com/blog/' },
        { '@type': 'ListItem', position: 3, name: 'Timeline', item: 'https://shivammahajan.com/blog/timeline/' },
        { '@type': 'ListItem', position: 4, name: `Day ${post.day}`, item: currentUrl }
      ]
    }
  ]
};

const articleWords = (typeof post.content === 'string' ? post.content.trim().split(/\s+/).length : 0) + 120;
---

<EditorialShell 
  title={pageTitle} 
  description={pageDesc} 
  eyebrow={`2002 Days of Code / ${post.date}`} 
  heading={pageHeading} 
  intro={`Shivam's engineering update for day ${post.day} of the 2,002 Days of Code challenge.`}
  structuredData={structuredData}
  words={articleWords}
>
  <a slot="actions" href={post.url} target="_blank" rel="noopener noreferrer">Read LinkedIn post ↗</a>
  <a slot="actions" href="/blog/timeline/">View Timeline ↗</a>

  <!-- Top-of-page Breadcrumbs (Tactic #88 & Tactic #98) -->
  <nav class="breadcrumb-nav" aria-label="Breadcrumb navigation">
    <a href="/">Home</a> <span>/</span>
    <a href="/blog/">Blog</a> <span>/</span>
    <a href="/blog/timeline/">Timeline</a> <span>/</span>
    <a href={currentUrl} aria-current="page">Day {post.day}</a>
  </nav>

  <!-- Author Byline linked to profile (Tactic #60) -->
  <div class="byline-bar">
    <span>By <a href="/resume/">Shivam Mahajan</a> (Software Developer)</span>
    <span>·</span>
    <time datetime={post.date}>{post.date}</time>
    <span>·</span>
    <span>Part of <a href="/blog/timeline/">2,002 Days of Code</a></span>
  </div>

  <!-- Direct Answer Executive Summary (Tactic #2) -->
  <div class="direct-answer">
    <p><strong>Executive Summary:</strong> {directAnswer}</p>
  </div>

  <!-- Hard Quantitative Statistics (Tactic #3 & Tactic #69) -->
  <div class="metrics-strip">
    <div class="metric-pill">
      <span class="metric-label">Streak Status</span>
      <span class="metric-value">Day {post.day} of 2,002</span>
    </div>
    <div class="metric-pill">
      <span class="metric-label">Problems Solved</span>
      <span class="metric-value">2,600+ Solved</span>
    </div>
    <div class="metric-pill">
      <span class="metric-label">Shipped Suites</span>
      <span class="metric-value">425+ Tests</span>
    </div>
    <div class="metric-pill">
      <span class="metric-label">Live Pipeline</span>
      <span class="metric-value">5M+ Events</span>
    </div>
  </div>

  <section>
    <h2 id="what-the-post-says">What the post says</h2>
    <p>{post.content}</p>
    {problemTitle && (
      <p class="citation-note">
        Source: Algorithmic problem verified on <a href="https://leetcode.com/" target="_blank" rel="noopener noreferrer">LeetCode Official</a>. Solution walkthrough authored by <a href="/resume/">Shivam Mahajan</a>.
      </p>
    )}
  </section>

  {post.milestone && (
    <section>
      <h2 id="milestone">🎉 Milestone</h2>
      <p>
        <strong>{post.milestone}</strong>
        {post.milestoneUrl && (
          <span> — <a href={post.milestoneUrl} target="_blank" rel="noopener noreferrer">View announcement post ↗</a></span>
        )}
      </p>
    </section>
  )}

  {post.easterEgg && (
    <section>
      <h2>Wait a minute...</h2>
      <p><em>{post.easterEgg}</em></p>
      <p><small>Numbering drifts happen when you code for 3+ years straight!</small></p>
    </section>
  )}

  <!-- Chronological Day-to-Day Navigation -->
  <nav class="adjacent-nav" aria-label="Adjacent days">
    {prevPost ? (
      <a class="nav-prev" href={`/blog/day-${prevPost.day}/`}>
        <span class="nav-direction">← Previous Entry</span>
        <span class="nav-title">Day {prevPost.day}</span>
        <span class="nav-sub">{prevPost.date}</span>
      </a>
    ) : (
      <div class="nav-placeholder">
        <span class="nav-direction">Start of Streak</span>
        <span class="nav-title">Day 1</span>
      </div>
    )}

    <a class="nav-hub" href="/blog/timeline/">
      <span class="nav-direction">Complete Challenge</span>
      <span class="nav-title">Full 2,002 Timeline</span>
      <span class="nav-sub">View All Entries →</span>
    </a>

    {nextPost ? (
      <a class="nav-next" href={`/blog/day-${nextPost.day}/`}>
        <span class="nav-direction">Next Entry →</span>
        <span class="nav-title">Day {nextPost.day}</span>
        <span class="nav-sub">{nextPost.date}</span>
      </a>
    ) : (
      <div class="nav-placeholder">
        <span class="nav-direction">Latest Day</span>
        <span class="nav-title">Active Frontier</span>
      </div>
    )}
  </nav>

  <!-- Smart Related Engineering Logs & Walkthroughs Engine -->
  <section class="related-logs-section">
    <div class="section-title-row">
      <h2 id="related-walkthroughs">Related Problem Walkthroughs &amp; Logs</h2>
      <span class="topic-tag-pill">{currentTopic}</span>
    </div>
    <p>Discover interconnected algorithmic solutions and engineering updates sharing the <strong>{currentTopic}</strong> cluster:</p>
    <div class="related-grid">
      {relatedPosts.map((r) => (
        <a class="related-card" href={`/blog/day-${r.day}/`}>
          <div class="related-card-top">
            <span class="related-day-badge">Day {r.day}</span>
            <span class="related-topic-badge">{r.topic}</span>
            <time datetime={r.date}>{r.date}</time>
          </div>
          <p class="related-snippet">{r.snippet}</p>
          <span class="related-card-cta">Read Walkthrough →</span>
        </a>
      ))}
    </div>
  </section>

  <!-- Pinned Milestone Benchmarks -->
  <section class="pinned-milestones-section">
    <h2 id="pinned-milestones">Pinned Engineering Milestones</h2>
    <p>Anchor benchmarks and century markers across Shivam Mahajan's multi-year streak:</p>
    <div class="pinned-grid">
      {pinnedMilestones.map((m) => (
        <a class="pinned-card" href={`/blog/day-${m.day}/`}>
          <div class="pinned-day-badge">Day {m.day}</div>
          <div class="pinned-text-block">
            <span class="pinned-milestone-title">{m.milestone}</span>
            <span class="pinned-meta">{m.date} · {m.topic}</span>
          </div>
        </a>
      ))}
      <a class="pinned-card view-all-card" href="/blog/milestones/">
        <div class="pinned-day-badge">★</div>
        <div class="pinned-text-block">
          <span class="pinned-milestone-title">Explore All Milestones</span>
          <span class="pinned-meta">Full Century Directory →</span>
        </div>
      </a>
    </div>
  </section>

  <!-- Interactive Project Feature Cards (Playbook 29) -->
  <section class="featured-projects-section">
    <h2 id="featured-systems">Featured Engineering Systems & Architecture</h2>
    <p>Explore production architectures, distributed systems, and low-level engines built by Shivam Mahajan:</p>
    <div class="project-feature-grid">
      <div class="project-feature-card">
        <div class="feature-card-header">
          <span class="feature-badge">Native Wasm 2.4 KB</span>
          <span class="feature-badge">Pure C99</span>
        </div>
        <h3 class="feature-title">Terminal Wordle in C &amp; WebAssembly</h3>
        <p class="feature-desc">Zero-dependency Wordle engine compiled directly to standalone WebAssembly with custom polynomial hashing and zero JS runtime overhead.</p>
        <div class="feature-actions">
          <a class="feature-btn primary" href="/projects/wordle/">Explore Architecture Case Study →</a>
          <a class="feature-btn secondary" href="/wordle-simulator/">Launch Simulator ↗</a>
        </div>
      </div>

      <div class="project-feature-card">
        <div class="feature-card-header">
          <span class="feature-badge">Solved 2,600+ LeetCode</span>
          <span class="feature-badge">Zero-JS Default</span>
        </div>
        <h3 class="feature-title">SM'S DEX: Pokédex Portfolio &amp; Open Roster</h3>
        <p class="feature-desc">Open-source Pokédex portfolio with browser-native Web Audio chiptune synthesis and automated GitHub Actions roster validation.</p>
        <div class="feature-actions">
          <a class="feature-btn primary" href="/projects/sm-dex/">Explore Architecture Case Study →</a>
          <a class="feature-btn secondary" href="/">Launch Pokédex ↗</a>
        </div>
      </div>

      <div class="project-feature-card">
        <div class="feature-card-header">
          <span class="feature-badge">5M+ Events Kafka/Snowflake</span>
          <span class="feature-badge">Zero Discrepancy</span>
        </div>
        <h3 class="feature-title">CIAM Streaming Data Platform</h3>
        <p class="feature-desc">High-throughput Kafka, PySpark, and Snowflake enterprise data pipeline maintaining strict zero row-count discrepancy tolerance.</p>
        <div class="feature-actions">
          <a class="feature-btn primary" href="/resume/">Explore Experience &amp; Resume →</a>
        </div>
      </div>

      <div class="project-feature-card">
        <div class="feature-card-header">
          <span class="feature-badge">Kotlin / Jetpack Compose</span>
          <span class="feature-badge">100% Offline AlarmManager</span>
        </div>
        <h3 class="feature-title">Productivity Caller: Task Reminder App</h3>
        <p class="feature-desc">Overcomes notification blindness by initiating simulated incoming phone calls for urgent tasks with on-device natural language parsing.</p>
        <div class="feature-actions">
          <a class="feature-btn primary" href="/projects/productivity-caller/">Explore Architecture Case Study →</a>
          <a class="feature-btn secondary" href="/projects/productivity-caller-vs-alternatives/">Compare Alternatives →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Navigation Archive Links -->
  <section>
    <h2 id="timeline-archives">Days of Code Timeline &amp; Archives</h2>
    <div class="hub-links">
      <a href="/blog/">Days of Code Journal →</a>
      <a href={`/blog/archive/${groupName}/`}>Days {groupName} Archive →</a>
      {monthSlug && <a href={`/blog/month/${monthSlug}/`}>Month ({monthSlug}) Archive →</a>}
      <a href="/blog/timeline/">Full 2,002-Day Timeline →</a>
      <a href="/blog/milestones/">Key Milestones →</a>
      <a href="/resume/">Shivam's Resume &amp; Experience →</a>
    </div>
  </section>
</EditorialShell>

<style>
  .breadcrumb-nav {
    display: flex;
    gap: 8px;
    align-items: center;
    font-size: 13px;
    color: var(--dim, #888);
    margin-bottom: 14px;
    flex-wrap: wrap;
  }
  .breadcrumb-nav a {
    color: var(--time-accent, #ffd75e);
    text-decoration: none;
  }
  .breadcrumb-nav a:hover {
    text-decoration: underline;
  }
  .byline-bar {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 12px 0 20px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--border, #333);
    font-size: 14px;
    color: var(--dim, #aaa);
    flex-wrap: wrap;
  }
  .byline-bar a {
    color: var(--time-accent, #ffd75e);
    font-weight: 500;
  }
  .direct-answer {
    padding: 16px 20px;
    background: var(--panel, #161b22);
    border-left: 4px solid var(--time-accent, #ffd75e);
    border-radius: 4px;
    margin: 18px 0;
  }
  .direct-answer p {
    margin: 0;
    line-height: 1.5;
    font-size: 15px;
  }
  .metrics-strip {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
    gap: 10px;
    margin: 20px 0 28px;
  }
  .metric-pill {
    padding: 10px 14px;
    background: var(--panel, #161b22);
    border: 1px solid var(--border, #333);
    border-radius: 4px;
  }
  .metric-label {
    display: block;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--dim, #888);
  }
  .metric-value {
    display: block;
    font-size: 15px;
    font-weight: 600;
    color: var(--ink, #fff);
    margin-top: 2px;
  }
  .citation-note {
    font-size: 13px;
    color: var(--dim, #888);
    margin-top: 14px;
    padding-top: 12px;
    border-top: 1px dashed var(--border, #333);
  }
  .citation-note a {
    color: var(--time-accent, #ffd75e);
  }
  .hub-links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 14px;
  }
  .hub-links a {
    display: inline-block;
    padding: 8px 14px;
    border: 1px solid var(--border, #444);
    background: var(--panel, #161b22);
    color: var(--ink, #fff);
    text-decoration: none;
    border-radius: 2px;
    font-size: 14px;
  }
  .hub-links a:hover {
    border-color: var(--time-accent, #ffd75e);
    background: var(--time-accent, #ffd75e);
    color: #000;
  }
  .featured-projects-section {
    margin-top: 36px;
  }
  .project-feature-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    margin-top: 18px;
  }
  @media (max-width: 700px) {
    .project-feature-grid {
      grid-template-columns: 1fr;
    }
  }
  .project-feature-card {
    padding: 20px;
    background: var(--panel, #161b22);
    border: 2px solid var(--accent, #ffd75e);
    border-radius: 6px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .project-feature-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4);
    border-color: var(--time-accent, #ffd75e);
  }
