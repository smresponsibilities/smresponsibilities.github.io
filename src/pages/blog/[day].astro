---
import EditorialShell from '../../components/EditorialShell.astro';

export async function getStaticPaths() {
  const allPosts = await import('../../data/linkedin-posts.json');
  return allPosts.default.map((post) => ({
    params: { day: `day-${post.day}` },
    props: { post },
  }));
}

const { post } = Astro.props;
const currentUrl = new URL(Astro.url.pathname, Astro.site ?? 'https://shivammahajan.com').href;

// Extract LeetCode problem if present in post content
const leetcodeMatch = typeof post.content === 'string' ? post.content.match(/Leetcode:\s*(\d+)\.\s*([^\n#]+)/i) : null;
const problemTitle = leetcodeMatch ? `LeetCode ${leetcodeMatch[1]}: ${leetcodeMatch[2].trim()}` : null;
const leetcodeTag = problemTitle 
  ? problemTitle 
  : (typeof post.content === 'string' && /leetcode/i.test(post.content) ? 'LeetCode' : '2002 Days of Code');
const pageTitle = `Day ${post.day} | Shivam Mahajan | ${leetcodeTag}`;
const pageHeading = problemTitle ? `Day ${post.day}: ${problemTitle}` : `Day ${post.day}`;
const pageDesc = problemTitle
  ? `Day ${post.day} of 2002 Days of Code: Walkthrough and solution for ${problemTitle} in Python/DSA by Shivam Mahajan.`
  : `Day ${post.day} of Shivam Mahajan's 2002 Days of Code challenge.`;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: problemTitle ? `${problemTitle} (Day ${post.day})` : `Day ${post.day} of 2002 Days of Code`,
  description: pageDesc,
  author: {
    '@type': 'Person',
    name: 'Shivam Mahajan',
    url: 'https://shivammahajan.com/'
  },
  url: currentUrl,
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': currentUrl
  },
  datePublished: new Date(post.date).toISOString(),
  articleBody: post.content
};
---

<EditorialShell 
  title={pageTitle} 
  description={pageDesc} 
  eyebrow={`2002 Days of Code / ${post.date}`} 
  heading={pageHeading} 
  intro={`Shivam's LinkedIn update for day ${post.day}.`}
  structuredData={structuredData}
>
  <a slot="actions" href={post.url} target="_blank" rel="noopener noreferrer">Read LinkedIn post ↗</a>
  <section>
    <h2>What the post says</h2>
    <p>{post.content}</p>
  </section>

  {post.milestone && (
    <section>
      <h2>🎉 Milestone</h2>
      <p>
        <strong>{post.milestone}</strong>
        {post.milestoneUrl && (
          <span> — <a href={post.milestoneUrl} target="_blank" rel="noopener noreferrer">View announcement post ↗</a></span>
        )}
      </p>
    </section>
  )}

  {post.easterEgg && (
    <section>
      <h2>Wait a minute...</h2>
      <p><em>{post.easterEgg}</em></p>
      <p><small>Numbering drifts happen when you code for 3+ years straight!</small></p>
    </section>
  )}

  <section>
    <h2>Follow the challenge</h2>
    <p>Browse the <a href="/blog/">Days of Code journal</a> for selected updates. Shivam's <a href="/projects/">projects</a> show where regular practice connects to shipped software.</p>
  </section>
</EditorialShell>
