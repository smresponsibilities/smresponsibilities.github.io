---
import EditorialShell from '../../components/EditorialShell.astro';

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': 'https://shivammahajan.com/projects/#collection',
      name: "Software Projects | Shivam Mahajan",
      description: "Comprehensive catalog of Shivam Mahajan's software engineering projects across Android, distributed data systems, web applications, and low-level tools.",
      url: 'https://shivammahajan.com/projects/',
      mainEntity: {
        '@type': 'ItemList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Productivity Caller', url: 'https://shivammahajan.com/projects/productivity-caller/' },
          { '@type': 'ListItem', position: 2, name: "SM'S DEX", url: 'https://shivammahajan.com/projects/sm-dex/' },
          { '@type': 'ListItem', position: 3, name: 'Chaincode', url: 'https://shivammahajan.com/projects/chaincode/' },
          { '@type': 'ListItem', position: 4, name: 'QuizDeck', url: 'https://github.com/smresponsibilities/QuizDeck' },
          { '@type': 'ListItem', position: 5, name: 'ClickHouse Data Ingestion Tool', url: 'https://github.com/smresponsibilities/Ingestion-Tool' },
          { '@type': 'ListItem', position: 6, name: 'Flight Sun Tracker', url: 'https://shivammahajan.com/projects/flight-sun-tracker/' },
          { '@type': 'ListItem', position: 7, name: 'Postie API Client', url: 'https://shivammahajan.com/projects/postie/' },
          { '@type': 'ListItem', position: 8, name: 'Shopify Insights', url: 'https://xeno2-df3z.vercel.app' },
          { '@type': 'ListItem', position: 9, name: 'JobScraper Hourly', url: 'https://github.com/smresponsibilities/jobscraper_hourly' },
          { '@type': 'ListItem', position: 10, name: 'Clickless', url: 'https://github.com/smresponsibilities/clickless' },
          { '@type': 'ListItem', position: 11, name: 'Terminal Wordle in C', url: 'https://shivammahajan.com/Wordle/' },
          { '@type': 'ListItem', position: 12, name: 'Fertilizer Recommendation API', url: 'https://fertilizertypebysm.onrender.com/' },
          { '@type': 'ListItem', position: 13, name: 'TaskFlow & Daily Quotes', url: 'https://shivammahajan.com/FEETODOWEBSITE/' },
          { '@type': 'ListItem', position: 14, name: 'Python Game Arcade', url: 'https://shivammahajan.com/Gamehub/' }
        ]
      }
    },
    {
      '@type': 'BreadcrumbList',
      '@id': 'https://shivammahajan.com/projects/#breadcrumb',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://shivammahajan.com/' },
        { '@type': 'ListItem', position: 2, name: 'Projects', item: 'https://shivammahajan.com/projects/' }
      ]
    }
  ]
};
---

<EditorialShell 
  title="Software Engineering Projects | Shivam Mahajan" 
  description="Explore Shivam Mahajan's project portfolio: Kotlin mobile apps, Astro Pokédex architecture, ClickHouse data pipelines, WebSockets, and systems tools." 
  eyebrow="Move list / Projects" 
  heading="Projects & Technical Portfolio" 
  intro="Complete engineering portfolio by Shivam Mahajan. Spans native Android, distributed data tools, real-time WebSocket apps, AI code validation, and systems utilities."
  structuredData={structuredData}
>
  <a slot="actions" href="/resume/">View Resume</a>
  <a slot="actions" href="https://github.com/smresponsibilities" target="_blank" rel="noopener noreferrer">Visit GitHub Profile ↗</a>

  <!-- Top-of-page Breadcrumbs (Tactic #88 & Tactic #98) -->
  <nav class="breadcrumb-nav" aria-label="Breadcrumb navigation">
    <a href="/">Home</a> <span>/</span>
    <a href="/projects/" aria-current="page">Projects</a>
  </nav>

  <section>
    <h2>Flagship & Case Studies</h2>
    <div class="grid">
      <article class="card">
        <span class="eyebrow">Kotlin / Jetpack Compose</span>
        <h3><a href="/projects/productivity-caller/">Productivity Caller</a></h3>
        <p>A native Android reminder application built with Kotlin and Jetpack Compose that uses automated phone calls to ensure urgent tasks are never ignored. Includes a pattern-based natural language parser for entering tasks.</p>
        <p><a href="/productivity-caller-simulator/">Launch Simulator ↗</a> · <a href="/projects/productivity-caller/">Read Case Study →</a> · <a href="/projects/productivity-caller-vs-alternatives/">Compare Alternatives →</a> · <a href="https://drive.google.com/file/d/1O9mQD-Qeo7GR40SdG440pdqSM8NdXV_K/view?usp=sharing" target="_blank" rel="noopener noreferrer">Watch Demo ↗</a></p>
      </article>

      <article class="card">
        <span class="eyebrow">Astro / Web Audio / CI</span>
        <h3><a href="/projects/sm-dex/">SM'S DEX</a></h3>
        <p>An open-source Pokédex developer portfolio built with Astro and zero-library Web Audio chiptune synthesis. Features 9 game-inspired device themes and a public community roster automated via GitHub Actions.</p>
        <p><a href="/">Launch App ↗</a> · <a href="/projects/sm-dex/">Read Case Study →</a> · <a href="https://github.com/smresponsibilities/smresponsibilities.github.io" target="_blank" rel="noopener noreferrer">View Source ↗</a></p>
      </article>

      <article class="card">
        <span class="eyebrow">Solidity / MERN / Gemini AI</span>
        <h3><a href="/projects/chaincode/">Chaincode</a></h3>
        <p>Web3 coding platform that validates code originality using Google Gemini AI with 95%+ accuracy and mints validated solutions as NFTs on blockchain. Placed 3rd out of 200+ competing engineering teams.</p>
        <p><a href="https://chain-code.vercel.app" target="_blank" rel="noopener noreferrer">Launch App ↗</a> · <a href="/projects/chaincode/">Read Case Study →</a> · <a href="https://github.com/smresponsibilities/Chain-Code" target="_blank" rel="noopener noreferrer">View Repository ↗</a></p>
      </article>

      <article class="card">
        <span class="eyebrow">React / WebSockets</span>
        <h3>QuizDeck</h3>
        <p>High-concurrency multiplayer quiz engine built with React and WebSockets. Stress-tested to support up to 500 concurrent players with an average response latency of 31 milliseconds.</p>
        <p><a href="https://github.com/smresponsibilities/QuizDeck" target="_blank" rel="noopener noreferrer">View Repository ↗</a></p>
      </article>
    </div>
  </section>

  <section>
    <h2>Data Platforms & Automated Tools</h2>
    <div class="grid">
      <article class="card">
        <span class="eyebrow">Next.js 15 / Supabase / Recharts</span>
        <h3>Shopify Insights</h3>
        <p>E-commerce analytics & customer segmentation dashboard built with Next.js 15, React 19, Supabase PostgreSQL, and Recharts tracking customer lifetime value (LTV) and cohort retention.</p>
        <p><a href="https://xeno2-df3z.vercel.app" target="_blank" rel="noopener noreferrer">Launch App ↗</a> · <a href="https://github.com/smresponsibilities/Xeno2" target="_blank" rel="noopener noreferrer">View Repository ↗</a></p>
      </article>

      <article class="card">
        <span class="eyebrow">TypeScript / ClickHouse / SQL</span>
        <h3>ClickHouse Data Ingestion Tool</h3>
        <p>A web-based data engineering tool facilitating bidirectional data pipelines between ClickHouse OLAP databases and flat CSV files with real-time schema mapping and batch export.</p>
        <p><a href="https://github.com/smresponsibilities/Ingestion-Tool" target="_blank" rel="noopener noreferrer">View Repository ↗</a></p>
      </article>

      <article class="card">
        <span class="eyebrow">Python / XGBoost / Flask / ML</span>
        <h3>Fertilizer Recommendation API</h3>
        <p>Production machine learning microservice deployed on Render predicting optimal agricultural fertilizer formulations from soil chemistry (NPK), moisture, and climate metrics via an XGBoost pipeline.</p>
        <p><a href="https://fertilizertypebysm.onrender.com/" target="_blank" rel="noopener noreferrer">Launch App ↗</a> · <a href="https://github.com/smresponsibilities/fertilizertypeapi" target="_blank" rel="noopener noreferrer">View Repository ↗</a></p>
      </article>

      <article class="card">
        <span class="eyebrow">TypeScript / Node.js / ATS Scraping</span>
        <h3>JobScraper Hourly</h3>
        <p>Automated crawler delivering hourly email alerts for entry-level and remote software engineering roles pulled directly from company ATS boards without paid proxies or database overhead.</p>
        <p><a href="https://github.com/smresponsibilities/jobscraper_hourly" target="_blank" rel="noopener noreferrer">View Repository ↗</a></p>
      </article>
    </div>
  </section>

  <section>
    <h2>Web Applications, Systems & Algorithms</h2>
    <div class="grid">
      <article class="card">
        <span class="eyebrow">TypeScript / Canvas / Aviation Math</span>
        <h3><a href="/projects/flight-sun-tracker/">Flight Sun Tracker</a></h3>
        <p>A specialized interactive web tool visualizing aircraft flight paths and computing solar elevation relative to passenger seating, enabling travelers to pick shade or direct sunlight.</p>
        <p><a href="https://flight-sun-tracker-shivam-mahajans-projects.vercel.app" target="_blank" rel="noopener noreferrer">Launch App ↗</a> · <a href="/projects/flight-sun-tracker/">Read Case Study →</a> · <a href="https://github.com/smresponsibilities/flight-sun-tracker" target="_blank" rel="noopener noreferrer">View Repository ↗</a></p>
      </article>

      <article class="card">
        <span class="eyebrow">JavaScript / Fetch API / LocalStorage</span>
        <h3><a href="/projects/postie/">Postie</a></h3>
        <p>A zero-install browser-based API testing client and Postman alternative with multi-method HTTP dispatch, dynamic query/header editors, and persistent local history.</p>
        <p><a href="https://shivammahajan.com/Postie/" target="_blank" rel="noopener noreferrer">Launch App ↗</a> · <a href="/projects/postie/">Read Case Study →</a> · <a href="https://github.com/smresponsibilities/Postie" target="_blank" rel="noopener noreferrer">View Repository ↗</a></p>
      </article>

      <article class="card">
        <span class="eyebrow">JavaScript / HTML5 / LocalStorage</span>
        <h3>TaskFlow &amp; Daily Quotes</h3>
        <p>A zero-framework client-side productivity dashboard and task manager with instant task categorization, completion tracking, daily motivational quotes, and persistent browser storage.</p>
        <p><a href="https://shivammahajan.com/FEETODOWEBSITE/" target="_blank" rel="noopener noreferrer">Launch App ↗</a> · <a href="https://github.com/smresponsibilities/FEETODOWEBSITE" target="_blank" rel="noopener noreferrer">View Repository ↗</a></p>
      </article>

      <article class="card">
        <span class="eyebrow">Python / Terminal ASCII / Arcade</span>
        <h3>Python Game Arcade</h3>
        <p>Interactive command-line gaming arcade with five classic mini-games: Hangman with procedural ASCII gallows, Stone Paper Scissors, Number Guesser, Coinflip, and Diceroll with virtual coin economies.</p>
        <p><a href="https://shivammahajan.com/Gamehub/" target="_blank" rel="noopener noreferrer">Launch App ↗</a> · <a href="https://github.com/smresponsibilities/Gamehub" target="_blank" rel="noopener noreferrer">View Repository ↗</a></p>
      </article>

      <article class="card">
        <span class="eyebrow">Rust / Low-Level OS Hooks</span>
        <h3>Clickless</h3>
        <p>Keyboard-driven pointer navigation tool written in Rust. Utilizes an on-screen target grid and keyboard modifier taps for mouseless cursor movement, clicking, and scrolling.</p>
        <p><a href="https://github.com/smresponsibilities/clickless" target="_blank" rel="noopener noreferrer">View Repository ↗</a></p>
      </article>

      <article class="card">
        <span class="eyebrow">C / Terminal ANSI</span>
        <h3><a href="/projects/wordle/">Terminal Wordle</a></h3>
        <p>Low-level C recreation of Wordle designed for terminal execution with dictionary parsing, color-coded ANSI character feedback, and algorithmic guess evaluation.</p>
        <p><a href="https://shivammahajan.com/Wordle/" target="_blank" rel="noopener noreferrer">Launch App ↗</a> · <a href="/wordle-simulator/">Launch Simulator ↗</a> · <a href="/projects/wordle/">Read Case Study →</a> · <a href="https://github.com/smresponsibilities/Wordle" target="_blank" rel="noopener noreferrer">View Repository ↗</a></p>
      </article>

      <article class="card">
        <span class="eyebrow">Python / DSA / LeetCode</span>
        <h3>2002 Days of Code Challenge</h3>
        <p>Ongoing multi-year algorithmic consistency challenge. Over 1,246+ consecutive days, 2,600+ solved algorithmic problems, and 425+ test suites across Python, Kotlin, and Java.</p>
        <p><a href="/blog/">Explore Daily Journal →</a> · <a href="https://github.com/smresponsibilities/1001daysofcode" target="_blank" rel="noopener noreferrer">View Repository ↗</a></p>
      </article>
    </div>
  </section>
</EditorialShell>

<style>
  .breadcrumb-nav {
    display: flex;
    gap: 8px;
    align-items: center;
    font-size: 13px;
    color: var(--dim, #888);
    margin-bottom: 14px;
    flex-wrap: wrap;
  }
  .breadcrumb-nav a {
    color: var(--time-accent, #ffd75e);
    text-decoration: none;
  }
  .breadcrumb-nav a:hover {
    text-decoration: underline;
  }
</style>
