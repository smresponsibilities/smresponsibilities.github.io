      height: 80px;
    }

    .pkm-century-watermark {
      font-size: 48px;
      top: -16px;
      right: 12px;
    }

    .pkm-century-title {
      font-size: 18px;
    }

    .pkm-days-grid {
      grid-template-columns: 1fr;
    }

    .pkm-century-actions {
      flex-direction: column;
      align-items: stretch;
    }

    .pkm-btn-archive {
      justify-content: center;
    }
  }
</style>

<script>
  function initScrollTimeline() {
    const root = document.getElementById('pkm-scroll-root');
    const nav = document.getElementById('pkm-sticky-nav');
    const stream = document.getElementById('pkm-timeline-stream');
    const track = document.getElementById('pkm-rail-track');
    const viewport = document.getElementById('pkm-rail-viewport');
    const progress = document.getElementById('pkm-rail-progress');
    const readout = document.getElementById('pkm-active-readout');

    if (!root || !nav || !stream || !track) return;

    const rootEl = root;
    const streamEl = stream;
    const trackEl = track;
    const progressEl = progress;
    const readoutEl = readout;
    const viewportEl = viewport;

    const nodes = Array.from(trackEl.querySelectorAll<HTMLButtonElement>('.pkm-century-node'));
    const sections = Array.from(streamEl.querySelectorAll<HTMLElement>('.pkm-century-section'));

    const orderLatestBtn = document.getElementById('pkm-order-latest-btn');
    const orderOriginBtn = document.getElementById('pkm-order-origin-btn');
    const jumpDay1Btn = document.getElementById('pkm-jump-day1');
    const jumpLatestBtn = document.getElementById('pkm-jump-latest');

    let activeLo = 1201;

    function setActiveCentury(lo: number, scrollNav = true) {
      activeLo = lo;
      const targetSection = sections.find(s => parseInt(s.getAttribute('data-lo') || '0', 10) === lo);
      const targetNode = nodes.find(n => parseInt(n.getAttribute('data-lo') || '0', 10) === lo);

      // Highlight active node
      nodes.forEach(n => {
        const isAct = parseInt(n.getAttribute('data-lo') || '0', 10) === lo;
        n.classList.toggle('is-active', isAct);
        n.setAttribute('aria-pressed', isAct ? 'true' : 'false');
      });

      // Highlight active section
      sections.forEach(s => {
        const isAct = parseInt(s.getAttribute('data-lo') || '0', 10) === lo;
        s.classList.toggle('is-active-section', isAct);
      });

      // Update active readout text
      if (readoutEl && targetSection) {
        const titleEl = targetSection.querySelector('.pkm-century-title');
        const daysEl = targetSection.querySelector('.pill-days');
        const title = titleEl ? titleEl.textContent : '';
        const days = daysEl ? daysEl.textContent : '';
        readoutEl.textContent = `${days} · ${title}`;
      }

      // Update progress bar
      if (progressEl && targetNode) {
        const trackRect = trackEl.getBoundingClientRect();
        const nodeRect = targetNode.getBoundingClientRect();
        const pct = Math.max(0, Math.min(100, ((nodeRect.left - trackRect.left + (nodeRect.width / 2)) / trackRect.width) * 100));
        progressEl.style.width = `${pct}%`;
      }

      // Center active node in viewport
      if (scrollNav && targetNode && viewportEl) {
        const targetLeft = targetNode.offsetLeft - (viewportEl.clientWidth / 2) + (targetNode.clientWidth / 2);
        viewportEl.scrollTo({ left: targetLeft, behavior: 'smooth' });
      }
    }

    function scrollToSection(lo: number) {
      const sec = document.getElementById(`century-${lo}`);
      if (sec) {
        sec.scrollIntoView({ behavior: 'smooth', block: 'start' });
        setActiveCentury(lo, true);
      }
    }

    // Node click binding
    nodes.forEach(n => {
      n.addEventListener('click', () => {
        const lo = parseInt(n.getAttribute('data-lo') || '0', 10);
        scrollToSection(lo);
      });
    });

    // Jump Buttons
    jumpDay1Btn?.addEventListener('click', () => scrollToSection(1));
    jumpLatestBtn?.addEventListener('click', () => scrollToSection(1201));

    // Order Switcher
    function setOrder(order: 'latest' | 'origin') {
      rootEl.setAttribute('data-order', order);

      if (order === 'latest') {
        orderLatestBtn?.classList.add('is-active');
        orderLatestBtn?.setAttribute('aria-pressed', 'true');
        orderOriginBtn?.classList.remove('is-active');
        orderOriginBtn?.setAttribute('aria-pressed', 'false');

        // Reorder stream sections: 1201 down to 1
        const sortedSec = [...sections].sort((a, b) => {
          return parseInt(b.getAttribute('data-lo') || '0', 10) - parseInt(a.getAttribute('data-lo') || '0', 10);
        });
        sortedSec.forEach(s => streamEl.appendChild(s));

        // Reorder top nodes: 1201 down to 1
        const sortedNodes = [...nodes].sort((a, b) => {
          return parseInt(b.getAttribute('data-lo') || '0', 10) - parseInt(a.getAttribute('data-lo') || '0', 10);
        });
        sortedNodes.forEach(n => trackEl.appendChild(n));

        setActiveCentury(1201, true);
      } else {
        orderOriginBtn?.classList.add('is-active');
        orderOriginBtn?.setAttribute('aria-pressed', 'true');
        orderLatestBtn?.classList.remove('is-active');
        orderLatestBtn?.setAttribute('aria-pressed', 'false');

        // Normal chronological order: 1 up to 1201
        const sortedSec = [...sections].sort((a, b) => {
          return parseInt(a.getAttribute('data-lo') || '0', 10) - parseInt(b.getAttribute('data-lo') || '0', 10);
        });
        sortedSec.forEach(s => streamEl.appendChild(s));

        // Normal chronological top nodes: 1 up to 1201
        const sortedNodes = [...nodes].sort((a, b) => {
          return parseInt(a.getAttribute('data-lo') || '0', 10) - parseInt(b.getAttribute('data-lo') || '0', 10);
        });
        sortedNodes.forEach(n => trackEl.appendChild(n));

        setActiveCentury(1, true);
      }
    }

    orderLatestBtn?.addEventListener('click', () => setOrder('latest'));
    orderOriginBtn?.addEventListener('click', () => setOrder('origin'));

    // IntersectionObserver to sync scroll position with top navigation rail
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const lo = parseInt(entry.target.getAttribute('data-lo') || '0', 10);
          setActiveCentury(lo, true);
        }
      });
    }, {
      rootMargin: '-20% 0px -55% 0px',
      threshold: 0.1
    });

    sections.forEach(s => observer.observe(s));

    // Default to latest first
    setOrder('latest');
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initScrollTimeline);
  } else {
    initScrollTimeline();
  }
  document.addEventListener('astro:page-load', initScrollTimeline);
</script>
