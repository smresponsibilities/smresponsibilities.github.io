  /* Responsive Rules */
  @media (max-width: 760px) {
    .pkm-sticky-century-nav {
      padding: 10px 12px;
    }

    .pkm-sticky-nav-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
    }

    .pkm-nav-controls {
      width: 100%;
      justify-content: space-between;
    }

    .pkm-timeline-stream {
      padding-left: 24px;
      gap: 30px;
    }

    .pkm-stream-spine {
      left: 11px;
    }

    .pkm-spine-node {
      left: -24px;
      width: 24px;
    }

    .pkm-pokeball-pin {
      width: 18px;
      height: 18px;
    }

    .pkm-century-card {
