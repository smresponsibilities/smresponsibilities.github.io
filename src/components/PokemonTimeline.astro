---
import posts from '../data/linkedin-posts.json';

// Metadata for the 13 100-day chapters
const pokemonChapters = [
  { era: 'Gen I · Kanto', pokemon: 'Pikachu', id: 25, type: 'Electric', title: 'Genesis & First Algorithms', desc: 'The historic launch of #1001DaysOfCode alongside Shivanshu. Laid foundations in daily problem-solving, Python recursion, and early C++ loop mechanics.', tags: ['Python', 'DSA Basics', '1001 Days Launch', 'C++ Loop Mechanics'] },
  { era: 'Gen II · Johto', pokemon: 'Cyndaquil', id: 155, type: 'Fire', title: 'Data Structures & C++ Shift', desc: 'Accelerated problem-solving with C++ as the primary engine. Mastered arrays, string manipulations, Ransom Note, and early LeetCode patterns.', tags: ['C++', 'Arrays', 'String Manipulation', 'LeetCode Grinding'] },
  { era: 'Gen III · Hoenn', pokemon: 'Torchic', id: 255, type: 'Fire', title: 'Complexity Analysis & Monotonic Structures', desc: 'Shifted focus to strict time complexity targets: O(n), O(n²), and O(n log n). Deep dive into monotonic stacks, parentheses matching, and subarray logic.', tags: ['Time Complexity', 'Parentheses Validation', 'Subarrays', 'Monotonic Stack'] },
  { era: 'Gen IV · Sinnoh', pokemon: 'Piplup', id: 393, type: 'Water', title: 'Bit Manipulation & Pandas Automation', desc: 'Expanded into bitwise optimizations, binary representation puzzles, and pandas data manipulation, balancing systems thinking with analytical tools.', tags: ['Bit Manipulation', 'Binary Logic', 'Pandas Rows', 'Data Automation'] },
  { era: 'Gen V · Unova', pokemon: 'Snivy', id: 495, type: 'Grass', title: 'Halfway Mark & Combinatorics', desc: 'Crossing the 400 and 500-day thresholds. Solved pair permutations, modular arithmetic, and daily problem-solving during heavy travel without breaking streak.', tags: ['Combinatorics', 'Modular Math', 'Day 500 Halfway', 'Streak Discipline'] },
  { era: 'Gen VI · Kalos', pokemon: 'Froakie', id: 656, type: 'Water', title: 'Frequency Counters & Trees', desc: 'Heavy utilization of hash counters, frequency maps, tree traversals, and dynamic programming memoization.', tags: ['Counter DS', 'Hash Tables', 'Binary Trees', 'Memoization'] },
  { era: 'Gen VII · Alola', pokemon: 'Rowlet', id: 722, type: 'Grass', title: 'Contests & Algorithmic Speed', desc: 'Stepping into LeetCode Weekly and Biweekly contests. Benchmarking real-time problem-solving speed and algorithmic precision under strict clock pressure.', tags: ['Weekly Contests', 'Contest Rating', 'Greedy Choices', 'Rank Climbing'] },
  { era: 'Gen VIII · Galar', pokemon: 'Scorbunny', id: 813, type: 'Fire', title: 'Multi-Language Mastery & Heaps', desc: 'Compiling structured study guides for heaps, sliding windows, and binary search. Cross-implementing algorithms in Python, Java, and C++.', tags: ['Heaps', 'Sliding Window', 'Binary Search Guide', 'Polyglot Coding'] },
  { era: 'Gen IX · Paldea', pokemon: 'Sprigatito', id: 906, type: 'Grass', title: '100% Non-Premium Easy Algorithms Cleared', desc: 'Historic milestone on Day 801: completed every single non-premium Easy algorithm on LeetCode! Transitioned fully into Medium and Hard problem sets.', tags: ['All Easy Cleared', 'Mediums Transition', 'Graph BFS/DFS', 'Milestone 800'] },
  { era: 'Ultra Apex', pokemon: 'Mewtwo', id: 150, type: 'Psychic', title: 'Dynamic Programming & Millennium Approach', desc: 'Classic DP progressions (Frog Jump, Secret Propagation). Approaching the mythical 1,001st day of the original commitment with zero days missed.', tags: ['Dynamic Programming', 'State Transitions', 'Approaching Day 1000', 'Zero Missed Days'] },
  { era: 'Time Origin', pokemon: 'Dialga', id: 483, type: 'Steel/Dragon', title: 'Crossing 1,001 into the 2,002 Quest', desc: 'Achieved the original 1,001-day pledge and immediately doubled down: aiming for 2,002 Days of Code. Advanced graph theory and interval scheduling.', tags: ['Day 1001 Accomplished', '2002 Quest Begins', 'Intervals', 'Interval Trees'] },
  { era: 'Systems Core', pokemon: 'Arceus', id: 493, type: 'Normal', title: 'High-Velocity Arrays & Systems Engineering', desc: 'Solving array reverses, bit operations, and streaming event pipelines in minutes. Building real-time distributed platforms and test infrastructure.', tags: ['High-Velocity Solves', 'Event Streams', 'System Architecture', 'Kafka Pipelines'] },
  { era: 'Apex Era', pokemon: 'Koraidon', id: 1007, type: 'Fighting/Dragon', title: 'Production Platforms & 425+ Test Suites', desc: 'Morgan Stanley CIAM warehouse apprenticeship, 5M+ Kafka events with zero row-count tolerance, pure C Wordle simulator, and the Pokédex portfolio.', tags: ['Morgan Stanley CIAM', 'Kafka / PySpark', 'Pure C Wordle', 'Dex Portfolio'] }
];

const maxDay = Math.max(...posts.map(p => p.day));

const chapters = [];
for (let i = 0; i < 13; i++) {
  const lo = i * 100 + 1;
  const hi = lo + 99;
  const bPosts = posts.filter(p => p.day >= lo && p.day <= hi);
  bPosts.sort((a, b) => a.day - b.day);
  const minDate = bPosts[0]?.date || '';
  const maxDate = bPosts[bPosts.length - 1]?.date || '';
  const meta = pokemonChapters[i];
  
  // Pick 3 memorable or highlight days for this chapter
  let rawSampleDays: any[] = bPosts.filter((p: any) => p.milestone || p.easterEgg);
  if (rawSampleDays.length === 0) {
    rawSampleDays = [bPosts[0], bPosts[Math.floor(bPosts.length / 2)], bPosts[bPosts.length - 1]].filter(Boolean);
  } else if (rawSampleDays.length < 3) {
    const extras = [bPosts[0], bPosts[bPosts.length - 1]].filter(Boolean);
    for (const ex of extras) {
      if (!rawSampleDays.some((s: any) => s.day === ex.day)) rawSampleDays.push(ex);
    }
  }
  rawSampleDays.sort((a: any, b: any) => b.day - a.day); // latest first
  const sampleDays = rawSampleDays.slice(0, 3).map((p: any) => {
    let t = String(p.content || p.text || '').replace(/[\r\n]+/g, ' ').replace(/\s+/g, ' ').trim();
    if (t.length > 95) t = t.slice(0, 92) + '…';
    return {
      day: p.day,
      date: p.date,
      note: p.milestone || p.easterEgg || t,
    };
  });

  const monthNames = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
  const dObj = minDate ? new Date(minDate) : new Date();
  const startMonth = monthNames[dObj.getMonth()] || 'May';
  const startYear = dObj.getFullYear() || 2023;

  const endDObj = maxDate ? new Date(maxDate) : new Date();
  const endMonth = monthNames[endDObj.getMonth()] || 'Aug';
  const endYear = endDObj.getFullYear() || 2023;

  const centuryMilestone = i === 12 ? `${maxDay}+` : String(hi);

  chapters.push({
    index: i,
    chapterNum: i + 1,
    centuryMilestone,
    lo,
    hi,
    archiveSlug: `${lo}-${i === 12 ? '1300' : hi}`,
    label: `Days ${lo} – ${i === 12 ? maxDay + '+' : hi}`,
    count: bPosts.length,
    dateRange: `${startMonth} ${startYear} – ${endMonth} ${endYear}`,
    startMonth,
    startYear,
    ...meta,
    sampleDays,
    imgUrl: `https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/${meta.id}.png`
  });
}
---

<div class="pkm-scroll-timeline-root" id="pkm-scroll-root" data-order="latest" data-active-index="12">
  <!-- ALL CENTURIES AT THE TOP: Sticky Century Navigation Rail (Viktor Scroll Timeline pattern) -->
  <nav class="pkm-sticky-century-nav" id="pkm-sticky-nav" aria-label="Timeline Centuries Navigation">
    <div class="pkm-sticky-nav-header">
      <div class="pkm-nav-title-group">
        <span class="pkm-nav-status-dot" aria-hidden="true"></span>
        <span class="pkm-nav-heading">ALL CENTURIES DIRECTORY</span>
        <span class="pkm-nav-active-readout" id="pkm-active-readout">Day 1201 – {maxDay}+ · Apex Era</span>
      </div>

      <div class="pkm-nav-controls">
        <div class="pkm-order-switch" role="group" aria-label="Sort direction">
          <button
            type="button"
            class="pkm-switch-btn is-active"
            id="pkm-order-latest-btn"
            data-order="latest"
            aria-pressed="true"
          >
            ⚡ Latest (Day {maxDay} → 1)
          </button>
          <button
            type="button"
            class="pkm-switch-btn"
            id="pkm-order-origin-btn"
            data-order="origin"
            aria-pressed="false"
          >
            🌱 Day 1 (Day 1 → {maxDay})
          </button>
        </div>

        <div class="pkm-quick-jumps">
          <button type="button" class="pkm-jump-chip" id="pkm-jump-day1" title="Jump to Day 1–100">Day 1</button>
          <button type="button" class="pkm-jump-chip" id="pkm-jump-latest" title="Jump to Day 1201+">Latest</button>
        </div>
      </div>
    </div>

    <!-- The Horizontal Century Rail containing ALL 13 centuries at the top -->
    <div class="pkm-rail-viewport" id="pkm-rail-viewport">
      <div class="pkm-rail-track" id="pkm-rail-track">
        <!-- Connecting Track Line -->
        <div class="pkm-rail-line" aria-hidden="true">
          <div class="pkm-rail-progress" id="pkm-rail-progress"></div>
        </div>

        {chapters.map((ch) => (
          <button
            type="button"
            class:list={['pkm-century-node', { 'is-active': ch.index === 12 }]}
            id={`pkm-node-${ch.lo}`}
            data-lo={ch.lo}
            data-index={ch.index}
            aria-label={`Jump to Century ${ch.chapterNum}: Days ${ch.lo} to ${ch.hi}`}
            title={`Century ${ch.chapterNum}: ${ch.label} (${ch.pokemon})`}
          >
            <div class="pkm-node-bullet">
              <span class="pkm-bullet-core"></span>
            </div>
            <span class="pkm-node-label">{ch.centuryMilestone}</span>
            <span class="pkm-node-sub">{ch.era.split('·')[0].trim()}</span>
          </button>
        ))}
      </div>
    </div>
  </nav>

  <!-- SCROLL TIMELINE: Vertical Stream with Central Spine & Century Milestones -->
  <div class="pkm-timeline-stream" id="pkm-timeline-stream">
    <!-- Pokédex Central Spine Line -->
    <div class="pkm-stream-spine" aria-hidden="true">
      <div class="pkm-spine-glow"></div>
    </div>

    {chapters.map((ch) => (
      <section
        class:list={['pkm-century-section', { 'is-active-section': ch.index === 12 }]}
        id={`century-${ch.lo}`}
        data-lo={ch.lo}
        data-index={ch.index}
        aria-labelledby={`heading-${ch.lo}`}
      >
        <!-- Big Watermark Century Milestone Number (Scroll Timeline style) -->
        <div class="pkm-century-watermark" aria-hidden="true">{ch.centuryMilestone}</div>

        <!-- Timeline Node Connection -->
        <div class="pkm-spine-node" aria-hidden="true">
          <div class="pkm-pokeball-pin">
            <span class="pkm-pin-red"></span>
            <span class="pkm-pin-band"><span class="pkm-pin-eye"></span></span>
            <span class="pkm-pin-white"></span>
          </div>
        </div>

        <!-- Century Card Deck -->
        <article class="pkm-century-card">
          <!-- Corner Screw Rivets -->
          <div class="pkm-card-rivet rivet-tl" aria-hidden="true"></div>
          <div class="pkm-card-rivet rivet-tr" aria-hidden="true"></div>
          <div class="pkm-card-rivet rivet-bl" aria-hidden="true"></div>
          <div class="pkm-card-rivet rivet-br" aria-hidden="true"></div>

          <!-- Card Header -->
          <header class="pkm-century-header">
            <div class="pkm-meta-tags">
              <span class="pkm-tag-pill pill-chapter">CENTURY {ch.chapterNum}</span>
              <span class="pkm-tag-pill pill-era">{ch.era}</span>
              <span class="pkm-tag-pill pill-days">{ch.label}</span>
              <span class="pkm-tag-pill pill-count">{ch.count} ENTRIES</span>
            </div>
            <h3 class="pkm-century-title" id={`heading-${ch.lo}`}>{ch.title}</h3>
            <div class="pkm-century-subtitle">
              <span class="pkm-date-span">📅 {ch.dateRange}</span>
              <span class="pkm-mascot-span">Mascot: <strong>{ch.pokemon}</strong> ({ch.type})</span>
            </div>
          </header>

          <!-- Card Content Body -->
          <div class="pkm-century-content">
            <!-- Left: Mascot Showcase -->
            <div class="pkm-mascot-showcase">
              <div class="pkm-pedestal-glow" aria-hidden="true"></div>
              <img
                src={ch.imgUrl}
                alt={`${ch.pokemon} artwork`}
                width="150"
                height="150"
                loading="lazy"
                decoding="async"
                class="pkm-mascot-img"
                onerror="this.style.opacity='0.2'"
              />
              <span class="pkm-mascot-name">{ch.pokemon}</span>
            </div>

            <!-- Right: Details & Milestones -->
            <div class="pkm-details-col">
              <p class="pkm-century-desc">{ch.desc}</p>

              <!-- Disciplines / Tags -->
              <div class="pkm-disciplines-row">
                <span class="pkm-disciplines-label">FOCUS AREAS:</span>
                <div class="pkm-disciplines-tags">
                  {ch.tags.map((t) => (
                    <span class="pkm-chip">{t}</span>
                  ))}
                </div>
              </div>

              <!-- Notable Day Logs -->
              <div class="pkm-notable-days">
                <span class="pkm-notable-heading">KEY MILESTONES & LOGS:</span>
                <div class="pkm-days-grid">
                  {ch.sampleDays.map((s) => (
                    <a href={`/blog/day-${s.day}/`} class="pkm-day-chip" title={`Read Day ${s.day} log`}>
                      <div class="pkm-day-chip-top">
                        <span class="pkm-chip-day">DAY {s.day}</span>
                        <time class="pkm-chip-date">{s.date}</time>
                      </div>
                      <p class="pkm-chip-note">{s.note}</p>
                      <span class="pkm-chip-arrow" aria-hidden="true">Read Log →</span>
                    </a>
                  ))}
                </div>
              </div>

              <!-- Actions -->
              <div class="pkm-century-actions">
                <a href={`/blog/archive/${ch.archiveSlug}/`} class="pkm-btn-archive">
                  <span>Explore Full {ch.label} Archive ({ch.count} Posts)</span>
                  <span aria-hidden="true">↗</span>
                </a>
                <div class="pkm-secondary-links">
                  <a href="/blog/timeline/" class="pkm-link-sub">Full Timeline →</a>
                  <a href="/blog/milestones/" class="pkm-link-sub">All Milestones →</a>
                </div>
              </div>
            </div>
          </div>
        </article>
      </section>
    ))}
  </div>
</div>

<style>
  /* -------------------------------------------------------------
     POKÉMON SCROLL TIMELINE (VIKTOR SCROLL TIMELINE PATTERN)
     ------------------------------------------------------------- */
  .pkm-scroll-timeline-root {
    --pkm-red: #ef4444;
    --pkm-crimson: #991b1b;
    --pkm-electric: #F7D02C;
    --pkm-cyan: #38bdf8;
    --pkm-border: rgba(223, 246, 255, 0.16);
    --pkm-border-lit: rgba(247, 208, 44, 0.4);
    --pkm-card-bg: #090e17;
    --pkm-rail-bg: rgba(9, 14, 23, 0.94);
    width: 100%;
    margin: 28px 0 44px;
    position: relative;
    font-family: var(--font-body, "Departure Mono", monospace);
    box-sizing: border-box;
  }

  /* -------------------------------------------------------------
     STICKY TOP NAVIGATION: ALL CENTURIES DIRECTORY
     ------------------------------------------------------------- */
  .pkm-sticky-century-nav {
    position: sticky;
    top: 14px;
    z-index: 50;
    width: 100%;
    background: var(--pkm-rail-bg);
    border: 1px solid var(--pkm-border);
    border-radius: 14px;
    padding: 12px 18px 14px;
    backdrop-filter: blur(12px) saturate(140%);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.55), inset 0 1px 0 rgba(255, 255, 255, 0.08);
    margin-bottom: 32px;
  }

  .pkm-sticky-nav-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-bottom: 12px;
    border-bottom: 1px solid rgba(223, 246, 255, 0.1);
    margin-bottom: 12px;
  }

  .pkm-nav-title-group {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .pkm-nav-status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 8px #22c55e;
  }

  .pkm-nav-heading {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: #94a3b8;
    text-transform: uppercase;
  }

  .pkm-nav-active-readout {
    font-size: 12px;
    font-weight: 700;
    color: var(--pkm-electric);
    background: rgba(247, 208, 44, 0.12);
    border: 1px solid rgba(247, 208, 44, 0.3);
    padding: 3px 8px;
    border-radius: 4px;
    letter-spacing: 0.03em;
  }

  .pkm-nav-controls {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .pkm-order-switch {
    display: inline-flex;
    background: #050811;
    border: 1px solid var(--pkm-border);
    border-radius: 8px;
    padding: 2px;
    gap: 3px;
  }

  .pkm-switch-btn {
    padding: 5px 12px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: #94a3b8;
    background: transparent;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.16s ease;
    font-family: inherit;
  }

  .pkm-switch-btn:hover {
    color: #f1f5f9;
    background: rgba(255, 255, 255, 0.06);
  }

  .pkm-switch-btn.is-active {
    color: #050811;
    background: var(--pkm-electric);
    box-shadow: 0 2px 8px rgba(247, 208, 44, 0.35);
  }

  .pkm-quick-jumps {
    display: flex;
    gap: 6px;
  }

  .pkm-jump-chip {
    padding: 5px 10px;
    font-size: 11px;
    font-weight: 700;
    color: #cbd5e1;
    background: #101726;
    border: 1px solid var(--pkm-border);
    border-radius: 6px;
    cursor: pointer;
    font-family: inherit;
    transition: all 0.15s ease;
  }

  .pkm-jump-chip:hover {
    color: #ffffff;
    border-color: var(--pkm-cyan);
    background: #17243a;
    transform: translateY(-1px);
  }

  /* -------------------------------------------------------------
     ALL CENTURIES RAIL (ALL 13 CENTURIES DISPLAYED AT THE TOP)
     ------------------------------------------------------------- */
  .pkm-rail-viewport {
    width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
    scrollbar-color: rgba(223, 246, 255, 0.2) transparent;
    padding: 6px 2px 2px;
  }

  .pkm-rail-viewport::-webkit-scrollbar {
    height: 4px;
  }

  .pkm-rail-viewport::-webkit-scrollbar-thumb {
    background: rgba(223, 246, 255, 0.25);
    border-radius: 2px;
  }

  .pkm-rail-track {
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: relative;
    min-width: 680px;
    padding: 6px 8px;
    gap: 4px;
  }

  /* Wire connecting all centuries */
  .pkm-rail-line {
    position: absolute;
    top: 14px;
    left: 20px;
    right: 20px;
    height: 3px;
    background: rgba(223, 246, 255, 0.15);
    z-index: 1;
    border-radius: 2px;
  }

  .pkm-rail-progress {
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, #ef4444, var(--pkm-electric));
    border-radius: 2px;
    transition: width 0.25s ease;
  }

  /* Century Node Buttons */
  .pkm-century-node {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    background: transparent;
    border: none;
    padding: 0 4px;
    cursor: pointer;
    font-family: inherit;
    transition: transform 0.16s ease, color 0.16s ease;
    flex: 1;
    min-width: 44px;
  }

  .pkm-century-node:hover {
    transform: translateY(-2px);
  }

  .pkm-node-bullet {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: #0f1726;
    border: 2px solid #64748b;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 6px;
    transition: all 0.2s ease;
  }

  .pkm-bullet-core {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #64748b;
    transition: all 0.2s ease;
  }

  .pkm-node-label {
    font-size: 11px;
    font-weight: 800;
    color: #94a3b8;
    letter-spacing: 0.02em;
    transition: color 0.18s ease;
    white-space: nowrap;
  }

  .pkm-node-sub {
    font-size: 9px;
    font-weight: 600;
    color: #64748b;
    margin-top: 2px;
    white-space: nowrap;
  }

  /* Active Century Node State */
  .pkm-century-node.is-active .pkm-node-bullet {
    border-color: var(--pkm-electric);
    background: #090e17;
    box-shadow: 0 0 10px rgba(247, 208, 44, 0.6);
    transform: scale(1.2);
  }

  .pkm-century-node.is-active .pkm-bullet-core {
    background: var(--pkm-electric);
    box-shadow: 0 0 6px var(--pkm-electric);
  }

  .pkm-century-node.is-active .pkm-node-label {
    color: #ffffff;
    font-weight: 800;
  }

  .pkm-century-node.is-active .pkm-node-sub {
    color: var(--pkm-cyan);
    font-weight: 700;
  }

  /* -------------------------------------------------------------
     SCROLL TIMELINE: VERTICAL STREAM
     ------------------------------------------------------------- */
  .pkm-timeline-stream {
    position: relative;
    padding-left: 36px;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  /* Vertical Spine Line */
  .pkm-stream-spine {
    position: absolute;
    top: 20px;
    bottom: 20px;
    left: 17px;
    width: 3px;
    background: rgba(223, 246, 255, 0.15);
    z-index: 1;
    border-radius: 2px;
  }

  .pkm-spine-glow {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, #ef4444 0%, var(--pkm-electric) 50%, #38bdf8 100%);
    opacity: 0.7;
    filter: blur(1px);
  }

  /* Individual Century Section */
  .pkm-century-section {
    position: relative;
    scroll-margin-top: 130px;
    transition: opacity 0.25s ease;
  }

  /* Watermark Century Number */
  .pkm-century-watermark {
    position: absolute;
    top: -24px;
    right: 18px;
    font-size: 80px;
    font-weight: 900;
    line-height: 1;
    color: rgba(223, 246, 255, 0.05);
    letter-spacing: -0.04em;
    pointer-events: none;
    user-select: none;
    z-index: 2;
    transition: color 0.25s ease;
  }

  .pkm-century-section.is-active-section .pkm-century-watermark {
    color: rgba(247, 208, 44, 0.1);
  }

  /* Spine Pokéball Pin */
  .pkm-spine-node {
    position: absolute;
    top: 28px;
    left: -36px;
    z-index: 5;
    width: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .pkm-pokeball-pin {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: #090e17;
    border: 2px solid #475569;
    position: relative;
    overflow: hidden;
    box-shadow: 0 0 10px rgba(0, 0, 0, 0.6);
    transition: all 0.22s ease;
  }

  .pkm-century-section.is-active-section .pkm-pokeball-pin {
    border-color: var(--pkm-electric);
    box-shadow: 0 0 14px rgba(247, 208, 44, 0.7);
    transform: scale(1.15);
