    }

    .pkm-century-content {
      grid-template-columns: 1fr;
      gap: 18px;
    }

    .pkm-mascot-showcase {
      flex-direction: row;
      justify-content: center;
      gap: 14px;
      padding: 10px;
    }

    .pkm-mascot-img {
