---
interface Props { name: string; stack: string; number: string; }
const { name, stack, number } = Astro.props;
const caller = name.toLowerCase().includes('productivity caller');
const flower = ['chrysanthemum','rose','peony','lotus','dahlia','poppy'][Math.max(0, Number(number) - 1) % 6];
---
<article class="project-card printed-project" data-project-name={name}>
  <header class="printed-header">
    <img src="/favicon-sm-complete.svg" alt="" width="32" height="32" />
    <h3>{name}</h3><span class="printed-number">PROJECT<strong>{number}</strong></span>
  </header>
  <div class="printed-body">
    <div class:list={['printed-art', { 'caller-art': caller }]} aria-hidden="true">
      <span class="printed-art-number">{number}</span>
      {caller ? <><div class="printed-wave">▎▍▌▊▌▍▎</div><div class="printed-phone"><div class="printed-phone-bar">09:41 <span>5G · 100%</span></div><div class="printed-phone-screen"><span class="printed-focus">FOCUS OVERRIDE</span><span class="printed-call-icon"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M7 3 4 5c-2 5 10 17 15 15l2-3-5-3-2 2c-3-1-5-3-6-6l2-2Z"/></svg></span><strong>Deep Work Block</strong><small>Priority 1 · Ringing…</small><span class="printed-answer">ANSWER CALL</span></div></div></> : <div class="printed-console"><div class="printed-console-bar"><i></i><i></i><i></i></div><img src="/favicon-sm-complete.svg" alt="" width="64" height="64" /><strong>{name}</strong><span>{stack}</span><div class="printed-code-lines"><b></b><b></b><b></b><b></b></div></div>}
      <span class="printed-art-caption">{name} / {stack.split('/')[0]}</span>
    </div>
    <div class="printed-paper">
      <p class="printed-meta">{stack}<span>SHIVAM MAHAJAN</span></p>
      {caller && <p class="printed-headline">Reminders.<br/><em>With a ringtone.</em></p>}
      <div class="printed-details"><slot name="summary" />
        {caller && <div class="printed-features"><div><span>01</span><p><strong>Scheduled to ring.</strong><br/>Task reminders use Android alarms and full-screen notifications.</p></div><div><span>02</span><p><strong>Built for Android.</strong><br/>A dedicated incoming-call screen for scheduled tasks.</p></div></div>}
        <slot />
      </div>
    </div>
  </div>
  <footer class="printed-footer"><span>DESIGNED & BUILT BY SHIVAM MAHAJAN</span><img src="/favicon-sm-complete.svg" alt="" width="16" height="16" /></footer>
  <div class="chapter-flowers printed-flowers" aria-hidden="true"><img class="flower-tr" src={`/floral/${flower}.svg`} alt="" width="150" height="150" loading="lazy"/><img class="flower-bl" src={`/floral/${flower}.svg`} alt="" width="150" height="150" loading="lazy"/></div>
</article>
<style is:global>
.printed-project.site-card,.printed-project{display:block!important;padding:12px!important;background:linear-gradient(135deg,#3b3735,#242428 35%,#29282b 70%,#494037)!important;border:1px solid #8e8172!important;border-radius:16px;box-shadow:inset 0 0 0 5px #292729,inset 0 0 0 6px #bc9d6a55,0 18px 32px #0005;font-family:Arial,sans-serif;color:#eae3d8;position:relative;isolation:isolate;overflow:hidden}
.printed-header{display:flex;align-items:center;gap:18px;min-height:74px;padding:12px 20px 20px!important}.printed-header img{flex-shrink:0}.printed-header h3{font:600 clamp(20px,2.5vw,27px)/1.15 Arial,sans-serif!important;letter-spacing:-.035em!important;margin:0!important;color:#eee8dc!important}.printed-number{margin-left:auto;padding-right:120px;text-align:right;font:10px/1.5 monospace;color:#c8b6a1;letter-spacing:.1em}.printed-number strong{display:block;font:26px/1 Georgia,serif;color:#d6b299}
.printed-body{display:grid;grid-template-columns:46% 54%;min-height:430px;border:1px solid #d5b48655;border-radius:4px;overflow:hidden;box-shadow:0 6px 14px #0005}.printed-art{position:relative;overflow:hidden;background:radial-gradient(ellipse at 45% 35%,#385057,#172c32 70%);display:grid;place-items:center;min-width:0;padding:45px 20px 50px}.printed-art-number{position:absolute;top:22px;right:18px;font:80px/1 Georgia,serif;letter-spacing:-.06em;color:#d9e1d00b}.printed-wave{position:absolute;left:22px;top:24px;color:#c6ac90;font-size:22px;letter-spacing:2px}.printed-phone{width:175px;height:310px;box-sizing:border-box;border:4px solid #586267;border-radius:30px;background:#18262c;transform:rotate(-8deg);box-shadow:15px 25px 30px #08141688;padding:15px 9px}.printed-phone-bar{font:9px monospace;color:#c6d1d0;display:flex;justify-content:space-between}.printed-phone-screen{height:245px;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#e9e9df;text-align:center}.printed-focus{font:7px monospace;background:#bc9d6a33;color:#e1c3a2;padding:3px 5px}.printed-call-icon{display:grid;place-items:center;width:44px;height:44px;margin:37px 0 12px;border:1px solid #c1a184;border-radius:50%;font-size:26px;color:#d9bc9e}.printed-phone-screen strong{font-size:12px}.printed-phone-screen small{font:9px Arial,sans-serif;margin-top:6px;color:#c8d0ca}.printed-answer{padding:10px 16px;border-radius:30px;background:#d6b299;color:#26393d;font:700 8px monospace;margin-top:34px}.printed-art-caption{position:absolute;bottom:18px;left:16px;right:16px;text-align:right;font:8px/1.6 monospace;text-transform:uppercase;color:#c6d0c9}.printed-paper{min-width:0;padding:28px 26px;background:#eee8dc;color:#35413f}.printed-meta{display:flex;justify-content:space-between;gap:12px;margin:0 0 20px!important;padding-bottom:14px;border-bottom:1px solid #c9c0b1;color:#695c4b!important;font:9px/1.6 monospace!important;text-transform:uppercase}.printed-meta span{font-size:8px;white-space:nowrap}.printed-headline{font:40px/.98 Georgia,serif!important;letter-spacing:-.035em;margin:0 0 24px!important;color:#293e42!important}.printed-headline em{color:#89684e}.printed-details{font:14px/1.75 Arial,sans-serif;color:#4c5048}.printed-details p{font:inherit!important;color:inherit!important;margin:0 0 18px!important}.printed-details p:last-child{margin-bottom:0!important}.printed-details a,.printed-details button{font:600 12px/1.6 Arial,sans-serif!important;color:#263e43!important;text-decoration:underline;text-underline-offset:4px;overflow-wrap:anywhere}.printed-details .project-link{display:inline-flex;align-items:center;min-height:42px;padding:8px 12px;border:1px solid #657975!important;background:transparent!important;color:#263e43!important;margin-top:12px}.printed-details ul{color:#665b4a!important;padding-left:16px;font:12px/1.7 Arial,sans-serif!important}.printed-footer{display:flex;align-items:center;justify-content:space-between;padding:18px 8px 5px 130px;font:8px/1.6 monospace;letter-spacing:.05em;color:#d7c4ac}.printed-flowers{position:absolute!important;inset:0;z-index:4!important;overflow:hidden;pointer-events:none}.printed-flowers img{position:absolute;width:170px;height:170px;opacity:.65;filter:none;mix-blend-mode:normal}.printed-flowers .flower-tr{top:-38px;right:-17px;transform:rotate(-30deg)}.printed-flowers .flower-bl{bottom:-57px;left:-33px;transform:rotate(150deg)}
.printed-console{width:100%;max-width:270px;box-sizing:border-box;border:1px solid #c5b29155;background:#13242bb3;box-shadow:12px 18px 25px #08141666;transform:rotate(-6deg);padding:14px 18px 24px;border-radius:10px;display:flex;align-items:center;flex-direction:column;text-align:center;gap:18px}.printed-console-bar{display:flex;align-self:flex-start;gap:5px}.printed-console-bar i{width:5px;height:5px;border-radius:50%;background:#c8af8b}.printed-console strong{font:23px/1.2 Georgia,serif;color:#eee8dc}.printed-console>span{font:10px/1.6 monospace;color:#c5d0c9}.printed-code-lines{display:grid;gap:8px;width:100%}.printed-code-lines b{height:3px;background:#a4b4a94d;width:85%}.printed-code-lines b:nth-child(2n){width:55%;background:#b79a7655}
.editorial .grid:has(>.printed-project){grid-template-columns:minmax(0,1fr);gap:28px}.project-grid:has(>.printed-project){gap:28px}
.printed-features{border-top:1px solid #c9c0b1;border-bottom:1px solid #c9c0b1;margin:18px 0}.printed-features>div{display:flex;gap:15px;padding:15px 0}.printed-features>div+div{border-top:1px solid #c9c0b1}.printed-features span{font:9px/1.8 monospace;color:#765a40}.printed-features p{font:12px/1.7 Arial,sans-serif!important;margin:0!important}.printed-features strong{color:#35413f}
@media(max-width:620px){.printed-project.site-card,.printed-project{padding:8px!important;border-radius:12px}.printed-header{padding:9px 6px 14px!important;gap:9px;min-height:58px}.printed-header img{width:25px;height:25px}.printed-header h3{font-size:19px!important}.printed-number{padding-right:40px;font-size:7px}.printed-number strong{font-size:20px}.printed-body{grid-template-columns:35% 65%;min-height:320px}.printed-art{padding:24px 8px 40px}.printed-paper{padding:22px 14px}.printed-meta{font-size:8px!important;display:block;margin-bottom:15px!important}.printed-meta span{display:none}.printed-headline{font-size:27px!important;margin-bottom:18px!important}.printed-details{font-size:12px;line-height:1.65}.printed-details p{margin-bottom:14px!important}.printed-details a{font-size:11px!important}.printed-details .project-link{font-size:11px!important;padding:7px;gap:5px}.printed-phone{width:88px;height:185px;border-width:2px;border-radius:16px;padding:10px 4px}.printed-phone-bar{font-size:5px}.printed-phone-screen{height:150px}.printed-focus{font-size:4px;padding:2px}.printed-call-icon{width:27px;height:27px;margin:18px 0 8px;font-size:16px}.printed-phone-screen strong{font-size:7px}.printed-phone-screen small{font-size:5px}.printed-answer{font-size:5px;padding:7px 8px;margin-top:18px}.printed-wave{font-size:14px;left:8px;top:14px}.printed-art-number{font-size:48px;right:4px}.printed-art-caption{font-size:6px;left:7px;right:7px;bottom:12px}.printed-footer{font-size:6px;padding:15px 0 5px 76px}.printed-flowers img{width:110px;height:110px}.printed-flowers .flower-tr{top:-25px;right:-25px}.printed-flowers .flower-bl{bottom:-34px;left:-25px}.printed-console{padding:10px 7px;gap:12px}.printed-console img{width:38px;height:38px}.printed-console strong{font-size:16px}.printed-console>span{font-size:7px;overflow-wrap:anywhere}}
</style>
