---
import posts from '../data/linkedin-posts.json';

// Metadata for the 13 100-day chapters
const pokemonChapters = [
  { era: 'Gen I · Kanto', pokemon: 'Pikachu', id: 25, type: 'Electric', title: 'Genesis & First Algorithms', desc: 'The historic launch of #1001DaysOfCode alongside Shivanshu. Laid foundations in daily problem-solving, Python recursion, and early C++ loop mechanics.', tags: ['Python', 'DSA Basics', '1001 Days Launch', 'C++ Loop Mechanics'] },
  { era: 'Gen II · Johto', pokemon: 'Cyndaquil', id: 155, type: 'Fire', title: 'Data Structures & C++ Shift', desc: 'Accelerated problem-solving with C++ as the primary engine. Mastered arrays, string manipulations, Ransom Note, and early LeetCode patterns.', tags: ['C++', 'Arrays', 'String Manipulation', 'LeetCode Grinding'] },
  { era: 'Gen III · Hoenn', pokemon: 'Torchic', id: 255, type: 'Fire', title: 'Complexity Analysis & Monotonic Structures', desc: 'Shifted focus to strict time complexity targets: O(n), O(n²), and O(n log n). Deep dive into monotonic stacks, parentheses matching, and subarray logic.', tags: ['Time Complexity', 'Parentheses Validation', 'Subarrays', 'Monotonic Stack'] },
  { era: 'Gen IV · Sinnoh', pokemon: 'Piplup', id: 393, type: 'Water', title: 'Bit Manipulation & Pandas Automation', desc: 'Expanded into bitwise optimizations, binary representation puzzles, and pandas data manipulation, balancing systems thinking with analytical tools.', tags: ['Bit Manipulation', 'Binary Logic', 'Pandas Rows', 'Data Automation'] },
  { era: 'Gen V · Unova', pokemon: 'Snivy', id: 495, type: 'Grass', title: 'Halfway Mark & Combinatorics', desc: 'Crossing the 400 and 500-day thresholds. Solved pair permutations, modular arithmetic, and daily problem-solving during heavy travel without breaking streak.', tags: ['Combinatorics', 'Modular Math', 'Day 500 Halfway', 'Streak Discipline'] },
  { era: 'Gen VI · Kalos', pokemon: 'Froakie', id: 656, type: 'Water', title: 'Frequency Counters & Trees', desc: 'Heavy utilization of hash counters, frequency maps, tree traversals, and dynamic programming memoization.', tags: ['Counter DS', 'Hash Tables', 'Binary Trees', 'Memoization'] },
  { era: 'Gen VII · Alola', pokemon: 'Rowlet', id: 722, type: 'Grass', title: 'Contests & Algorithmic Speed', desc: 'Stepping into LeetCode Weekly and Biweekly contests. Benchmarking real-time problem-solving speed and algorithmic precision under strict clock pressure.', tags: ['Weekly Contests', 'Contest Rating', 'Greedy Choices', 'Rank Climbing'] },
  { era: 'Gen VIII · Galar', pokemon: 'Scorbunny', id: 813, type: 'Fire', title: 'Multi-Language Mastery & Heaps', desc: 'Compiling structured study guides for heaps, sliding windows, and binary search. Cross-implementing algorithms in Python, Java, and C++.', tags: ['Heaps', 'Sliding Window', 'Binary Search Guide', 'Polyglot Coding'] },
  { era: 'Gen IX · Paldea', pokemon: 'Sprigatito', id: 906, type: 'Grass', title: '100% Non-Premium Easy Algorithms Cleared', desc: 'Historic milestone on Day 801: completed every single non-premium Easy algorithm on LeetCode! Transitioned fully into Medium and Hard problem sets.', tags: ['All Easy Cleared', 'Mediums Transition', 'Graph BFS/DFS', 'Milestone 800'] },
  { era: 'Ultra Apex', pokemon: 'Mewtwo', id: 150, type: 'Psychic', title: 'Dynamic Programming & Millennium Approach', desc: 'Classic DP progressions (Frog Jump, Secret Propagation). Approaching the mythical 1,001st day of the original commitment with zero days missed.', tags: ['Dynamic Programming', 'State Transitions', 'Approaching Day 1000', 'Zero Missed Days'] },
  { era: 'Time Origin', pokemon: 'Dialga', id: 483, type: 'Steel/Dragon', title: 'Crossing 1,001 into the 2,002 Quest', desc: 'Achieved the original 1,001-day pledge and immediately doubled down: aiming for 2,002 Days of Code. Advanced graph theory and interval scheduling.', tags: ['Day 1001 Accomplished', '2002 Quest Begins', 'Intervals', 'Interval Trees'] },
  { era: 'Systems Core', pokemon: 'Arceus', id: 493, type: 'Normal', title: 'High-Velocity Arrays & Systems Engineering', desc: 'Solving array reverses, bit operations, and streaming event pipelines in minutes. Building real-time distributed platforms and test infrastructure.', tags: ['High-Velocity Solves', 'Event Streams', 'System Architecture', 'Kafka Pipelines'] },
  { era: 'Apex Era', pokemon: 'Koraidon', id: 1007, type: 'Fighting/Dragon', title: 'Production Platforms & 425+ Test Suites', desc: 'Morgan Stanley CIAM warehouse apprenticeship, 5M+ Kafka events with zero row-count tolerance, pure C Wordle simulator, and the Pokédex portfolio.', tags: ['Morgan Stanley CIAM', 'Kafka / PySpark', 'Pure C Wordle', 'Dex Portfolio'] }
];

const maxDay = Math.max(...posts.map(p => p.day));

const chapters = [];
for (let i = 0; i < 13; i++) {
  const lo = i * 100 + 1;
  const hi = lo + 99;
  const bPosts = posts.filter(p => p.day >= lo && p.day <= hi);
  bPosts.sort((a, b) => a.day - b.day);
  const minDate = bPosts[0]?.date || '';
  const maxDate = bPosts[bPosts.length - 1]?.date || '';
  const meta = pokemonChapters[i];
  
  // Pick 3 memorable or highlight days for this chapter
  let rawSampleDays: any[] = bPosts.filter((p: any) => p.milestone || p.easterEgg);
  if (rawSampleDays.length === 0) {
    rawSampleDays = [bPosts[0], bPosts[Math.floor(bPosts.length / 2)], bPosts[bPosts.length - 1]].filter(Boolean);
  } else if (rawSampleDays.length < 3) {
    const extras = [bPosts[0], bPosts[bPosts.length - 1]].filter(Boolean);
    for (const ex of extras) {
      if (!rawSampleDays.some((s: any) => s.day === ex.day)) rawSampleDays.push(ex);
    }
  }
  rawSampleDays.sort((a: any, b: any) => b.day - a.day); // latest first
  const sampleDays = rawSampleDays.slice(0, 3).map((p: any) => {
    let t = String(p.content || p.text || '').replace(/[\r\n]+/g, ' ').replace(/\s+/g, ' ').trim();
    if (t.length > 95) t = t.slice(0, 92) + '…';
    return {
      day: p.day,
      date: p.date,
      note: p.milestone || p.easterEgg || t,
    };
  });

  const monthNames = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
  const dObj = minDate ? new Date(minDate) : new Date();
  const startMonth = monthNames[dObj.getMonth()] || 'May';
  const startYear = dObj.getFullYear() || 2023;

  const endDObj = maxDate ? new Date(maxDate) : new Date();
  const endMonth = monthNames[endDObj.getMonth()] || 'Aug';
  const endYear = endDObj.getFullYear() || 2023;

  chapters.push({
    index: i,
    chapterNum: i + 1,
    lo,
    hi,
    archiveSlug: `${lo}-${i === 12 ? '1300' : hi}`,
    label: `Days ${lo} – ${i === 12 ? maxDay + '+' : hi}`,
    count: bPosts.length,
    dateRange: `${startMonth} ${startYear} – ${endMonth} ${endYear}`,
    startMonth,
    startYear,
    ...meta,
    sampleDays,
    imgUrl: `https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/${meta.id}.png`
  });
}

// Default order: Latest first (as user suggested: "latest days i think at the start and day 1 at the start")
// Chapters array has index 0 = Day 1-100, index 12 = Day 1201-1258.
---

<div class="pkm-timeline-module" id="pkm-timeline-root" data-active-index="12" data-order="latest">
  <!-- Controls Bar -->
  <div class="pkm-timeline-controls">
    <div class="pkm-controls-left">
      <span class="pkm-controls-eyebrow">ORDER DIRECTORY:</span>
      <div class="pkm-order-switch" role="group" aria-label="Timeline display order">
        <button
          type="button"
          class="pkm-switch-btn is-active"
          id="pkm-order-latest-btn"
          data-order-target="latest"
          aria-pressed="true"
        >
          <span class="pkm-switch-dot" aria-hidden="true"></span>
          ⚡ Latest First (Day {maxDay} → 1)
        </button>
        <button
          type="button"
          class="pkm-switch-btn"
          id="pkm-order-origin-btn"
          data-order-target="origin"
          aria-pressed="false"
        >
          <span class="pkm-switch-dot" aria-hidden="true"></span>
          🌱 Day 1 First (Day 1 → {maxDay})
        </button>
      </div>
    </div>

    <div class="pkm-controls-right">
      <button type="button" class="pkm-jump-pill" id="pkm-jump-day1-btn" title="Jump directly to Day 1–100">
        ⏮ Jump to Day 1
      </button>
      <button type="button" class="pkm-jump-pill" id="pkm-jump-latest-btn" title="Jump directly to latest days">
        ⏭ Jump to Latest
      </button>
    </div>
  </div>

  <!-- Top Carousel Area (Flanked by Pokédex Conduit Bumpers) -->
  <div class="pkm-timeline-top">
    <!-- Pokeball Left Conduit End-Cap -->
    <div class="pkm-conduit-bumper pkm-bumper-left" aria-hidden="true">
      <div class="pkm-ball-core">
        <div class="pkm-ball-top"></div>
        <div class="pkm-ball-band">
          <div class="pkm-ball-button"></div>
        </div>
        <div class="pkm-ball-bottom"></div>
      </div>
    </div>

    <!-- Navigation Buttons -->
    <button
      type="button"
      class="pkm-nav-btn prev"
      id="pkm-nav-prev"
      aria-label="Previous 100-day chapter"
    >
      <svg class="pkm-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
    </button>

    <button
      type="button"
      class="pkm-nav-btn next"
      id="pkm-nav-next"
      aria-label="Next 100-day chapter"
    >
      <svg class="pkm-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
    </button>

    <!-- Carousel Scroll Track -->
    <div class="pkm-carousel-track" id="pkm-carousel-track" role="region" aria-label="100-Day Milestones Carousel" tabindex="0">
      {chapters.map((ch) => (
        <div
          class:list={['pkm-cell', { 'is-selected': ch.index === 12 }]}
          data-index={ch.index}
          role="button"
          tabindex="0"
          aria-label={`Select ${ch.label}: ${ch.title}`}
          aria-selected={ch.index === 12 ? 'true' : 'false'}
        >
          <!-- Corner Rivets / Screws (Mario Timeline aesthetic) -->
          <div class="pkm-rivet rivet-tl" aria-hidden="true"></div>
          <div class="pkm-rivet rivet-tr" aria-hidden="true"></div>
          <div class="pkm-rivet rivet-bl" aria-hidden="true"></div>
          <div class="pkm-rivet rivet-br" aria-hidden="true"></div>

          <!-- Time & Era Badge -->
          <time class="pkm-cell-time" datetime={`${ch.startYear}-${ch.startMonth}`}>
            <span class="pkm-time-month">{ch.startMonth}</span>
            <span class="pkm-time-year">{ch.startYear}</span>
          </time>

          <!-- Pokémon Sprite / Artwork Frame -->
          <div class="pkm-img-box">
            <div class="pkm-img-glow" aria-hidden="true"></div>
            <img
              src={ch.imgUrl}
              alt={`${ch.pokemon} - ${ch.era}`}
              width="140"
              height="140"
              loading="lazy"
              decoding="async"
              class="pkm-artwork"
              onerror="this.style.opacity='0.2'"
            />
          </div>

          <!-- Bottom Chapter & Day Tag -->
          <div class="pkm-cell-label">
            <span class="pkm-cell-era">{ch.era.split('·')[0].trim()}</span>
            <span class="pkm-cell-days">{ch.label}</span>
          </div>
        </div>
      ))}
    </div>

    <!-- Pokeball Right Conduit End-Cap -->
    <div class="pkm-conduit-bumper pkm-bumper-right" aria-hidden="true">
      <div class="pkm-ball-core">
        <div class="pkm-ball-top"></div>
        <div class="pkm-ball-band">
          <div class="pkm-ball-button"></div>
        </div>
        <div class="pkm-ball-bottom"></div>
      </div>
    </div>
  </div>

  <!-- Bottom Narrative Deck (Mario Timeline `.timeline-desc` inspired with Pokédex Casing) -->
  <div class="pkm-deck-container" id="pkm-deck-container">
    <div class="pkm-deck-chassis">
      <!-- Deck Hardware LEDs -->
      <div class="pkm-deck-topbar" aria-hidden="true">
        <div class="pkm-leds">
          <span class="pkm-led led-red"></span>
          <span class="pkm-led led-yellow"></span>
          <span class="pkm-led led-green"></span>
        </div>
        <div class="pkm-deck-title-bar">
          <span class="pkm-scanner-line"></span>
          <span class="pkm-deck-sys-text">POKÉDEX CHRONO-DECK · 100-DAY APEX RECORD</span>
        </div>
      </div>

      <!-- Narrative Cards Deck (one for each 100-day chunk) -->
      <div class="pkm-narrative-deck" id="pkm-narrative-deck">
        {chapters.map((ch) => (
          <article
            class:list={['pkm-card', { 'is-active': ch.index === 12 }]}
            id={`pkm-card-${ch.index}`}
            data-index={ch.index}
            aria-hidden={ch.index === 12 ? 'false' : 'true'}
          >
            <!-- Sticky Header inside Card -->
            <header class="pkm-card-header">
              <div class="pkm-card-meta-line">
                <span class="pkm-meta-pill pkm-pill-chapter">CHAPTER {ch.chapterNum} OF 13</span>
                <span class="pkm-meta-pill pkm-pill-era">{ch.era}</span>
                <span class="pkm-meta-pill pkm-pill-days">{ch.label}</span>
                <span class="pkm-meta-pill pkm-pill-count">{ch.count} LOGS</span>
              </div>
              <h3 class="pkm-card-title">{ch.title}</h3>
              <div class="pkm-card-date-badge">
                <span class="pkm-date-icon" aria-hidden="true">📅</span>
                <span>{ch.dateRange}</span>
                <span class="pkm-mascot-badge">Mascot: <strong>{ch.pokemon}</strong> ({ch.type})</span>
              </div>
            </header>

            <!-- Card Content Body -->
            <div class="pkm-card-body">
              <p class="pkm-card-desc">{ch.desc}</p>

              <!-- Topic / Tech Tags -->
              <div class="pkm-tags-row">
                <span class="pkm-tags-title">Core Disciplines:</span>
                <div class="pkm-tags-list">
                  {ch.tags.map((tag) => (
                    <span class="pkm-tag-chip">{tag}</span>
                  ))}
                </div>
              </div>

              <!-- Notable Log Highlights for this 100-day chapter -->
              <div class="pkm-sample-section">
                <h4 class="pkm-sample-heading">Notable Logs & Milestones in this Chapter:</h4>
                <div class="pkm-sample-grid">
                  {ch.sampleDays.map((s) => (
                    <a href={`/blog/day-${s.day}/`} class="pkm-sample-link" title={`Read Day ${s.day} full log`}>
                      <div class="pkm-sample-header">
                        <span class="pkm-sample-day">DAY {s.day}</span>
                        <time class="pkm-sample-date">{s.date}</time>
                      </div>
                      <p class="pkm-sample-note">{s.note}</p>
                      <span class="pkm-sample-arrow" aria-hidden="true">Read Day {s.day} →</span>
                    </a>
                  ))}
                </div>
              </div>

              <!-- Action Footer -->
              <footer class="pkm-card-footer">
                <a href={`/blog/archive/${ch.archiveSlug}/`} class="pkm-archive-btn">
                  <span>Explore Full {ch.label} Archive ({ch.count} Posts)</span>
                  <span aria-hidden="true">↗</span>
                </a>
                <div class="pkm-footer-sublinks">
                  <a href="/blog/timeline/" class="pkm-sublink">Full 1,258-Day Timeline →</a>
                  <a href="/blog/milestones/" class="pkm-sublink">All Milestones & Glitches →</a>
                </div>
              </footer>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</div>

<style>
  /* -------------------------------------------------------------
     POKÉMON TIMELINE MODULE (SUPER MARIO CODEPEN INSPIRATION)
     ------------------------------------------------------------- */
  .pkm-timeline-module {
    --pkm-red: #e11d48;
    --pkm-crimson: #991b1b;
    --pkm-gold: #f59e0b;
    --pkm-electric: #F7D02C;
    --pkm-cyan: #06b6d4;
    --pkm-border: rgba(223, 246, 255, 0.16);
    --pkm-bg-dark: #0a0e17;
    --pkm-card-bg: #0d1420;
    --pkm-track-gap: 20px;
    width: 100%;
    margin: 24px 0 36px;
    position: relative;
    box-sizing: border-box;
    font-family: var(--font-body, "Departure Mono", monospace);
  }

  /* Controls Header */
  .pkm-timeline-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 24px;
    padding: 14px 18px;
    background: rgba(14, 22, 35, 0.7);
    border: 1px solid var(--pkm-border);
    border-radius: 12px;
    backdrop-filter: blur(8px);
  }

  .pkm-controls-left {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .pkm-controls-eyebrow {
    font-size: 11px;
    letter-spacing: 0.08em;
    color: #94a3b8;
    font-weight: 700;
  }

  .pkm-order-switch {
    display: inline-flex;
    background: #060910;
    border: 1px solid var(--pkm-border);
    border-radius: 8px;
    padding: 3px;
    gap: 4px;
  }

  .pkm-switch-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: #94a3b8;
    background: transparent;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.18s ease;
    font-family: inherit;
  }

  .pkm-switch-btn:hover {
    color: #f1f5f9;
    background: rgba(255, 255, 255, 0.06);
  }

  .pkm-switch-btn.is-active {
    color: #050811;
    background: var(--pkm-electric);
    box-shadow: 0 2px 8px rgba(247, 208, 44, 0.35);
  }

  .pkm-switch-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
  }

  .pkm-controls-right {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .pkm-jump-pill {
    padding: 6px 12px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: #cbd5e1;
    background: #111a28;
    border: 1px solid var(--pkm-border);
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.16s ease;
    font-family: inherit;
  }

  .pkm-jump-pill:hover {
    color: #f8fafc;
    border-color: var(--pkm-cyan);
    background: #162235;
    transform: translateY(-1px);
  }

  /* -------------------------------------------------------------
     TOP CAROUSEL TRACK & POKÉBALL BUMPERS
     ------------------------------------------------------------- */
  .pkm-timeline-top {
    position: relative;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 24px;
    padding: 24px 0 16px;
    overflow: hidden;
  }

  /* Conduit Bumpers (Mario Pipes -> Pokéball Sensor Docks) */
  .pkm-conduit-bumper {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 44px;
    height: 84%;
    max-height: 290px;
    z-index: 20;
    pointer-events: none;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .pkm-bumper-left {
    left: 0;
  }

  .pkm-bumper-right {
    right: 0;
  }

  .pkm-ball-core {
    width: 40px;
    height: 120px;
    border-radius: 20px;
    background: #090e17;
    border: 2px solid #334155;
    position: relative;
    overflow: hidden;
    box-shadow: 0 0 16px rgba(0, 0, 0, 0.6);
  }

  .pkm-ball-top {
    height: 50%;
    background: linear-gradient(180deg, #ef4444 0%, #b91c1c 100%);
  }

  .pkm-ball-bottom {
    height: 50%;
    background: linear-gradient(180deg, #e2e8f0 0%, #94a3b8 100%);
  }

  .pkm-ball-band {
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    height: 10px;
    transform: translateY(-50%);
    background: #090e17;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .pkm-ball-button {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: #ffffff;
    border: 2px solid #090e17;
    box-shadow: 0 0 6px rgba(255, 255, 255, 0.8);
  }

  /* Previous & Next Nav Buttons (Mario Flickity Buttons) */
  .pkm-nav-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 50px;
    height: 60px;
    z-index: 25;
    background: #dc2626;
    border: 2px solid #090e17;
    color: #ffffff;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.22s ease;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.45);
  }

  .pkm-nav-btn.prev {
    left: 0px;
    border-radius: 0 40px 40px 0;
    padding-right: 8px;
  }

  .pkm-nav-btn.next {
    right: 0px;
    border-radius: 40px 0 0 40px;
    padding-left: 8px;
  }

  .pkm-nav-btn:hover {
    background: #ef4444;
    box-shadow: 0 0 16px rgba(239, 68, 68, 0.6);
  }

  .pkm-nav-btn.prev:hover {
    left: 4px;
  }

  .pkm-nav-btn.next:hover {
    right: 4px;
  }

  .pkm-nav-icon {
    width: 22px;
    height: 22px;
  }

  /* Carousel Track */
  .pkm-carousel-track {
    width: 100%;
    padding: 16px 54px;
    display: flex;
    gap: var(--pkm-track-gap);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
    scrollbar-color: rgba(223, 246, 255, 0.2) transparent;
  }

  .pkm-carousel-track::-webkit-scrollbar {
    height: 6px;
  }

  .pkm-carousel-track::-webkit-scrollbar-thumb {
    background: rgba(223, 246, 255, 0.25);
    border-radius: 3px;
  }

  /* Carousel Cell (Mario `.carousel-cell` Card Deck) */
  .pkm-cell {
    flex: 0 0 210px;
    height: 245px;
    scroll-snap-align: center;
    background: #0f1724;
    border: 2px solid var(--pkm-border);
    border-radius: 12px;
    position: relative;
    padding: 14px 12px 10px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    user-select: none;
    transition: transform 0.2s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.2s ease, border-color 0.2s ease;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.35);
  }

  .pkm-cell:hover {
    transform: translateY(-4px);
    border-color: rgba(223, 246, 255, 0.4);
    background: #141f30;
  }

  .pkm-cell.is-selected {
