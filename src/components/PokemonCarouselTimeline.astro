---
import posts from '../data/linkedin-posts.json';
interface Props { compact?: boolean; layout?: "carousel" | "grid"; chapterIndex?: number }
const { compact = false, layout = "carousel", chapterIndex } = Astro.props;
const pokemonChapters = [
  { era: 'Gen I · Kanto', pokemon: 'Pikachu', id: 25, type: 'Electric', title: 'Genesis & First Algorithms', desc: 'The historic launch of #1001DaysOfCode alongside Shivanshu. Laid foundations in daily problem-solving, Python recursion, and early C++ loop mechanics.', tags: ['Python', 'DSA Basics', '1001 Days Launch', 'C++ Loop Mechanics'] },
  { era: 'Gen II · Johto', pokemon: 'Cyndaquil', id: 155, type: 'Fire', title: 'Data Structures & C++ Shift', desc: 'Accelerated problem-solving with C++ as the primary engine. Mastered arrays, string manipulations, Ransom Note, and early LeetCode patterns.', tags: ['C++', 'Arrays', 'String Manipulation', 'LeetCode Grinding'] },
  { era: 'Gen III · Hoenn', pokemon: 'Torchic', id: 255, type: 'Fire', title: 'Complexity Analysis & Monotonic Structures', desc: 'Shifted focus to strict time complexity targets: O(n), O(n²), and O(n log n). Deep dive into monotonic stacks, parentheses matching, and subarray logic.', tags: ['Time Complexity', 'Parentheses Validation', 'Subarrays', 'Monotonic Stack'] },
  { era: 'Gen IV · Sinnoh', pokemon: 'Piplup', id: 393, type: 'Water', title: 'Bit Manipulation & Pandas Automation', desc: 'Expanded into bitwise optimizations, binary representation puzzles, and pandas data manipulation, balancing systems thinking with analytical tools.', tags: ['Bit Manipulation', 'Binary Logic', 'Pandas Rows', 'Data Automation'] },
  { era: 'Gen V · Unova', pokemon: 'Snivy', id: 495, type: 'Grass', title: 'Halfway Mark & Combinatorics', desc: 'Crossing the 400 and 500-day thresholds. Solved pair permutations, modular arithmetic, and daily problem-solving during heavy travel without breaking streak.', tags: ['Combinatorics', 'Modular Math', 'Day 500 Halfway', 'Streak Discipline'] },
  { era: 'Gen VI · Kalos', pokemon: 'Froakie', id: 656, type: 'Water', title: 'Frequency Counters & Trees', desc: 'Heavy utilization of hash counters, frequency maps, tree traversals, and dynamic programming memoization.', tags: ['Counter DS', 'Hash Tables', 'Binary Trees', 'Memoization'] },
  { era: 'Gen VII · Alola', pokemon: 'Rowlet', id: 722, type: 'Grass', title: 'Contests & Algorithmic Speed', desc: 'Stepping into LeetCode Weekly and Biweekly contests. Benchmarking real-time problem-solving speed and algorithmic precision under strict clock pressure.', tags: ['Weekly Contests', 'Contest Rating', 'Greedy Choices', 'Rank Climbing'] },
  { era: 'Gen VIII · Galar', pokemon: 'Scorbunny', id: 813, type: 'Fire', title: 'Multi-Language Mastery & Heaps', desc: 'Compiling structured study guides for heaps, sliding windows, and binary search. Cross-implementing algorithms in Python, Java, and C++.', tags: ['Heaps', 'Sliding Window', 'Binary Search Guide', 'Polyglot Coding'] },
  { era: 'Gen IX · Paldea', pokemon: 'Sprigatito', id: 906, type: 'Grass', title: '100% Non-Premium Easy Algorithms Cleared', desc: 'Historic milestone on Day 801: completed every single non-premium Easy algorithm on LeetCode! Transitioned fully into Medium and Hard problem sets.', tags: ['All Easy Cleared', 'Mediums Transition', 'Graph BFS/DFS', 'Milestone 800'] },
  { era: 'Ultra Apex', pokemon: 'Mewtwo', id: 150, type: 'Psychic', title: 'Dynamic Programming & Millennium Approach', desc: 'Classic DP progressions (Frog Jump, Secret Propagation). Approaching the mythical 1,001st day of the original commitment with zero days missed.', tags: ['Dynamic Programming', 'State Transitions', 'Approaching Day 1000', 'Zero Missed Days'] },
  { era: 'Time Origin', pokemon: 'Dialga', id: 483, type: 'Steel/Dragon', title: 'Crossing 1,001 into the 2,002 Quest', desc: 'Achieved the original 1,001-day pledge and immediately doubled down: aiming for 2,002 Days of Code. Advanced graph theory and interval scheduling.', tags: ['Day 1001 Accomplished', '2002 Quest Begins', 'Intervals', 'Interval Trees'] },
  { era: 'Systems Core', pokemon: 'Arceus', id: 493, type: 'Normal', title: 'High-Velocity Arrays & Systems Engineering', desc: 'Solving array reverses, bit operations, and streaming event pipelines in minutes. Building real-time distributed platforms and test infrastructure.', tags: ['High-Velocity Solves', 'Event Streams', 'System Architecture', 'Kafka Pipelines'] },
  { era: 'Apex Era', pokemon: 'Koraidon', id: 1007, type: 'Fighting/Dragon', title: 'Production Platforms & 425+ Test Suites', desc: 'Morgan Stanley CIAM warehouse apprenticeship, 5M+ Kafka events with zero row-count tolerance, pure C Wordle simulator, and the Pokédex portfolio.', tags: ['Morgan Stanley CIAM', 'Kafka / PySpark', 'Pure C Wordle', 'Dex Portfolio'] }
];
const flowers = ['chrysanthemum','rose','peony','lotus','dahlia','poppy','iris','lily','camellia','cosmos','sunflower','anemone','magnolia'];
const maxDay = Math.max(...posts.map(post => post.day));
const chapters = Array.from({ length: Math.ceil(maxDay / 100) }, (_, index) => {
  const lo = index * 100 + 1;
  const hi = Math.min(lo + 99, maxDay);
  const entries = posts.filter(post => post.day >= lo && post.day <= hi).sort((a, b) => a.day - b.day);
  const meta = pokemonChapters[index] ?? { era: 'Next chapter', title: 'The journey continues', desc: 'More daily engineering notes and projects.', tags: [] };
  const samples = [entries[0], entries[Math.floor(entries.length / 2)], entries.at(-1)].filter((post, i, list) => post && list.findIndex(item => item?.day === post.day) === i);
  return { ...meta, lo, hi, index, entries, samples, archive: `/blog/archive/${lo}-${lo + 99}/` };
}).filter(chapter => chapter.entries.length && (chapterIndex === undefined || chapter.index === chapterIndex)).reverse();
const dateLabel = (date: string) => date ? new Date(`${date.slice(0, 10)}T12:00:00Z`).toLocaleDateString('en-GB', { month: 'short', year: 'numeric', timeZone: 'UTC' }) : '';
---

<section class:list={['floral-timeline', { compact, 'floral-grid': layout === 'grid', 'floral-single': chapterIndex !== undefined }]} data-floral-timeline data-layout={layout} aria-label="Days of Code chapter cards">
  <header class="floral-toolbar"><p><strong>{(chapterIndex === undefined ? maxDay : chapters.reduce((sum, chapter) => sum + chapter.entries.length, 0)).toLocaleString('en-IN')}</strong> days of code · {chapters.length} {chapters.length === 1 ? "chapter" : "chapters"}</p>{layout !== "grid" && <nav aria-label="Chapter navigation"><button type="button" data-end="latest">Latest</button><button type="button" data-end="first">Day one</button><button type="button" data-step="-1" aria-label="Previous chapter">←</button><button type="button" data-step="1" aria-label="Next chapter">→</button></nav>}</header>
  <div class="floral-track" tabindex={layout === "grid" ? undefined : 0} aria-label="Scroll chapter cards. Use left and right arrow keys.">
    {chapters.map(chapter => (
      <article class="chapter-card" data-chapter={chapter.index} id={`chapter-${compact ? 'home' : 'full'}-${chapter.index}`} tabindex="0" aria-label={`Chapter ${chapter.index + 1}, days ${chapter.lo} to ${chapter.hi}`}>
        <div class="chapter-flowers" aria-hidden="true"><img class="flower-tr" src={`/floral/${flowers[chapter.index % flowers.length]}.svg`} alt="" width="180" height="180" loading="lazy"/><img class="flower-bl" src={`/floral/${flowers[chapter.index % flowers.length]}.svg`} alt="" width="180" height="180" loading="lazy"/></div>
        <div class="chapter-copy"><p class="chapter-number">Chapter {String(chapter.index + 1).padStart(2, '0')} <span>· {chapter.era}</span></p><p class="chapter-range">Days {chapter.lo.toLocaleString('en-IN')}–{chapter.hi.toLocaleString('en-IN')}</p><h3>{chapter.title}</h3><p class="chapter-description">{chapter.desc}</p><ul class="chapter-topics">{chapter.tags.map(tag => <li>{tag}</li>)}</ul><p class="chapter-period">{dateLabel(chapter.entries[0].date)} — {dateLabel(chapter.entries.at(-1)!.date)} · {chapter.entries.length} logs</p><a class="chapter-read" href={chapterIndex === undefined ? chapter.archive : "#daily-logs"}>{chapterIndex === undefined ? "Read this chapter" : "Browse daily logs"} <span aria-hidden="true">↗</span></a>{!compact && layout !== "grid" && <div class="chapter-days">{chapter.samples.map(post => post && <a href={`/blog/day-${post.day}/`}>Day {post.day} ↗</a>)}</div>}</div>
      </article>
    ))}
  </div>
  <p class="floral-position" role="status" hidden={layout === "grid"}>Latest chapter · Scroll to explore</p>
  {compact && <a class="floral-all" href="/blog/timeline/">Explore the complete timeline →</a>}
</section>
<style>
.floral-timeline{min-width:0;width:100%;color:var(--ink);font-family:var(--font-body);margin-top:24px}.floral-timeline *{box-sizing:border-box}.floral-toolbar{display:flex;justify-content:space-between;align-items:center;gap:16px;margin-bottom:22px}.floral-toolbar p{font:12px/1.6 Arial,sans-serif;color:var(--dim);margin:0}.floral-toolbar p strong{font-size:17px;color:var(--ink)}.floral-toolbar nav{display:flex;gap:6px}.floral-toolbar button{background:var(--panel);color:var(--ink);border:1px solid color-mix(in srgb,var(--time-accent,var(--accent)) 35%,var(--border));min-height:40px;min-width:40px;padding:8px 12px;border-radius:4px;cursor:pointer;font:12px Arial,sans-serif}.floral-toolbar button:hover{border-color:var(--time-accent,var(--accent))}.floral-timeline :focus-visible{outline:2px solid var(--time-accent,var(--focus));outline-offset:4px}
.floral-track{display:flex;gap:24px;overflow-x:auto;overscroll-behavior-x:contain;scroll-snap-type:x mandatory;scrollbar-width:thin;scrollbar-color:var(--time-accent,var(--accent)) var(--time-deep,var(--panel));padding:12px 5px 26px;perspective:1400px}.chapter-card{position:relative;isolation:isolate;flex:0 0 min(680px,85%);min-width:0;min-height:520px;scroll-snap-align:center;display:grid;place-items:center;padding:70px 50px;border:1px solid color-mix(in srgb,var(--time-accent,var(--accent)) 45%,var(--border));border-radius:14px;background:linear-gradient(135deg,color-mix(in srgb,var(--time-panel,var(--panel)) 70%,var(--time-deep,var(--bg))),var(--time-deep,var(--panel)) 65%);box-shadow:inset 0 0 0 5px #08101a40,inset 0 0 0 6px color-mix(in srgb,var(--time-accent,var(--accent)) 17%,transparent),0 14px 24px #0004;transition:transform .35s ease;transform:rotateX(var(--rx,0deg)) rotateY(var(--ry,0deg));color:var(--ink)}
.chapter-card::before,.chapter-card::after{content:"";position:absolute;inset:0;border-radius:inherit;pointer-events:none;z-index:3;transition:opacity .6s ease}.chapter-card::before{opacity:.24;background:linear-gradient(115deg,transparent 20%,color-mix(in srgb,var(--time-accent,var(--accent)) 28%,transparent) 35%,#7ee8fa24 45%,transparent 58%,#baa5ed24 72%,transparent 85%);background-size:250% 200%;background-position:35% 45%;mix-blend-mode:screen;animation:chapter-foil-drift 18s ease-in-out infinite alternate;animation-play-state:paused}.chapter-card::after{opacity:.12;background:radial-gradient(ellipse at var(--px,50%) var(--py,50%),#fff4,transparent 60%);mix-blend-mode:soft-light}.chapter-card[data-visible=true]::before{animation-play-state:running}.chapter-card:hover::before,.chapter-card:focus-within::before{opacity:.4;animation-play-state:paused}.chapter-card:hover::after,.chapter-card:focus-within::after{opacity:.3}.floral-timeline[data-paused=true] .chapter-card::before{animation-play-state:paused}@keyframes chapter-foil-drift{from{background-position:35% 45%}to{background-position:65% 55%}}

.chapter-flowers{position:absolute;inset:0;overflow:hidden;border-radius:inherit;z-index:0;pointer-events:none}.chapter-flowers::after{content:"";position:absolute;inset:10px;border:1px solid color-mix(in srgb,var(--time-accent,var(--accent)) 24%,transparent);border-radius:7px}.chapter-flowers img{position:absolute;width:185px;height:185px;object-fit:contain;opacity:.48;filter:grayscale(1) brightness(1.5);mix-blend-mode:luminosity;pointer-events:none}.flower-tr{top:-40px;right:-34px;transform:rotate(-30deg)}.flower-bl{bottom:-40px;left:-34px;transform:rotate(150deg)}
.chapter-copy{position:relative;z-index:2;text-align:center;width:100%;max-width:520px}.chapter-number{font:10px/1.7 Arial,sans-serif;letter-spacing:.09em;text-transform:uppercase;color:var(--time-accent,var(--accent));margin:0 0 17px}.chapter-number span{color:var(--dim)}.chapter-range{font:12px/1.6 Arial,sans-serif;letter-spacing:.05em;color:var(--time-soft,var(--ink));margin:0 0 14px}.chapter-copy h3{font:400 clamp(24px,2.4vw,32px)/1.3 var(--font-display);letter-spacing:-.025em;color:var(--ink);margin:0 0 20px}.chapter-description{font:14px/1.75 var(--font-body);color:var(--ink);max-width:52ch;margin:0 auto 21px}.chapter-topics{display:flex;flex-wrap:wrap;justify-content:center;gap:6px 14px;list-style:none;padding:0;margin:0 0 22px;font:11px/1.7 Arial,sans-serif;color:var(--time-soft,var(--ink))}.chapter-period{font:11px/1.7 Arial,sans-serif;color:var(--dim);margin:0 0 18px}.chapter-read{display:inline-flex;align-items:center;gap:20px;padding:11px 16px;border:1px solid color-mix(in srgb,var(--time-accent,var(--accent)) 55%,transparent);border-radius:3px;color:var(--ink);text-decoration:none;font:12px Arial,sans-serif;background:color-mix(in srgb,var(--time-deep,var(--panel)) 75%,transparent)}.chapter-read:hover{background:var(--time-accent,var(--accent));color:var(--time-deep,var(--bg))}.chapter-days{display:flex;justify-content:center;gap:18px;flex-wrap:wrap;margin-top:19px}.chapter-days a{font:11px Arial,sans-serif;color:var(--dim);text-underline-offset:4px}.floral-position{font:11px/1.7 Arial,sans-serif;color:var(--dim);margin:14px 0 10px}.floral-all{font:13px Arial,sans-serif;color:var(--time-accent,var(--accent));text-underline-offset:4px}.compact .chapter-card{min-height:490px;flex-basis:min(650px,86%)}
@media(max-width:620px){.floral-toolbar{align-items:flex-start;flex-direction:column;gap:12px}.floral-track{gap:14px;padding-bottom:22px}.chapter-card,.compact .chapter-card{flex-basis:94%;padding:76px 23px;min-height:540px}.chapter-copy h3{font-size:29px}.chapter-description{font-size:14px;line-height:1.7}.chapter-flowers img{width:135px;height:135px}.flower-tr{top:-24px;right:-25px}.flower-bl{bottom:-24px;left:-25px}.chapter-number{font-size:9px}.chapter-number span{display:block}.chapter-days{gap:12px}}
@media(prefers-reduced-motion:reduce){.chapter-card{transform:none!important;transition:none}.chapter-card::before,.chapter-card::after{transition:none}}
@media(hover:none){.chapter-card{transform:none!important}}

.floral-grid .floral-track{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px;overflow:visible;padding:10px 0 24px}.floral-grid .chapter-card{min-height:540px;padding:76px 30px}.floral-grid .chapter-copy h3{font-size:24px}.chapter-number,.chapter-range,.chapter-topics,.chapter-period,.chapter-days a,.floral-position{font-size:12px}.chapter-number{letter-spacing:.04em}.chapter-read{min-height:44px}.floral-grid .floral-position[hidden]{display:none}
@media(max-width:680px){.floral-grid .floral-track{grid-template-columns:1fr}.floral-grid .chapter-card{padding:76px 24px}.chapter-copy h3{font-size:25px}}
@media(prefers-reduced-motion:reduce){.chapter-card::before{animation:none!important;background-position:50% 50%;opacity:.24}.chapter-card::after{opacity:.12}}
@media print{.chapter-card::before,.chapter-card::after{animation:none!important}}
.floral-single .floral-track{grid-template-columns:minmax(0,1fr)}
</style>
<script>
function initFloralTimelines() {
  document.querySelectorAll<HTMLElement>('[data-floral-timeline]').forEach(root => {
    if (root.dataset.ready) return;
    root.dataset.ready = 'true';
    const track = root.querySelector<HTMLElement>('.floral-track')!;
    const cards = Array.from(root.querySelectorAll<HTMLElement>('.chapter-card'));
    let active = 0;
    const select = (index: number) => {
      active = Math.max(0, Math.min(cards.length - 1, index));
      track.scrollTo({left: cards[active].offsetLeft - track.offsetLeft - (track.clientWidth - cards[active].offsetWidth) / 2, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth'});
      root.querySelector('.floral-position')!.textContent = `Chapter ${Number(cards[active].dataset.chapter) + 1} of ${cards.length}`;
    };
    root.querySelectorAll<HTMLButtonElement>('[data-step]').forEach(button => button.addEventListener('click', () => select(active + Number(button.dataset.step))));
    root.querySelectorAll<HTMLButtonElement>('[data-end]').forEach(button => button.addEventListener('click', () => select(button.dataset.end === 'first' ? cards.length - 1 : 0)));
    track.addEventListener('keydown', event => {
      if (root.dataset.layout === 'grid') return;
      if (event.target !== track && !(event.target instanceof HTMLElement && event.target.classList.contains('chapter-card'))) return;
      if (event.key === 'ArrowLeft' || event.key === 'ArrowRight' || event.key === 'Home' || event.key === 'End') {
        event.preventDefault();
        select(event.key === 'Home' ? 0 : event.key === 'End' ? cards.length - 1 : active + (event.key === 'ArrowRight' ? 1 : -1));
        cards[active].focus({ preventScroll: true });
      }
    });
    track.addEventListener('scrollend', () => {
      const midpoint = track.getBoundingClientRect().left + track.clientWidth / 2;
      active = cards.reduce((best, card, index) => Math.abs(card.getBoundingClientRect().left + card.offsetWidth / 2 - midpoint) < Math.abs(cards[best].getBoundingClientRect().left + cards[best].offsetWidth / 2 - midpoint) ? index : best, 0);
      root.querySelector('.floral-position')!.textContent = `Chapter ${Number(cards[active].dataset.chapter) + 1} of ${cards.length}`;
    });

  });
}
initFloralTimelines();
document.addEventListener('astro:page-load', initFloralTimelines);
</script>
