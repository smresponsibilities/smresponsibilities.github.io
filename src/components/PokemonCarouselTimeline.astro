</style>

<script>
  function initPokemonTimeline() {
    const root = document.getElementById('pkm-timeline-root');
    const track = document.getElementById('pkm-carousel-track');
    if (!root || !track) return;

    const rootEl = root;
    const trackEl = track;

    const prevBtn = document.getElementById('pkm-nav-prev');
    const nextBtn = document.getElementById('pkm-nav-next');
    const orderLatestBtn = document.getElementById('pkm-order-latest-btn');
    const orderOriginBtn = document.getElementById('pkm-order-origin-btn');
    const jumpDay1Btn = document.getElementById('pkm-jump-day1-btn');
    const jumpLatestBtn = document.getElementById('pkm-jump-latest-btn');

    const cells = Array.from(trackEl.querySelectorAll<HTMLElement>('.pkm-cell'));
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.pkm-card'));

    let activeIndex = parseInt(rootEl.getAttribute('data-active-index') || '12', 10);

    function selectChapter(index: number, smoothScroll = true) {
      if (index < 0 || index >= cells.length) return;
      activeIndex = index;
      rootEl.setAttribute('data-active-index', String(index));

      // Update cells active state
      cells.forEach((cell) => {
        const cIdx = parseInt(cell.getAttribute('data-index') || '-1', 10);
        const isSel = cIdx === index;
        cell.classList.toggle('is-selected', isSel);
        cell.setAttribute('aria-selected', isSel ? 'true' : 'false');
      });

      // Update narrative deck card
      cards.forEach((card) => {
        const cIdx = parseInt(card.getAttribute('data-index') || '-1', 10);
        const isActive = cIdx === index;
        card.classList.toggle('is-active', isActive);
        card.setAttribute('aria-hidden', isActive ? 'false' : 'true');
      });

      // Scroll selected cell into view
      const targetCell = cells.find(c => parseInt(c.getAttribute('data-index') || '-1', 10) === index);
      if (targetCell && smoothScroll) {
        targetCell.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
      }
    }

    function setOrder(order: 'latest' | 'origin') {
      rootEl.setAttribute('data-order', order);

      if (order === 'latest') {
        orderLatestBtn?.classList.add('is-active');
        orderLatestBtn?.setAttribute('aria-pressed', 'true');
        orderOriginBtn?.classList.remove('is-active');
        orderOriginBtn?.setAttribute('aria-pressed', 'false');

        // Reverse cells visually in track: 12 down to 0
        const sorted = [...cells].sort((a, b) => {
          return parseInt(b.getAttribute('data-index') || '0', 10) - parseInt(a.getAttribute('data-index') || '0', 10);
        });
        sorted.forEach(el => trackEl.appendChild(el));
        selectChapter(12, true);
      } else {
        orderOriginBtn?.classList.add('is-active');
        orderOriginBtn?.setAttribute('aria-pressed', 'true');
        orderLatestBtn?.classList.remove('is-active');
        orderLatestBtn?.setAttribute('aria-pressed', 'false');

        // Normal chronological order: 0 up to 12
        const sorted = [...cells].sort((a, b) => {
          return parseInt(a.getAttribute('data-index') || '0', 10) - parseInt(b.getAttribute('data-index') || '0', 10);
        });
        sorted.forEach(el => trackEl.appendChild(el));
        selectChapter(0, true);
      }
    }

    // Cell click binding
    cells.forEach((cell) => {
      cell.addEventListener('click', () => {
        const idx = parseInt(cell.getAttribute('data-index') || '0', 10);
        selectChapter(idx, true);
      });

      cell.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          const idx = parseInt(cell.getAttribute('data-index') || '0', 10);
          selectChapter(idx, true);
        }
      });
    });

    // Prev / Next button actions (following current visual track order)
    function stepSelection(delta: number) {
      const currentTrackCells = Array.from(trackEl.querySelectorAll<HTMLElement>('.pkm-cell'));
      const currentIndexInTrack = currentTrackCells.findIndex(
        c => parseInt(c.getAttribute('data-index') || '-1', 10) === activeIndex
      );

      if (currentIndexInTrack === -1) return;
      const nextTrackIndex = Math.max(0, Math.min(currentTrackCells.length - 1, currentIndexInTrack + delta));
      const nextCell = currentTrackCells[nextTrackIndex];
      if (nextCell) {
        const nextTargetIndex = parseInt(nextCell.getAttribute('data-index') || '0', 10);
        selectChapter(nextTargetIndex, true);
      }
    }

    prevBtn?.addEventListener('click', () => stepSelection(-1));
    nextBtn?.addEventListener('click', () => stepSelection(1));

    // Jump Buttons
    jumpDay1Btn?.addEventListener('click', () => selectChapter(0, true));
    jumpLatestBtn?.addEventListener('click', () => selectChapter(12, true));

    // Order Switchers
    orderLatestBtn?.addEventListener('click', () => setOrder('latest'));
    orderOriginBtn?.addEventListener('click', () => setOrder('origin'));

    // Apply default initial order (latest first as requested)
    setOrder('latest');
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPokemonTimeline);
  } else {
    initPokemonTimeline();
  }
  document.addEventListener('astro:page-load', initPokemonTimeline);
</script>
