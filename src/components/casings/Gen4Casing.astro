---
// The Gen 4/5 skin's device casing — a DS-style clamshell drawn in CSS and
// inline SVG (BUILD.md §S/§T, ticket 20). It wraps Screen.astro without
// touching it: everything inside the bezel stays exactly as Screen renders
// it, so a later Game Boy or red-dex casing swaps in by replacing this file
// alone.
//
// No directional control is drawn. The real DS has one, but there is
// currently nothing on the site for it to page — the version selector
// (ticket 08) and roster paging (ticket 13) are both separate, blocked
// tickets, and wiring a D-pad to fake navigation here would mean this
// casing reaching into bezel content it isn't allowed to touch (DECISIONS.md
// §T2). Ticket 20's own acceptance criteria allow this: "a directional
// control pages the selection, or it is not drawn at all."
---

<div class="casing">
  <a class="add-btn" href="/become">+ ADD POKÉMON</a>
  <div class="shell">
    <div class="hinge" aria-hidden="true">
      <span class="camera"></span>
    </div>
    <div class="speaker" aria-hidden="true">
      <span></span><span></span><span></span><span></span>
    </div>
    <span class="led" aria-hidden="true"></span>
    <div class="slot">
      <slot />
    </div>
  </div>
</div>

<style>
  .casing {
    position: relative;
    max-width: calc(var(--device-max) + 64px);
    margin-inline: auto;
  }

  .add-btn {
    position: absolute;
    top: -8px;
    right: 12px;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    padding-inline: 14px;
    background: var(--accent);
    color: var(--bg);
    border: var(--border-w) solid var(--border);
    border-radius: var(--radius);
    font-family: var(--font-display);
    font-size: var(--fs-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--track-label);
    text-decoration: none;
  }

  @media (min-width: 768px) {
    .add-btn {
      top: -14px;
      box-shadow: 0 4px 10px color-mix(in srgb, var(--border) 60%, transparent);
    }
  }

  .shell {
    position: relative;
    padding: 4px;
    border-radius: calc(var(--radius) * 2);
    border: var(--border-w) solid var(--border);
    background: var(--panel);
  }

  /* Chrome — casing only, never inside the bezel (BUILD.md §S2). */
  @media (min-width: 768px) {
    .shell {
      padding: 32px 20px 24px;
      border-radius: 28px;
      background: linear-gradient(
        180deg,
        color-mix(in srgb, var(--panel) 88%, white 12%),
        var(--panel) 45%,
        color-mix(in srgb, var(--panel) 82%, black 18%)
      );
      box-shadow:
        0 16px 40px color-mix(in srgb, var(--border) 55%, transparent),
        inset 0 1px 0 color-mix(in srgb, white 12%, transparent 88%);
    }

    .hinge {
      position: absolute;
      top: 32px;
      bottom: 24px;
      left: 50%;
      width: 14px;
      transform: translateX(-50%);
      display: flex;
      justify-content: center;
      background: linear-gradient(
        90deg,
        transparent,
        color-mix(in srgb, var(--panel) 70%, black 30%) 35%,
        color-mix(in srgb, var(--panel) 70%, black 30%) 65%,
        transparent
      );
      pointer-events: none;
    }

    .camera {
      position: absolute;
      top: -20px;
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: color-mix(in srgb, var(--panel) 60%, black 40%);
      border: 1px solid color-mix(in srgb, var(--border) 80%, black 20%);
      box-shadow: inset 0 0 0 2px color-mix(in srgb, var(--panel) 88%, white 12%);
    }

    .speaker {
      position: absolute;
      top: 10px;
      right: 20px;
      display: flex;
      gap: 4px;
    }

    .speaker span {
      width: 4px;
      height: 4px;
      border-radius: 50%;
      background: color-mix(in srgb, var(--panel) 55%, black 45%);
    }

    .led {
      position: absolute;
      bottom: 8px;
      left: 20px;
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--accent);
      box-shadow: 0 0 4px 1px color-mix(in srgb, var(--accent) 70%, transparent);
    }

    @media (prefers-reduced-motion: no-preference) {
      .led {
        animation: pulse 2.4s ease-in-out infinite;
      }
    }
  }

  @keyframes pulse {
    50% { opacity: 0.4; }
  }

  /* Below 768px the casing thins to a bare bezel; Screen.astro's own
     single-column layout carries the two screens unchanged (BUILD.md §T3). */
  @media (max-width: 767.98px) {
    .hinge, .camera, .speaker, .led {
      display: none;
    }
  }
</style>
