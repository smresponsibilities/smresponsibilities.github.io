---
// The device shell: two stacked screens. Single column on narrow viewports,
// side by side once there's room (BUILD.md §2, ticket 02).
const hasBottom = Astro.slots.has('bottom');
---

<div class="device">
  <section class="screen screen--top" aria-label="Top screen">
    <slot name="top" />
  </section>
  <section class="screen screen--bottom" aria-label="Bottom screen">
    {hasBottom ? (
      <slot name="bottom" />
    ) : (
      <div class="resting">
        <span class="resting-dot" aria-hidden="true"></span>
        <span class="resting-label">STANDBY</span>
      </div>
    )}
  </section>
</div>

<style>
  .device {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--gap);
    max-width: var(--device-max);
    margin-inline: auto;
    padding: var(--gap);
  }

  @media (min-width: 768px) {
    .device {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }

  .screen {
    min-width: 0;
    background: var(--screen);
    border: var(--border-w) solid var(--border);
    border-radius: var(--radius);
    padding: var(--screen-pad);
    overflow-wrap: anywhere;
  }

  .screen--bottom {
    min-height: var(--screen-min-h);
    display: flex;
  }

  .resting {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: auto;
    color: var(--dim);
  }

  .resting-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent-2);
  }

  @media (prefers-reduced-motion: no-preference) {
    .resting-dot {
      animation: blink 1.2s steps(1) infinite;
    }
  }

  @keyframes blink {
    50% { opacity: 0.25; }
  }

  .resting-label {
    font-family: var(--font-display);
    font-size: var(--fs-label);
    text-transform: uppercase;
    letter-spacing: var(--track-label);
  }
</style>
