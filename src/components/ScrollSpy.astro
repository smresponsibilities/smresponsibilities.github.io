---
export interface ScrollSpySection {
  id: string;
  label: string;
}

interface Props {
  sections?: ScrollSpySection[];
  offset?: number;
  label?: string;
  target?: string;
  className?: string;
}

const {
  sections = [],
  offset = 96,
  label = "On this page",
  target = "main",
  className = "",
} = Astro.props;
---

<!-- Desktop Right-Rail ScrollSpy (Only visible on wide screens >= 1240px; never blocks text) -->
<aside 
  class={`scroll-spy-aside ${className}`} 
  aria-label={label}
  data-scroll-spy
  data-offset={offset}
  data-target={target}
>
  <div class="scroll-spy-inner">
    <div class="scroll-spy-header">
      <span class="scroll-spy-title">ON THIS PAGE</span>
    </div>

    <nav class="scroll-spy-nav" aria-label="Table of contents">
      <ol class="scroll-spy-list" role="list">
        {sections.map((section) => (
          <li class="scroll-spy-item" data-id={section.id}>
            <a href={`#${section.id}`} class="scroll-spy-link">
              <span class="scroll-spy-text">{section.label}</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>
  </div>
  <p class="sr-only" aria-live="polite" data-announce></p>
</aside>

<style>
  .scroll-spy-aside {
    display: none;
    position: fixed;
    top: 130px;
    right: max(16px, calc((100vw - 940px) / 2 - 195px));
    width: 175px;
    max-height: calc(100vh - 160px);
    overflow-y: auto;
    z-index: 50;
    user-select: none;
  }

  /* Only display on wide desktop viewports where there is empty gutter margin */
  @media (min-width: 1260px) {
    .scroll-spy-aside {
      display: block;
    }
  }

  .scroll-spy-inner {
    padding: 10px 12px;
    border-radius: 8px;
    background: color-mix(in srgb, var(--panel, #070c14) 80%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid color-mix(in srgb, var(--border, #1f293d) 60%, transparent);
  }

  .scroll-spy-header {
    margin-bottom: 8px;
    padding-bottom: 6px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .scroll-spy-title {
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    color: var(--dim, #64748b);
  }

  .scroll-spy-list {
    position: relative;
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 2px;
    border-left: 1px solid rgba(255, 255, 255, 0.08);
  }

  .scroll-spy-item {
    position: relative;
  }

  .scroll-spy-link {
    display: block;
    padding: 6px 10px;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-size: 11.5px;
    line-height: 1.4;
    color: var(--dim, #94a3b8) !important;
    text-decoration: none !important;
    border-left: 2px solid transparent;
    margin-left: -1px;
    border-radius: 0 4px 4px 0;
    transition: color 0.15s ease, border-color 0.15s ease, background 0.15s ease;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .scroll-spy-link:hover {
    color: #fff !important;
    background: rgba(255, 255, 255, 0.05);
  }

  .scroll-spy-item.is-active .scroll-spy-link {
    color: #fff !important;
    font-weight: 600;
    border-left-color: var(--rp-accent, #4568FF);
    background: color-mix(in srgb, var(--rp-accent, #4568FF) 15%, transparent);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }
</style>

<script>
  function formatCleanLabel(text: string): string {
    const clean = text.replace(/^[^\w\s]+/, '').trim();
    if (/what the post says/i.test(clean)) return 'Post Log';
    if (/related/i.test(clean)) return 'Related Logs';
    if (/pinned/i.test(clean)) return 'Pinned Milestones';
    if (/milestone/i.test(clean)) return 'Milestone';
    if (/featured/i.test(clean)) return 'Featured Projects';
    if (/timeline|archive/i.test(clean)) return 'Timeline & Archives';
    return clean.length > 20 ? clean.slice(0, 18) + '...' : clean;
  }

  function initScrollSpy() {
    const spies = document.querySelectorAll<HTMLElement>('[data-scroll-spy]');
    if (!spies.length) return;

    spies.forEach((spy) => {
      if (spy.dataset.initialized === 'true') return;
      spy.dataset.initialized = 'true';

      const targetSelector = spy.dataset.target || 'main';
      const targetEl = document.querySelector<HTMLElement>(targetSelector);
      if (!targetEl) return;

      const listEl = spy.querySelector<HTMLElement>('.scroll-spy-list');
      const announceEl = spy.querySelector<HTMLElement>('[data-announce]');
      const offset = parseInt(spy.dataset.offset || '96', 10);
      if (!listEl) return;

      // Auto-populate from headings if list is empty
      let items = Array.from(listEl.querySelectorAll<HTMLElement>('.scroll-spy-item'));
      if (items.length === 0) {
        const headings = targetEl.querySelectorAll<HTMLHeadingElement>('h2');
        headings.forEach((h, idx) => {
          let id = h.id;
          if (!id) {
            id = h.textContent
              ? h.textContent.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '')
              : `section-${idx + 1}`;
            h.id = id;
          }

          const rawText = h.textContent || `Section ${idx + 1}`;
          const cleanLabel = formatCleanLabel(rawText);

          const li = document.createElement('li');
          li.className = 'scroll-spy-item';
          li.dataset.id = id;

          const a = document.createElement('a');
          a.href = `#${id}`;
          a.className = 'scroll-spy-link';
          a.title = rawText;

          const span = document.createElement('span');
          span.className = 'scroll-spy-text';
          span.textContent = cleanLabel;

          a.appendChild(span);
          li.appendChild(a);
          listEl.appendChild(li);
        });

        items = Array.from(listEl.querySelectorAll<HTMLElement>('.scroll-spy-item'));
      }

      if (items.length === 0) {
        spy.style.display = 'none';
        return;
      }

      let activeId = items[0].dataset.id || '';
      let lock: string | null = null;
      let lockTimer: number | null = null;
      let rAF = 0;

      const highlightItem = (id: string) => {
        items.forEach((item) => {
          const isActive = item.dataset.id === id;
          item.classList.toggle('is-active', isActive);
          const link = item.querySelector<HTMLAnchorElement>('.scroll-spy-link');
          if (link) {
            if (isActive) link.setAttribute('aria-current', 'location');
            else link.removeAttribute('aria-current');
          }
        });

        if (announceEl) {
          const activeItem = listEl.querySelector<HTMLElement>(`[data-id="${id}"]`);
          const textEl = activeItem?.querySelector('.scroll-spy-text');
          announceEl.textContent = textEl?.textContent || '';
        }
      };

      // Interior.dev sliding reading line algorithm
      const measure = () => {
        const viewport = window.innerHeight;
        const top = window.scrollY;
        const max = document.documentElement.scrollHeight - viewport;
        const ratio = max > 0 ? Math.min(1, Math.max(0, top / max)) : 1;

        const line = offset + ratio * Math.max(0, viewport - offset - 1);

        let current = '';
        let last = '';

        for (const item of items) {
          const id = item.dataset.id;
          if (!id) continue;
          const node = document.getElementById(id);
          if (!node) continue;
          last = id;
          if (!current) current = id;
          if (node.getBoundingClientRect().top <= line + 1) {
            current = id;
          }
        }

        const atEnd = window.scrollY + viewport >= document.documentElement.scrollHeight - 2;
        return atEnd && last ? last : current;
      };

      const sync = () => {
        rAF = 0;
        const next = measure();
        if (!next) return;

        if (lock) {
          if (lock === next) {
            lock = null;
            if (lockTimer) clearTimeout(lockTimer);
          }
          return;
        }

        if (next !== activeId) {
          activeId = next;
          highlightItem(activeId);
        }
      };

      const schedule = () => {
        if (rAF) return;
        rAF = requestAnimationFrame(sync);
      };

      // Destination scroll lock
      const scrollTo = (id: string) => {
        const node = document.getElementById(id);
        if (!node) return;

        lock = id;
        activeId = id;
        highlightItem(id);

        const rect = node.getBoundingClientRect();
        const viewport = window.innerHeight;
        const max = Math.max(0, document.documentElement.scrollHeight - viewport);
        const H = rect.top + window.scrollY;
        const usable = Math.max(0, viewport - offset - 1);
        const targetTop = max > 0 ? Math.min(max, Math.max(0, (H - offset) / (1 + usable / max))) : 0;

        window.scrollTo({ top: targetTop, behavior: 'smooth' });

        if (!node.hasAttribute('tabindex')) node.setAttribute('tabindex', '-1');
        node.focus({ preventScroll: true });

        if (lockTimer) clearTimeout(lockTimer);
        lockTimer = window.setTimeout(() => {
          lock = null;
          sync();
        }, 900);
      };

      listEl.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        const link = target.closest<HTMLAnchorElement>('.scroll-spy-link');
        if (!link) return;

        if (e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
        e.preventDefault();

        const href = link.getAttribute('href');
        if (href && href.startsWith('#')) {
          scrollTo(href.slice(1));
        }
      });

      const abandon = () => {
        if (lock) {
          lock = null;
          if (lockTimer) clearTimeout(lockTimer);
        }
      };

      window.addEventListener('scroll', schedule, { passive: true });
      window.addEventListener('resize', schedule);
      window.addEventListener('wheel', abandon, { passive: true });
      window.addEventListener('touchstart', abandon, { passive: true });

      if (typeof ResizeObserver !== 'undefined') {
        const ro = new ResizeObserver(schedule);
        ro.observe(targetEl);
      }

      highlightItem(activeId);
      sync();
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initScrollSpy);
  } else {
    initScrollSpy();
  }
  document.addEventListener('astro:page-load', initScrollSpy);
</script>
