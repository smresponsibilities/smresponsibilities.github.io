---
export interface ScrollSpySection {
  id: string;
  label: string;
}

interface Props {
  sections?: ScrollSpySection[];
  offset?: number;
  label?: string;
  target?: string;
  className?: string;
}

const {
  sections = [],
  offset = 96,
  label = "On this page",
  target = "main",
  className = "",
} = Astro.props;
---

<!-- Vertical ScrollSpy Table of Contents (No truncation, zero underlines, pure sans-serif) -->
<nav 
  class={`interior-scroll-spy ${className}`} 
  aria-label={label}
  data-scroll-spy
  data-offset={offset}
  data-target={target}
>
  <div class="scroll-spy-card">
    <div class="scroll-spy-header">
      <span class="scroll-spy-badge" aria-hidden="true"></span>
      <span class="scroll-spy-title">On this page</span>
    </div>

    <div class="scroll-spy-track">
      <ol class="scroll-spy-list" role="list">
        {sections.map((section) => (
          <li class="scroll-spy-item" data-id={section.id}>
            <a href={`#${section.id}`} class="scroll-spy-link">
              <span class="scroll-spy-text">{section.label}</span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </div>
  <p class="sr-only" aria-live="polite" data-announce></p>
</nav>

<style>
  .interior-scroll-spy {
    display: block;
    width: 100%;
    margin: 24px 0 32px;
    user-select: none;
  }

  /* Desktop right-rail gutter dock on wide viewports (>= 1260px) */
  @media (min-width: 1260px) {
    .interior-scroll-spy {
      position: fixed;
      top: 100px;
      right: max(20px, calc((100vw - 940px) / 2 - 250px));
      width: 235px;
      margin: 0;
      z-index: 50;
      max-height: calc(100vh - 140px);
      overflow-y: auto;
    }
  }

  .scroll-spy-card {
    position: relative;
    padding: 14px 16px;
    border-radius: 12px;
    background: rgba(14, 18, 28, 0.88);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.28);
  }

  :global(.light) .scroll-spy-card {
    background: rgba(245, 245, 245, 0.94);
    border-color: rgba(0, 0, 0, 0.08);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.06);
  }

  .scroll-spy-header {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 10px;
    padding-bottom: 8px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  :global(.light) .scroll-spy-header {
    border-bottom-color: rgba(0, 0, 0, 0.06);
  }

  .scroll-spy-badge {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #4568FF;
    box-shadow: 0 0 8px #4568FF;
  }

  .scroll-spy-title {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif !important;
    font-size: 11px !important;
    font-weight: 700 !important;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    color: #64748b;
  }

  :global(.light) .scroll-spy-title {
    color: #94a3b8;
  }

  .scroll-spy-track {
    position: relative;
  }

  .scroll-spy-list {
    position: relative;
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 3px;
    border-left: 1px solid rgba(255, 255, 255, 0.06);
  }

  :global(.light) .scroll-spy-list {
    border-left-color: rgba(0, 0, 0, 0.08);
  }

  .scroll-spy-item {
    position: relative;
    margin: 0;
    padding: 0;
  }

  /* Force override any global .editorial a inheritance (kill underlines & monospace font) */
  :global(.editorial) a.scroll-spy-link,
  :global(.editorial a.scroll-spy-link),
  a.scroll-spy-link {
    display: flex !important;
    align-items: center !important;
    padding: 7px 12px !important;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif !important;
    font-size: 13px !important;
    line-height: 1.4 !important;
    font-weight: 500 !important;
    color: #94a3b8 !important;
    text-decoration: none !important;
    text-decoration-line: none !important;
    text-underline-offset: unset !important;
    border-bottom: none !important;
    border-left: 2px solid transparent !important;
    margin-left: -1px;
    background: transparent !important;
    border-radius: 0 6px 6px 0 !important;
    transition: color 0.15s ease, background 0.15s ease, border-color 0.15s ease !important;
    cursor: pointer !important;
    white-space: normal !important;
    word-break: break-word !important;
  }

  :global(.light .editorial) a.scroll-spy-link,
  :global(.light .editorial a.scroll-spy-link),
  :global(.light) a.scroll-spy-link {
    color: #64748b !important;
  }

  :global(.editorial) a.scroll-spy-link:hover,
  :global(.editorial a.scroll-spy-link:hover),
  a.scroll-spy-link:hover {
    color: #ffffff !important;
    text-decoration: none !important;
    text-decoration-line: none !important;
    background: rgba(255, 255, 255, 0.05) !important;
    border-left-color: rgba(255, 255, 255, 0.25) !important;
  }

  :global(.light .editorial) a.scroll-spy-link:hover,
  :global(.light .editorial a.scroll-spy-link:hover),
  :global(.light) a.scroll-spy-link:hover {
    color: #0f172a !important;
    background: rgba(0, 0, 0, 0.04) !important;
    border-left-color: rgba(0, 0, 0, 0.2) !important;
  }

  :global(.editorial) .scroll-spy-item.is-active a.scroll-spy-link,
  :global(.editorial .scroll-spy-item.is-active a.scroll-spy-link),
  .scroll-spy-item.is-active a.scroll-spy-link {
    color: #ffffff !important;
    font-weight: 600 !important;
    text-decoration: none !important;
    text-decoration-line: none !important;
    background: rgba(69, 104, 255, 0.12) !important;
    border-left-color: #4568FF !important;
  }

  :global(.light .editorial) .scroll-spy-item.is-active a.scroll-spy-link,
  :global(.light .editorial .scroll-spy-item.is-active a.scroll-spy-link),
  :global(.light) .scroll-spy-item.is-active a.scroll-spy-link {
    color: #0f172a !important;
    background: rgba(69, 104, 255, 0.1) !important;
    border-left-color: #4568FF !important;
  }

  .scroll-spy-link:focus-visible {
    box-shadow: inset 0 0 0 2px #4568FF;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }
</style>

<script>
  function formatCleanLabel(text: string): string {
    // Strip leading emojis or bullet symbols (e.g. "🎉 ") without truncating any text
    return text.replace(/^[^\w\s]+/, '').trim();
  }

  function initScrollSpy() {
    const spies = document.querySelectorAll<HTMLElement>('[data-scroll-spy]');
    if (!spies.length) return;

    spies.forEach((spy) => {
      if (spy.dataset.initialized === 'true') return;
      spy.dataset.initialized = 'true';

      const targetSelector = spy.dataset.target || 'main';
      const targetEl = document.querySelector<HTMLElement>(targetSelector);
      if (!targetEl) return;

      const listEl = spy.querySelector<HTMLElement>('.scroll-spy-list');
      const announceEl = spy.querySelector<HTMLElement>('[data-announce]');
      const offset = parseInt(spy.dataset.offset || '96', 10);
      if (!listEl) return;

      // Auto-populate from headings if list is empty
      let items = Array.from(listEl.querySelectorAll<HTMLElement>('.scroll-spy-item'));
      if (items.length === 0) {
        const headings = targetEl.querySelectorAll<HTMLHeadingElement>('h2');
        headings.forEach((h, idx) => {
          let id = h.id;
          if (!id) {
            id = h.textContent
              ? h.textContent.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '')
              : `section-${idx + 1}`;
            h.id = id;
          }

          const rawText = h.textContent || `Section ${idx + 1}`;
          const cleanLabel = formatCleanLabel(rawText);

          const li = document.createElement('li');
          li.className = 'scroll-spy-item';
          li.dataset.id = id;

          const a = document.createElement('a');
          a.href = `#${id}`;
          a.className = 'scroll-spy-link';
          a.title = rawText;

          const span = document.createElement('span');
          span.className = 'scroll-spy-text';
          span.textContent = cleanLabel;

          a.appendChild(span);
          li.appendChild(a);
          listEl.appendChild(li);
        });

        items = Array.from(listEl.querySelectorAll<HTMLElement>('.scroll-spy-item'));
      }

      // Hide scrollspy if fewer than 2 sections exist
      if (items.length < 2) {
        spy.style.display = 'none';
        return;
      }

      let activeId = items[0].dataset.id || '';
      let lock: string | null = null;
      let lockTimer: number | null = null;
      let rAF = 0;

      const highlightItem = (id: string) => {
        items.forEach((item) => {
          const isActive = item.dataset.id === id;
          item.classList.toggle('is-active', isActive);
          const link = item.querySelector<HTMLAnchorElement>('.scroll-spy-link');
          if (link) {
            if (isActive) link.setAttribute('aria-current', 'location');
            else link.removeAttribute('aria-current');
          }
        });

        if (announceEl) {
          const activeItem = listEl.querySelector<HTMLElement>(`[data-id="${id}"]`);
          const textEl = activeItem?.querySelector('.scroll-spy-text');
          announceEl.textContent = textEl?.textContent || '';
        }
      };

      // Interior.dev sliding reading line algorithm
      const measure = () => {
        const viewport = window.innerHeight;
        const top = window.scrollY;
        const max = document.documentElement.scrollHeight - viewport;
        const ratio = max > 0 ? Math.min(1, Math.max(0, top / max)) : 1;

        const line = offset + ratio * Math.max(0, viewport - offset - 1);

        let current = '';
        let last = '';

        for (const item of items) {
          const id = item.dataset.id;
          if (!id) continue;
          const node = document.getElementById(id);
          if (!node) continue;
          last = id;
          if (!current) current = id;
          if (node.getBoundingClientRect().top <= line + 1) {
            current = id;
          }
        }

        const atEnd = window.scrollY + viewport >= document.documentElement.scrollHeight - 2;
        return atEnd && last ? last : current;
      };

      const sync = () => {
        rAF = 0;
        const next = measure();
        if (!next) return;

        if (lock) {
          if (lock === next) {
            lock = null;
            if (lockTimer) clearTimeout(lockTimer);
          }
          return;
        }

        if (next !== activeId) {
          activeId = next;
          highlightItem(activeId);
        }
      };

      const schedule = () => {
        if (rAF) return;
        rAF = requestAnimationFrame(sync);
      };

      // Destination scroll lock
      const scrollTo = (id: string) => {
        const node = document.getElementById(id);
        if (!node) return;

        lock = id;
        activeId = id;
        highlightItem(id);

        const rect = node.getBoundingClientRect();
        const viewport = window.innerHeight;
        const max = Math.max(0, document.documentElement.scrollHeight - viewport);
        const H = rect.top + window.scrollY;
        const usable = Math.max(0, viewport - offset - 1);
        const targetTop = max > 0 ? Math.min(max, Math.max(0, (H - offset) / (1 + usable / max))) : 0;

        window.scrollTo({ top: targetTop, behavior: 'smooth' });

        if (!node.hasAttribute('tabindex')) node.setAttribute('tabindex', '-1');
        node.focus({ preventScroll: true });

        if (lockTimer) clearTimeout(lockTimer);
        lockTimer = window.setTimeout(() => {
          lock = null;
          sync();
        }, 900);
      };

      listEl.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        const link = target.closest<HTMLAnchorElement>('.scroll-spy-link');
        if (!link) return;

        if (e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
        e.preventDefault();

        const href = link.getAttribute('href');
        if (href && href.startsWith('#')) {
          scrollTo(href.slice(1));
        }
      });

      const abandon = () => {
        if (lock) {
          lock = null;
          if (lockTimer) clearTimeout(lockTimer);
        }
      };

      window.addEventListener('scroll', schedule, { passive: true });
      window.addEventListener('resize', () => {
        highlightItem(activeId);
        schedule();
      });
      window.addEventListener('wheel', abandon, { passive: true });
      window.addEventListener('touchstart', abandon, { passive: true });

      if (typeof ResizeObserver !== 'undefined') {
        const ro = new ResizeObserver(() => {
          highlightItem(activeId);
          schedule();
        });
        ro.observe(targetEl);
      }

      highlightItem(activeId);
      sync();
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initScrollSpy);
  } else {
    initScrollSpy();
  }
  document.addEventListener('astro:page-load', initScrollSpy);
</script>
