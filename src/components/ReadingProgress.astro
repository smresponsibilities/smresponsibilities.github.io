---
interface Props {
  words?: number;
  wordsPerMinute?: number;
  steps?: number;
  label?: string;
  doneLabel?: string;
  target?: string;
  className?: string;
}

const {
  words = 0,
  wordsPerMinute = 220,
  steps = 24,
  label = "Reading progress",
  doneLabel = "End",
  target = "main",
  className = "",
} = Astro.props;

const initialMinutes = words > 0 ? Math.max(1, Math.ceil(words / wordsPerMinute)) : 1;
---

<!-- Interior.dev Reading Progress (Vertical + Top hairline + Floating Badge) -->
<div 
  class={`interior-reading-progress ${className}`}
  data-reading-progress
  data-words={words}
  data-wpm={wordsPerMinute}
  data-steps={steps}
  data-label={label}
  data-done-label={doneLabel}
  data-target={target}
>
  <!-- Top hairline indicator (fixed) -->
  <div
    class="rp-top-track"
    role="progressbar"
    aria-label={label}
    aria-valuemin={0}
    aria-valuemax={steps}
    aria-valuenow={0}
    aria-valuetext={`0% read, ${initialMinutes} min left`}
  >
    <div class="rp-top-fill" style="transform: scaleX(0);"></div>
  </div>

  <!-- Vertical right-rail progress bar (interior.dev vertical style) -->
  <div class="rp-vertical-track" aria-hidden="true">
    <div class="rp-vertical-fill" style="transform: scaleY(0);"></div>
  </div>

  <!-- Floating pill badge in top right (interior.dev signature readout) -->
  <aside class="rp-floating-badge" aria-hidden="true">
    <span class="rp-time-text">{initialMinutes} min left</span>
    <span class="rp-end-text">
      <svg width="12" height="12" viewBox="0 0 256 256" fill="none" class="rp-check-icon">
        <polyline
          class="rp-check-path"
          points="216 72 104 184 48 128"
          stroke="currentColor"
          stroke-width="24"
          stroke-linecap="round"
          stroke-linejoin="round"
          pathLength="1"
        />
      </svg>
      <span>{doneLabel} · {initialMinutes} min</span>
    </span>
  </aside>
</div>

<style>
  .interior-reading-progress {
    pointer-events: none;
    user-select: none;
  }

  /* Fixed top hairline progress track */
  .rp-top-track {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: #08101a;
    border-bottom: 1px solid var(--border, #343840);
    z-index: 1000;
    overflow: hidden;
  }

  .rp-top-fill {
    width: 100%;
    height: 100%;
    transform-origin: left;
    background: var(--time-accent, #ffd75e);
    box-shadow: 0 0 8px rgba(255, 215, 94, 0.4);
    transform: scaleX(0);
    transition: transform 0.22s cubic-bezier(0.23, 1, 0.32, 1);
    will-change: transform;
  }

  /* Vertical right-rail progress track */
  .rp-vertical-track {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: 3px;
    height: 100vh;
    background: #08101a;
    border-left: 1px solid var(--border, #343840);
    z-index: 1000;
    overflow: hidden;
  }

  .rp-vertical-fill {
    width: 100%;
    height: 100%;
    transform-origin: top;
    background: var(--time-accent, #ffd75e);
    transform: scaleY(0);
    transition: transform 0.22s cubic-bezier(0.23, 1, 0.32, 1);
    will-change: transform;
  }

  /* Discreet floating readout badge in top right */
  .rp-floating-badge {
    position: fixed;
    top: 12px;
    right: 18px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    border-radius: 2px;
    background: #111722;
    border: 1px solid var(--border, #343840);
    box-shadow: 2px 2px 0 #05070b;
    font-family: var(--font-display, "Departure Mono", monospace);
    font-size: 11px;
    letter-spacing: var(--track-label, 0.08em);
    text-transform: uppercase;
    font-variant-numeric: tabular-nums;
    color: var(--dim, #959ba8);
    pointer-events: none;
    opacity: 0;
    transform: translateY(-4px);
    transition: opacity 0.25s ease, transform 0.25s ease;
    z-index: 1001;
  }

  .interior-reading-progress.is-scrolled .rp-floating-badge {
    opacity: 1;
    transform: translateY(0);
  }

  .rp-end-text {
    display: none;
    align-items: center;
    gap: 6px;
    color: var(--time-accent, #ffd75e);
  }

  .rp-check-icon {
    width: 12px;
    height: 12px;
    color: var(--time-accent, #ffd75e);
  }

  .rp-check-path {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 0.3s cubic-bezier(0.23, 1, 0.32, 1) 0.08s;
  }

  .interior-reading-progress.is-complete .rp-time-text {
    display: none;
  }

  .interior-reading-progress.is-complete .rp-end-text {
    display: inline-flex;
  }

  .interior-reading-progress.is-complete .rp-check-path {
    stroke-dashoffset: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .rp-top-fill,
    .rp-vertical-fill,
    .rp-floating-badge,
    .rp-check-path {
      transition: none !important;
    }
  }
</style>

<script>
  function initReadingProgress() {
    const bars = document.querySelectorAll<HTMLElement>('[data-reading-progress]');
    if (!bars.length) return;

    bars.forEach((bar) => {
      if (bar.dataset.initialized === 'true') return;
      bar.dataset.initialized = 'true';

      const targetEl = document.querySelector<HTMLElement>('main');
      const track = bar.querySelector<HTMLElement>('[role="progressbar"]');
      const topFill = bar.querySelector<HTMLElement>('.rp-top-fill');
      const vertFill = bar.querySelector<HTMLElement>('.rp-vertical-fill');
      const timeText = bar.querySelector<HTMLElement>('.rp-time-text');
      const endTextSpan = bar.querySelector<HTMLElement>('.rp-end-text span');

      const wpm = 220;
      const steps = 24;
      const baseDoneLabel = bar.dataset.doneLabel || 'End';

      let words = parseInt(bar.dataset.words || '0', 10);
      if (words <= 0 && targetEl) {
        const text = targetEl.innerText || targetEl.textContent || '';
        words = text.trim().split(/\s+/).filter(Boolean).length;
      }

      const totalMinutes = words > 0 ? Math.max(1, Math.ceil(words / wpm)) : 1;
      const finishText = `${baseDoneLabel} · ${totalMinutes} min`;
      if (endTextSpan) endTextSpan.textContent = finishText;

      let currentStep = -1;
      let rAF = 0;

      const updateProgress = () => {
        rAF = 0;
        const viewport = window.innerHeight;
        let ratio = 0;

        if (targetEl) {
          const rect = targetEl.getBoundingClientRect();
          const travel = rect.height - viewport;
          ratio = travel <= 0 ? 1 : -rect.top / travel;
        } else {
          const doc = document.documentElement;
          const travel = doc.scrollHeight - viewport;
          ratio = travel <= 0 ? 1 : window.scrollY / travel;
        }

        const clamped = Math.max(0, Math.min(1, Number.isFinite(ratio) ? ratio : 0));
        const nextStep = Math.round(clamped * steps);

        // Show floating readout badge after scroll starts (> 50px)
        const isScrolled = window.scrollY > 50;
        bar.classList.toggle('is-scrolled', isScrolled);

        if (nextStep === currentStep) return;
        currentStep = nextStep;

        const progress = nextStep / steps;
        const percent = Math.round(progress * 100);
        const complete = nextStep >= steps;
        const minutesLeft = Math.max(0, Math.ceil(((1 - progress) * words) / wpm));

        if (topFill) topFill.style.transform = `scaleX(${progress})`;
        if (vertFill) vertFill.style.transform = `scaleY(${progress})`;
        if (timeText) timeText.textContent = `${minutesLeft} min left`;

        bar.classList.toggle('is-complete', complete);

        if (track) {
          const valueText = words > 0
            ? (complete ? `100% read, ${finishText}` : `${percent}% read, ${minutesLeft} min left`)
            : `${percent}% read`;
          track.setAttribute('aria-valuenow', String(nextStep));
          track.setAttribute('aria-valuetext', valueText);
        }
      };

      const schedule = () => {
        if (rAF) return;
        rAF = requestAnimationFrame(updateProgress);
      };

      window.addEventListener('scroll', schedule, { passive: true });
      window.addEventListener('resize', schedule);

      if (typeof ResizeObserver !== 'undefined' && targetEl) {
        const ro = new ResizeObserver(schedule);
        ro.observe(targetEl);
      }

      updateProgress();
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initReadingProgress);
  } else {
    initReadingProgress();
  }
  document.addEventListener('astro:page-load', initReadingProgress);
</script>
