---
interface Props {
  words?: number;
  wordsPerMinute?: number;
  steps?: number;
  label?: string;
  doneLabel?: string;
  target?: string;
  className?: string;
}

const {
  words = 0,
  wordsPerMinute = 220,
  steps = 24,
  label = "Reading progress",
  doneLabel = "End",
  target = "main",
  className = "",
} = Astro.props;

const initialMinutes = words > 0 ? Math.max(1, Math.ceil(words / wordsPerMinute)) : 1;
---

<!-- Fixed top hairline progress track (0 content intrusion) -->
<div 
  class={`reading-progress-bar ${className}`}
  data-reading-progress
  data-words={words}
  data-wpm={wordsPerMinute}
  data-steps={steps}
  data-label={label}
  data-done-label={doneLabel}
  data-target={target}
>
  <div
    class="rp-line-track"
    role="progressbar"
    aria-label={label}
    aria-valuemin={0}
    aria-valuemax={steps}
    aria-valuenow={0}
    aria-valuetext={`0% read, ${initialMinutes} min left`}
  >
    <div class="rp-line-fill" style="transform: scaleX(0);"></div>
  </div>

  <!-- Discreet floating pill at top-right -->
  <aside class="rp-floating-badge" aria-hidden="true">
    <span class="rp-time-text">{initialMinutes} min left</span>
    <span class="rp-end-text">
      <svg width="12" height="12" viewBox="0 0 256 256" fill="none" class="rp-check-icon">
        <polyline
          class="rp-check-path"
          points="216 72 104 184 48 128"
          stroke="currentColor"
          stroke-width="24"
          stroke-linecap="round"
          stroke-linejoin="round"
          pathLength="1"
        />
      </svg>
      <span>{doneLabel} · {initialMinutes} min</span>
    </span>
  </aside>
</div>

<style>
  .reading-progress-bar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    width: 100%;
    height: 3px;
    z-index: 1000;
    pointer-events: none;
  }

  .rp-line-track {
    width: 100%;
    height: 100%;
    background: rgba(255, 255, 255, 0.08);
    overflow: hidden;
  }

  :global(.light) .rp-line-track {
    background: rgba(0, 0, 0, 0.07);
  }

  .rp-line-fill {
    width: 100%;
    height: 100%;
    transform-origin: left;
    background: var(--rp-accent, #4568FF);
    transform: scaleX(0);
    transition: transform 0.25s cubic-bezier(0.23, 1, 0.32, 1);
    will-change: transform;
  }

  /* Minimal floating readout in top right corner */
  .rp-floating-badge {
    position: fixed;
    top: 8px;
    right: 16px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 3px 8px;
    border-radius: 4px;
    background: color-mix(in srgb, var(--panel, #070c14) 85%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid color-mix(in srgb, var(--border, #1f293d) 60%, transparent);
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 10.5px;
    font-variant-numeric: tabular-nums;
    color: var(--dim, #94a3b8);
    pointer-events: none;
    opacity: 0;
    transform: translateY(-4px);
    transition: opacity 0.25s ease, transform 0.25s ease;
    user-select: none;
    z-index: 1001;
  }

  .reading-progress-bar.is-scrolled .rp-floating-badge {
    opacity: 1;
    transform: translateY(0);
  }

  .rp-end-text {
    display: none;
    align-items: center;
    gap: 4px;
    color: var(--ink, #f1f5f9);
  }

  .rp-check-icon {
    width: 11px;
    height: 11px;
    color: var(--rp-accent, #4568FF);
  }

  .rp-check-path {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 0.3s cubic-bezier(0.23, 1, 0.32, 1) 0.08s;
  }

  .reading-progress-bar.is-complete .rp-time-text {
    display: none;
  }

  .reading-progress-bar.is-complete .rp-end-text {
    display: inline-flex;
  }

  .reading-progress-bar.is-complete .rp-check-path {
    stroke-dashoffset: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .rp-line-fill,
    .rp-floating-badge,
    .rp-check-path {
      transition: none !important;
    }
  }
</style>

<script>
  function initReadingProgress() {
    const bars = document.querySelectorAll<HTMLElement>('[data-reading-progress]');
    if (!bars.length) return;

    bars.forEach((bar) => {
      if (bar.dataset.initialized === 'true') return;
      bar.dataset.initialized = 'true';

      const targetEl = document.querySelector<HTMLElement>('main');
      const track = bar.querySelector<HTMLElement>('[role="progressbar"]');
      const fillEl = bar.querySelector<HTMLElement>('.rp-line-fill');
      const timeText = bar.querySelector<HTMLElement>('.rp-time-text');
      const endTextSpan = bar.querySelector<HTMLElement>('.rp-end-text span');

      const wpm = 220;
      const steps = 24;
      const baseDoneLabel = bar.dataset.doneLabel || 'End';

      let words = parseInt(bar.dataset.words || '0', 10);
      if (words <= 0 && targetEl) {
        const text = targetEl.innerText || targetEl.textContent || '';
        words = text.trim().split(/\s+/).filter(Boolean).length;
      }

      const totalMinutes = words > 0 ? Math.max(1, Math.ceil(words / wpm)) : 1;
      const finishText = `${baseDoneLabel} · ${totalMinutes} min`;
      if (endTextSpan) endTextSpan.textContent = finishText;

      let currentStep = -1;
      let rAF = 0;

      const updateProgress = () => {
        rAF = 0;
        const viewport = window.innerHeight;
        let ratio = 0;

        if (targetEl) {
          const rect = targetEl.getBoundingClientRect();
          const travel = rect.height - viewport;
          ratio = travel <= 0 ? 1 : -rect.top / travel;
        } else {
          const doc = document.documentElement;
          const travel = doc.scrollHeight - viewport;
          ratio = travel <= 0 ? 1 : window.scrollY / travel;
        }

        const clamped = Math.max(0, Math.min(1, Number.isFinite(ratio) ? ratio : 0));
        const nextStep = Math.round(clamped * steps);

        // Show floating readout badge only after user starts scrolling (scroll > 60px)
        const isScrolled = window.scrollY > 60;
        bar.classList.toggle('is-scrolled', isScrolled);

        if (nextStep === currentStep) return;
        currentStep = nextStep;

        const progress = nextStep / steps;
        const percent = Math.round(progress * 100);
        const complete = nextStep >= steps;
        const minutesLeft = Math.max(0, Math.ceil(((1 - progress) * words) / wpm));

        if (fillEl) fillEl.style.transform = `scaleX(${progress})`;
        if (timeText) timeText.textContent = `${minutesLeft} min left`;

        bar.classList.toggle('is-complete', complete);

        if (track) {
          const valueText = words > 0
            ? (complete ? `100% read, ${finishText}` : `${percent}% read, ${minutesLeft} min left`)
            : `${percent}% read`;
          track.setAttribute('aria-valuenow', String(nextStep));
          track.setAttribute('aria-valuetext', valueText);
        }
      };

      const schedule = () => {
        if (rAF) return;
        rAF = requestAnimationFrame(updateProgress);
      };

      window.addEventListener('scroll', schedule, { passive: true });
      window.addEventListener('resize', schedule);

      if (typeof ResizeObserver !== 'undefined' && targetEl) {
        const ro = new ResizeObserver(schedule);
        ro.observe(targetEl);
      }

      updateProgress();
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initReadingProgress);
  } else {
    initReadingProgress();
  }
  document.addEventListener('astro:page-load', initReadingProgress);
</script>
