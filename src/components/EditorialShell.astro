---
import Base from '../layouts/Base.astro';
import SiteHeader from './SiteHeader.astro';
import ReadingProgress from './ReadingProgress.astro';
import ScrollSpy from './ScrollSpy.astro';
import '../styles/editorial.css';

interface Props { 
  title: string; 
  description: string; 
  eyebrow: string; 
  heading: string; 
  intro: string;
  structuredData?: Record<string, unknown>;
  readingProgress?: boolean;
  scrollSpy?: boolean;
  words?: number;
}

const { title, description, eyebrow, heading, intro, structuredData, readingProgress, scrollSpy, words } = Astro.props;

// Only enable on individual long-form reading articles, NEVER on directory/index/archive/month pages
const pathname = Astro.url.pathname.replace(/\/$/, '');
const isArticlePath = /^\/blog\/(day-\d+|how-the-sm-dex-roster-works|shivam-mahajan(-software-developer)?)$/.test(pathname);

const showReadingProgress = readingProgress ?? isArticlePath;
const showScrollSpy = scrollSpy ?? isArticlePath;
---
<Base title={title} description={description} structuredData={structuredData} accentTypes={['dragon','steel']}>
  {showReadingProgress && <ReadingProgress words={words} target="main" />}
  <SiteHeader currentPath={Astro.url.pathname} />
  <div class="editorial">
    <main>
      <div class="hero">
        <span class="eyebrow">{eyebrow}</span>
        <h1>{heading}</h1>
        <p class="lead">{intro}</p>
        <div class="actions"><slot name="actions" /></div>
      </div>
      {showScrollSpy && <ScrollSpy target="main" offset={96} />}
      <slot />
    </main>
  </div>
  <footer class="site-footer">Pokémon © Nintendo / Creatures / GAME FREAK · Tested by my friends.</footer>
</Base>

<style>
  .site-footer {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 32px 20px;
    background: var(--time-deep, #08101a);
    border-top: 1px solid var(--time-accent, var(--border));
    box-shadow: inset 0 3px var(--time-accent, #ffd75e);
    color: #fff;
    font-size: 13px;
    font-family: var(--font-display, monospace);
    text-align: center;
  }
</style>
