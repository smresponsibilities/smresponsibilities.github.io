<style>
  .portfolio-header.is-home,
  .portfolio-header.is-subpage {
    position: relative;
    z-index: 50;
    width: 100%;
    margin: 0;
    background: var(--time-deep, #08101a);
    border-bottom: 1px solid var(--time-accent, var(--border));
    box-shadow: inset 0 -3px var(--time-accent, #ffd75e);
  }

  .portfolio-header.is-home {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 24px;
    padding: 20px clamp(20px, 4vw, 64px);
  }

  .portfolio-header.is-subpage {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    padding: 16px clamp(16px, 4vw, 48px);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    color: var(--ink);
    font: 400 var(--fs-head) / 1 var(--font-display);
    text-decoration: none !important;
    letter-spacing: var(--track-label);
    white-space: nowrap;
  }

  .portfolio-header p {
    max-width: 65ch;
    margin: 0;
    color: #fff;
    font-size: 16px;
    line-height: 1.5;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .header-nav {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .nav-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 38px;
    padding: 0 13px;
    border: 1px solid var(--border, #343840);
    border-radius: 2px;
    background: #111722;
    box-shadow: 3px 3px 0 #05070b;
    color: var(--ink, #e8eddf);
    font-family: var(--font-display, "Departure Mono", monospace);
    font-size: 11.5px;
    font-weight: 500;
    letter-spacing: var(--track-label, 0.08em);
    text-transform: uppercase;
    text-decoration: none !important;
    cursor: pointer;
    white-space: nowrap;
    outline: none;
    transition: transform 0.12s cubic-bezier(0.23, 1, 0.32, 1), background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease, box-shadow 0.15s ease;
  }

  .nav-btn:hover {
    background: #162030;
    border-color: var(--time-accent, #ffd75e);
    color: var(--time-accent, #ffd75e);
  }

  .nav-btn:active {
    transform: translateY(1px);
  }

  .nav-btn:focus-visible {
    outline: 2px solid var(--time-accent, #ffd75e);
    outline-offset: 2px;
  }

  .nav-btn.is-active {
    background: #162030;
    border: 2px solid var(--time-accent, #ffd75e);
    color: var(--time-accent, #ffd75e);
    box-shadow: 3px 3px 0 #05070b;
  }

  .nav-btn.is-active:hover {
    background: var(--time-accent, #ffd75e);
    color: var(--time-deep, #08101a) !important;
  }

  .nav-btn-resume {
    border: 2px solid var(--time-accent, #ffd75e) !important;
    color: #fff !important;
    background: var(--time-panel, #161b22) !important;
    box-shadow: 3px 3px 0 #05070b !important;
  }

  .nav-btn-resume:hover {
    background: var(--time-accent, #ffd75e) !important;
    color: var(--time-deep, #08101a) !important;
  }

  .resume-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 38px;
    padding: 0 16px;
    border: 2px solid var(--time-accent, #ffd75e);
    border-radius: 2px;
    color: #fff !important;
    text-decoration: none !important;
    font-family: var(--font-display, "Departure Mono", monospace);
    font-size: 11.5px;
    letter-spacing: var(--track-label, 0.08em);
    text-transform: uppercase;
    background: var(--time-panel, #161b22);
    box-shadow: 3px 3px 0 #05070b;
    transition: transform 0.12s cubic-bezier(0.23, 1, 0.32, 1), background-color var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease);
  }

  .resume-button:hover {
    background: var(--time-accent, #ffd75e);
    color: var(--time-deep, #08101a) !important;
  }

  .resume-button:active {
    transform: translateY(1px);
  }

  .add-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 38px;
    padding: 0 18px;
    border: 2px solid var(--time-accent, #ffd75e);
    border-radius: 2px;
    background: var(--time-accent, #ffd75e);
    color: var(--time-deep, #08101a) !important;
    font-family: var(--font-display, "Departure Mono", monospace);
    font-size: 11.5px;
    letter-spacing: var(--track-label, 0.08em);
    text-transform: uppercase;
    text-decoration: none !important;
    box-shadow: 3px 3px 0 #05070b;
    cursor: pointer;
    transition: transform 0.12s cubic-bezier(0.23, 1, 0.32, 1), background-color var(--dur-fast) var(--ease);
  }

  .add-button:hover {
    background: var(--time-soft, #fff);
    border-color: var(--time-soft, #fff);
  }

  .add-button:active {
    transform: translateY(1px);
  }

  /* Menu Toggle Button - Interior .mat-cap .press style */
  .menu-toggle {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    height: 38px;
    padding: 0 12px;
    border-radius: 2px;
    border: 1px solid var(--border, #343840);
    background: #111722;
    box-shadow: 3px 3px 0 #05070b;
    color: var(--ink, #e8eddf);
    font-family: var(--font-display, "Departure Mono", monospace);
    font-size: 11.5px;
    font-weight: 500;
    letter-spacing: var(--track-label, 0.08em);
    text-transform: uppercase;
    cursor: pointer;
    outline: none;
    transition: transform 0.12s cubic-bezier(0.23, 1, 0.32, 1), background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease, box-shadow 0.15s ease;
  }

  .menu-toggle:hover {
    background: #162030;
    border-color: var(--time-accent, #ffd75e);
    color: var(--time-accent, #ffd75e);
  }

  .menu-toggle:active {
    transform: translateY(1px);
  }

  .menu-toggle:focus-visible {
    outline: 2px solid var(--time-accent, #ffd75e);
    outline-offset: 2px;
  }

  .menu-toggle[aria-expanded="true"] {
    background: var(--time-accent, #ffd75e);
    border-color: var(--time-accent, #ffd75e);
    color: var(--time-deep, #08101a);
    box-shadow: 3px 3px 0 #05070b;
  }

  .menu-icon-svg {
    flex-shrink: 0;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .menu-toggle[aria-expanded="true"] .menu-icon-svg {
    transform: rotate(90deg);
  }

  /* Site Drawer Panel & Backdrop - Interior.dev Drawer Component with SM's DEX tokens */
  .site-drawer-backdrop {
    position: fixed;
    inset: 0;
    z-index: 99998;
    background: rgba(5, 7, 11, 0.75);
    backdrop-filter: blur(2px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.22s cubic-bezier(0.23, 1, 0.32, 1);
  }

  .site-drawer-backdrop.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  .site-drawer-backdrop.is-closing {
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.16s cubic-bezier(0.4, 0, 1, 1);
  }

  .site-drawer-backdrop[hidden] {
    display: none !important;
  }

  .site-drawer {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    z-index: 99999;
    display: flex;
    flex-direction: column;
    width: 380px;
    max-width: calc(100% - 40px);
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
    background: var(--time-deep, #08101a);
    border-left: 2px solid var(--time-accent, #ffd75e);
    box-shadow: -8px 0 0 #05070b, -16px 0 32px rgba(0, 0, 0, 0.85);
    color: var(--ink, #e8eddf);
    transform: translateX(calc(100% + 24px));
    opacity: 0;
    visibility: hidden;
    transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.2s ease, visibility 0.28s;
    outline: none;
    touch-action: pan-y;
  }

  .site-drawer.is-open {
    transform: translateX(0);
    opacity: 1;
    visibility: visible;
  }

  .site-drawer.is-closing {
    transform: translateX(calc(100% + 24px));
    opacity: 0;
    transition: transform 0.18s cubic-bezier(0.4, 0, 1, 1), opacity 0.16s ease;
  }

  .site-drawer[hidden] {
    display: none !important;
  }

  @media (prefers-reduced-motion: reduce) {
    .site-drawer,
    .site-drawer-backdrop {
      transition: none !important;
      animation: none !important;
    }
  }

  .drawer-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    padding: 16px 18px;
    border-bottom: 2px solid var(--border, #343840);
    background: #060b12;
    user-select: none;
  }

  .drawer-branding {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .drawer-title {
    margin: 0;
    font-size: 15px;
    font-weight: 500;
    color: var(--ink, #e8eddf);
    font-family: var(--font-display, "Departure Mono", monospace);
    letter-spacing: var(--track-label, 0.08em);
    text-transform: uppercase;
  }

  .drawer-subtitle {
    margin: 3px 0 0;
    font-size: 12px;
    color: var(--dim, #959ba8);
    font-family: var(--font-display, "Departure Mono", monospace);
  }

  .drawer-close {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    margin-right: -4px;
    padding: 0;
    border-radius: 2px;
    border: 1px solid var(--border, #343840);
    background: #111722;
    color: var(--dim, #959ba8);
    cursor: pointer;
    outline: none;
    transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }

  .drawer-close:hover {
    background-color: var(--time-accent, #ffd75e);
    border-color: var(--time-accent, #ffd75e);
    color: var(--time-deep, #08101a);
  }

  .drawer-close:focus-visible {
    outline: 2px solid var(--time-accent, #ffd75e);
    outline-offset: 2px;
  }

  .drawer-body {
    flex: 1 1 auto;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 16px;
    scrollbar-width: thin;
    scrollbar-color: var(--time-accent, #ffd75e) #060b12;
  }

  .drawer-body::-webkit-scrollbar {
    width: 4px;
  }

  .drawer-body::-webkit-scrollbar-track {
    background: #060b12;
  }

  .drawer-body::-webkit-scrollbar-thumb {
    background-color: var(--time-accent, #ffd75e);
    border-radius: 2px;
  }

  .drawer-section {
    margin-bottom: 22px;
  }

  .drawer-section:last-child {
    margin-bottom: 0;
  }

  .drawer-section-heading {
    display: block;
    font-family: var(--font-display, "Departure Mono", monospace);
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: var(--track-label, 0.08em);
    color: var(--time-accent, #ffd75e);
    margin-bottom: 8px;
    padding-left: 6px;
  }

  .drawer-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .drawer-link {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 10px 12px;
    border-radius: 2px;
    border: 1px solid transparent;
    background: transparent;
    color: var(--ink, #e8eddf);
    text-decoration: none !important;
    transition: background-color 0.12s ease, border-color 0.12s ease, transform 0.12s ease;
  }

  .drawer-link:hover {
    background: #121824;
    border-color: var(--border, #343840);
    color: var(--time-accent, #ffd75e);
  }

  .drawer-link:active {
    transform: translateY(1px);
  }

  .drawer-link.is-current {
    background: #162030;
    border-color: var(--time-accent, #ffd75e);
    color: var(--time-accent, #ffd75e);
  }

  .drawer-bullet {
    font-size: 11px;
    color: var(--time-accent, #ffd75e);
    margin-top: 3px;
    flex-shrink: 0;
  }

  .drawer-item-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .drawer-item-text strong {
    font-size: 13px;
    font-weight: 500;
    color: var(--ink, #e8eddf);
    font-family: var(--font-display, "Departure Mono", monospace);
    line-height: 1.35;
  }

  .drawer-item-text small {
    font-size: 11.5px;
    color: var(--dim, #959ba8);
    line-height: 1.35;
    font-family: var(--font-display, "Departure Mono", monospace);
  }

  .drawer-actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    border-top: 2px solid var(--border, #343840);
    padding: 14px 16px;
    background: #060b12;
  }

  .drawer-action-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 38px;
    padding: 0 12px;
    border-radius: 2px;
    background: #111722;
    border: 1px solid var(--border, #343840);
    box-shadow: 2px 2px 0 #05070b;
    color: var(--ink, #e8eddf);
    font-size: 11.5px;
    font-weight: 500;
    font-family: var(--font-display, "Departure Mono", monospace);
    letter-spacing: var(--track-label, 0.08em);
    text-transform: uppercase;
    text-decoration: none !important;
    cursor: pointer;
    transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }

  .drawer-action-btn:hover {
    background: var(--time-accent, #ffd75e);
    border-color: var(--time-accent, #ffd75e);
    color: var(--time-deep, #08101a);
  }

  .drawer-action-btn:active {
    transform: translateY(1px);
  }

  .drawer-btn-roster {
    grid-column: 1 / -1;
    background: var(--time-accent, #ffd75e);
    border-color: var(--time-accent, #ffd75e);
    color: var(--time-deep, #08101a) !important;
    box-shadow: 3px 3px 0 #05070b;
  }

  .drawer-btn-roster:hover {
    background: var(--time-glow, #f9e59c);
    border-color: var(--time-glow, #f9e59c);
    color: var(--time-deep, #08101a) !important;
  }

  @media (max-width: 760px) {
    .portfolio-header.is-home {
      grid-template-columns: 1fr;
    }
    .portfolio-header.is-home p,
    .portfolio-header.is-home .header-actions {
      grid-column: 1;
      grid-row: auto;
    }
    .portfolio-header.is-home .header-actions {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      gap: 10px;
    }
    .portfolio-header.is-home .header-actions > * {
      width: 100%;
      min-width: 0;
      padding-inline: 8px;
    }

    .portfolio-header.is-subpage {
      padding: 12px 14px;
      gap: 10px;
    }
    .portfolio-header.is-subpage .header-nav {
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .portfolio-header.is-subpage .nav-btn,
    .portfolio-header.is-subpage .menu-toggle {
      height: 36px;
      font-size: 11px;
      padding: 0 10px;
    }
    .site-drawer {
      width: 100vw;
      max-width: 100vw;
      border-radius: 0;
      border-left: none;
    }
  }

  @media (max-width: 580px) {
    .header-nav .nav-btn-secondary {
      display: none;
    }
  }
</style>

<script>
  function initDrawer() {
    const menuToggle = document.querySelector('#menu-toggle');
    const siteDrawer = document.querySelector('#site-drawer');
    const drawerBackdrop = document.querySelector('#site-drawer-backdrop');
    const closeDrawer = document.querySelector('#close-drawer');
    const drawerAddPokemon = document.querySelector('#drawer-add-pokemon');

    if (menuToggle instanceof HTMLButtonElement && siteDrawer instanceof HTMLElement && drawerBackdrop instanceof HTMLElement && closeDrawer instanceof HTMLButtonElement) {
      if (menuToggle.dataset.initialized === 'true') return;
      menuToggle.dataset.initialized = 'true';

      let isTransitioning = false;

      const openDrawer = () => {
        if (isTransitioning) return;
        isTransitioning = true;

        siteDrawer.hidden = false;
        siteDrawer.removeAttribute('hidden');
        drawerBackdrop.hidden = false;
        drawerBackdrop.removeAttribute('hidden');

        const scrollBarWidth = window.innerWidth - document.documentElement.clientWidth;
        document.documentElement.style.overflow = 'hidden';
        if (scrollBarWidth > 0) {
          document.documentElement.style.paddingRight = `${scrollBarWidth}px`;
        }

        void siteDrawer.offsetHeight;
        siteDrawer.classList.remove('is-closing');
        siteDrawer.classList.add('is-open');
        drawerBackdrop.classList.remove('is-closing');
        drawerBackdrop.classList.add('is-open');
        menuToggle.setAttribute('aria-expanded', 'true');

        setTimeout(() => {
          closeDrawer.focus({ preventScroll: true });
          isTransitioning = false;
        }, 60);
      };

      const closeDrawerMenu = (e?: Event) => {
        if (e) {
          e.preventDefault();
          e.stopPropagation();
        }
        if (isTransitioning) return;
        if (!siteDrawer.classList.contains('is-open')) return;
        isTransitioning = true;

        siteDrawer.classList.add('is-closing');
        siteDrawer.classList.remove('is-open');
        drawerBackdrop.classList.add('is-closing');
        drawerBackdrop.classList.remove('is-open');
        menuToggle.setAttribute('aria-expanded', 'false');

        document.documentElement.style.overflow = '';
        document.documentElement.style.paddingRight = '';

        setTimeout(() => {
          siteDrawer.hidden = true;
          siteDrawer.setAttribute('hidden', '');
          siteDrawer.classList.remove('is-closing');

          drawerBackdrop.hidden = true;
          drawerBackdrop.setAttribute('hidden', '');
          drawerBackdrop.classList.remove('is-closing');

          isTransitioning = false;
          menuToggle.focus({ preventScroll: true });
        }, 200);
      };

      menuToggle.addEventListener('click', (e) => {
        e.stopPropagation();
        const isOpen = siteDrawer.classList.contains('is-open');
        if (isOpen) {
          closeDrawerMenu(e);
        } else {
          openDrawer();
        }
      });

      closeDrawer.addEventListener('click', closeDrawerMenu);
      drawerBackdrop.addEventListener('click', closeDrawerMenu);

      window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && siteDrawer.classList.contains('is-open')) {
          closeDrawerMenu(e);
        }
      });

      if (drawerAddPokemon) {
        drawerAddPokemon.addEventListener('click', () => {
          closeDrawerMenu();
          const dialog = document.querySelector('#submission-dialog');
          if (dialog instanceof HTMLDialogElement) {
            dialog.showModal();
          }
        });
      }

      siteDrawer.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => {
          closeDrawerMenu();
        });
      });

      // Swipe / Drag to dismiss gesture
      let startX = 0;
      let currentX = 0;
      let isDragging = false;

      siteDrawer.addEventListener('touchstart', (e) => {
        if (e.touches.length !== 1) return;
        startX = e.touches[0].clientX;
        currentX = startX;
        isDragging = true;
      }, { passive: true });

      siteDrawer.addEventListener('touchmove', (e) => {
        if (!isDragging) return;
        currentX = e.touches[0].clientX;
        const deltaX = currentX - startX;
        if (deltaX > 0) {
          siteDrawer.style.transform = `translateX(${deltaX}px)`;
          const opacity = Math.max(0, 1 - deltaX / 300);
          drawerBackdrop.style.opacity = String(opacity);
        }
      }, { passive: true });

      siteDrawer.addEventListener('touchend', () => {
        if (!isDragging) return;
        isDragging = false;
        const deltaX = currentX - startX;
        siteDrawer.style.transform = '';
        drawerBackdrop.style.opacity = '';
        if (deltaX > 80) {
          closeDrawerMenu();
        }
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initDrawer);
  } else {
    initDrawer();
  }
  document.addEventListener('astro:page-load', initDrawer);
</script>
