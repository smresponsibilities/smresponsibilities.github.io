---
interface Props {
  currentPath?: string;
  showBio?: boolean;
}

const rawPath = Astro.props.currentPath || Astro.url.pathname || '';
const currentPath = rawPath.replace(/\/$/, '') || '/';
const isHome = currentPath === '/';
const { showBio = true } = Astro.props;
---

{isHome ? (
  <header class="portfolio-header is-home">
    <a class="brand" href="/" aria-label="Shivam Mahajan portfolio home">SM'S DEX</a>
    {showBio && (
      <p>Shivam Mahajan is a software developer building production systems with Python, Kotlin, Kafka, PySpark, Snowflake, React and Solidity. To be added as a pokemon click on the Add Pokemon Button.</p>
    )}
    <nav class="header-actions" aria-label="Portfolio actions">
      <a class="resume-button" data-resume href="/resume/">Resume</a>
      <a class="add-button" href="/#open-submission" data-tooltip="Open the form to join the public roster">Add Pokémon</a>
      <button class="menu-toggle" id="menu-toggle" type="button" aria-expanded="false" aria-controls="site-drawer" aria-label="Open navigation menu">
        <svg viewBox="0 0 256 256" width="13" height="13" fill="none" aria-hidden="true" class="menu-icon-svg">
          <path d="M40 72h176M40 128h176M40 184h176" stroke="currentColor" stroke-width="20" stroke-linecap="round"/>
        </svg>
        <span class="menu-text">Menu</span>
      </button>
    </nav>
  </header>
) : (
  <header class="portfolio-header is-subpage">
    <a class="brand" href="/" aria-label="Shivam Mahajan portfolio home">SM'S DEX</a>
    <nav class="header-nav" aria-label="Site navigation">
      <a class={`nav-btn ${currentPath === '/' ? 'is-active' : ''}`} href="/">Home</a>
      <a class={`nav-btn nav-btn-secondary ${currentPath.startsWith('/projects') ? 'is-active' : ''}`} href="/projects/">Projects</a>
      <a class={`nav-btn nav-btn-secondary ${currentPath.startsWith('/blog') ? 'is-active' : ''}`} href="/blog/">Blog</a>
      <a class={`nav-btn nav-btn-resume ${currentPath.startsWith('/resume') ? 'is-active' : ''}`} data-resume href="/resume/">Resume</a>
      <a class="nav-btn nav-btn-secondary" href="mailto:shivammahajan.mail@gmail.com">Contact</a>
      <button class="menu-toggle" id="menu-toggle" type="button" aria-expanded="false" aria-controls="site-drawer" aria-label="Open navigation menu">
        <svg viewBox="0 0 256 256" width="13" height="13" fill="none" aria-hidden="true" class="menu-icon-svg">
          <path d="M40 72h176M40 128h176M40 184h176" stroke="currentColor" stroke-width="20" stroke-linecap="round"/>
        </svg>
        <span class="menu-text">Menu</span>
      </button>
    </nav>
  </header>
)}

